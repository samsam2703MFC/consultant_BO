+.tj-q-t{margin:0 16px 12px;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:var(--table-head)}
+.tj-q-h{display:flex;align-items:center;gap:10px;margin-bottom:8px}
+.tj-q-j{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}
+.tj-q-c{display:grid;gap:4px;align-content:start;padding:6px;border:1px solid var(--line);border-radius:8px;background:#fff;min-width:0}
+.tj-q-c.non{background:var(--stop-soft)}
+.tj-q-c.sp{background:var(--prize-soft)}
+.tj-q-c.rien{background:transparent;border-style:dashed}
+.tj-q-d{font-size:11px;color:var(--muted-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.tj-q-ph{display:flex;align-items:center;justify-content:center;aspect-ratio:4/3;border-radius:6px;overflow:hidden;background:var(--chip);color:var(--muted)}
+.tj-q-ph img{width:100%;height:100%;object-fit:cover;display:block}
+.tj-q-ph.vide{background:repeating-linear-gradient(135deg,var(--chip) 0 6px,transparent 6px 12px)}
+.tj-q-v{font-size:11px;color:var(--muted-2);min-height:18px}
+.tj-q-v .tj-note{font-size:10.5px}
+.tj-q-anc{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:8px}
+.tj-q-n{font-size:11px;color:var(--muted-2)}
