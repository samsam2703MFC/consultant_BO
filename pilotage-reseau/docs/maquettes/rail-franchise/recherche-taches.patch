+/* Chercher une tâche (15/11/2026) : le champ, puis chaque tâche trouvée et ses sept jours. */
+.tj-q-b{padding:4px 16px 10px}
+.tj-q-in{width:100%;box-sizing:border-box;height:38px;padding:0 12px;border:1px solid var(--line);border-radius:8px;background:#fff;font:400 13px var(--font-ui,'Gotham',system-ui,sans-serif);color:var(--ink)}
