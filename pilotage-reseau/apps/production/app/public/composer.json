{
    "require": {
        "nikic/fast-route": "^1.3",
        "php-di/php-di": "^7.0",
        "symfony/http-foundation": "^6.4 || ^7.3",
        "twig/twig": "^3.21",
        "ext-pdo": "*",
        "tecnickcom/tcpdf": "^6.10",
        "ext-curl": "*",
        "aws/aws-sdk-php": "^3.290",
        "guzzlehttp/guzzle": "^7.9",
        "vlucas/phpdotenv": "^5.6",
        "symfony/uid": "^6.4 || ^7.3",
        "ext-mbstring": "*",
        "phpoffice/phpspreadsheet": "^5.5",
        "phpmailer/phpmailer": "^6.10",
        "phpseclib/phpseclib": "^3.0",
        "anthropic-ai/sdk": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "../App/"
        }
    },
    "config": {
