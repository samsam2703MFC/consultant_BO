{% extends "layouts/base.twig" %}

{% block title %}Nowy produkt z recepturą{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <div class="page-title d-flex flex-wrap align-items-end justify-content-between gap-2">
            <div>
                <h3>Nowy produkt z recepturą</h3>
                <p class="text-subtitle text-muted mb-0">Produkt, opakowanie i receptura w jednym przebiegu — z kosztem surowców na bieżąco.</p>
            </div>
            <a class="at-link" href="{{ root }}/products/new">Tylko produkt, bez receptury <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
{% endblock %}

{% block content %}
<section class="section at-wizard" id="prodWizard"
         data-materials="{{ materials|json_encode }}"
         data-semi="{{ semiProducts|json_encode }}"
         data-ranges="{{ logisticsRanges|json_encode }}"
         data-shelf-life="{{ shelfLife|json_encode }}"
         data-preparations="{{ preparations|json_encode }}"
         data-groups="{{ producerGroups|json_encode }}"
         data-producers="{{ producerMap|json_encode }}"
         data-from-test="{{ from_test|json_encode }}">
    {% if from_test %}
        <div class="at-note at-note-safe mb-3"><i class="bi bi-rocket-takeoff"></i>
            <strong>Wprowadzenie produktu testowego « {{ from_test.name }} ».</strong> Nazwa, kategoria, dział, etykieta{{ from_test.recipe_name ? ' i receptura « ' ~ from_test.recipe_name ~ ' »' : (from_test.card ? ' i składniki karty technologicznej (przeliczone na 1 karton po kroku « Logistyka »)' : '') }} są już wpisane z testu — uzupełnij opakowanie i sprawdź.
            Po zapisie test przechodzi na etap « Wprowadzony » i jest powiązany z nowym produktem.</div>
    {% endif %}

    {# Receptury zapisane « na 1 sztukę » przed poprawką [201] : lista do sprawdzenia (× sztuk w kartonie albo « już na karton »). #}
    <div class="at-note at-note-warn mb-3 pw-check" id="pwCheck" hidden></div>

    <ol class="at-steps at-steps-compact" aria-label="Kroki kreatora">
        <li data-step-tab="1"><span>Produkt</span></li>
        <li data-step-tab="2"><span>Logistyka</span></li>
        <li data-step-tab="3"><span>Receptura</span></li>
        <li data-step-tab="4"><span>Przygotowanie</span></li>
        <li data-step-tab="5"><span>Zapis</span></li>
        <li class="at-step-later" title="Po zapisie, w karcie produktu"><span>Tryb i zapasy</span></li>
        <li class="at-step-later" title="Po zapisie, w karcie produktu"><span>Grupa i wypiek</span></li>
        <li class="at-step-later" title="Po zapisie, w karcie produktu"><span>Etapy i czasy</span></li>
        <li class="at-step-later" title="Po zapisie, w karcie produktu"><span>Kontrola czasów</span></li>
        <li class="at-step-later" title="Po zapisie, w karcie produktu : cena standardowa, ceny klientów, PPWR, Belgia"><span>Ceny i zatwierdzenie</span></li>
    </ol>

    <div class="card">
        <div class="card-body">

            {# --- 1. Produkt --------------------------------------------------------- #}
            <div class="at-step" data-step="1">
                <h4 class="at-step-title">Jaki produkt tworzysz?</h4>
                <p class="at-step-lead">Nazwa, kategoria, dział produkcyjny i typ etykiety.</p>
                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <label class="form-label" for="pw_name">Nazwa produktu</label>
                        <input class="form-control" id="pw_name" data-field="name" maxlength="255" required placeholder="np. Baguette Tradition 500 g.">
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label" for="pw_category">Kategoria</label>
                        <select class="form-select" id="pw_category" data-field="id_category" required>
                            <option value="">Wybierz…</option>
                            {% for c in categories %}
                                <option value="{{ c.id }}" {{ c.id == preset_category ? 'selected' : '' }}>{{ c.name }}</option>
                            {% endfor %}
                        </select>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label" for="pw_section">Dział produkcyjny</label>
                        <select class="form-select" id="pw_section" data-field="id_section" required>
                            <option value="">Wybierz…</option>
                            {% for s in sections %}
                                <option value="{{ s.id }}">{{ s.name }}</option>
                            {% endfor %}
                        </select>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="col-12">
                        <span class="form-label d-block">Typ etykiety</span>
                        <div class="at-choices" role="radiogroup" aria-label="Typ etykiety" style="max-width: 520px;">
                            <label class="at-choice is-checked">
                                <input type="radio" name="pw_label" value="0" data-field="label_type" checked>
                                <i class="bi bi-check-circle-fill at-choice-tick" aria-hidden="true"></i>
                                <strong>Mała etykieta</strong>
                            </label>
                            <label class="at-choice">
                                <input type="radio" name="pw_label" value="1" data-field="label_type">
                                <i class="bi bi-check-circle-fill at-choice-tick" aria-hidden="true"></i>
                                <strong>Duża etykieta</strong>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            {# --- 2. Opakowanie i waga ------------------------------------------------- #}
            <div class="at-step" data-step="2" hidden>
                <h4 class="at-step-title">Opakowanie, paleta i waga</h4>
                <p class="at-step-lead">Liczby całkowite większe od zera — ta sama walidacja co Karta produktu. Stan minimalny jest opcjonalny.
                    <strong>Sztuka → opakowanie (torebka, worek, tacka, folia) → karton</strong> : karton to, co kupuje klient ; bez opakowania = 0 albo puste.</p>
                <div class="row g-3">
                    {% set fields = [
                        ['weight', 'Waga produktu (g)', 'Waga jednej sztuki'],
                        ['shelf_life', 'Przydatność do spożycia (dni)', ''],
                        ['stock_minimum', 'Minimalny stan magazynowy (kartony, opcjonalnie)', 'Puste = na zamówienie (MTO) ; podany = na zapas (MTS)'],
                        ['ppb', 'Sztuk w opakowaniu', 'ile sztuk w jednej torebce / worku / tacce ; 0 = sztuki luzem w kartonie'],
                        ['bpc', 'Opakowań w kartonie', 'ile torebek / worków / tacek w jednym kartonie'],
                        ['ppc', 'Sztuk w kartonie', 'karton = to, co kupuje klient (cena, zamówienia, palety)'],
                        ['cpl', 'Kartonów na warstwie palety', ''],
                        ['lpp', 'Warstw na palecie', ''],
                        ['cpp', 'Kartonów na palecie', '']
                    ] %}
                    {% for f in fields %}
                        {% set optional = f[0] in ['stock_minimum', 'ppb', 'bpc'] %}
                        <div class="col-12 col-sm-6 col-lg-4">
                            <label class="form-label" for="pw_{{ f[0] }}">{{ f[1] }}</label>
                            <input class="form-control" type="number" min="{{ optional ? 0 : 1 }}" step="1" inputmode="numeric" id="pw_{{ f[0] }}" data-field="{{ f[0] }}"{{ optional ? '' : ' required' }}>
                            <div class="invalid-feedback"></div>
                            <small class="at-run-msg" data-hint="{{ f[0] }}" data-default="{{ f[2] }}">{{ f[2] }}</small>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# --- 3. Receptura ------------------------------------------------------------- #}
            <div class="at-step" data-step="3" hidden>
                <h4 class="at-step-title">Receptura na 1 karton</h4>
                <p class="at-step-lead">Cały produkt sprzedawany : <strong>1 karton = <span data-ppc-label>…</span> szt.</strong> (« Sztuk w kartonie » z kroku « Logistyka »).
                    Surowce w jednostce bazowej (g, ml, szt.), półprodukty w ich jednostce. Koszt liczony jak na stronie kalkulacji receptury i w marżach (receptura na 1 karton).</p>
                {# Receptura zapisana = 1 karton (kalkulacja, marże) ; « 1 sztukę » mnoży ilości × sztuk w kartonie przy zapisie. #}
                <div class="pw-per mb-3">
                    <span class="pw-per-label">Ilości wpisuję na :</span>
                    <div class="at-seg" role="radiogroup" aria-label="Ilości wpisuję na">
                        <button type="button" role="radio" data-per="carton" class="is-on" aria-checked="true">1 karton</button>
                        <button type="button" role="radio" data-per="piece" aria-checked="false">1 sztukę <span class="pw-per-x" data-ppc-times></span></button>
                    </div>
                </div>
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-lg-6">
                        <div class="d-flex gap-2 align-items-end">
                            <div class="flex-grow-1">
                                <label class="form-label" for="pwMaterial">Surowiec</label>
                                <select id="pwMaterial"></select>
                            </div>
                            <div style="width: 120px;">
                                <label class="form-label" for="pwMaterialQty">Ilość <span data-unit="material"></span></label>
                                <input class="form-control" type="number" min="1" step="1" id="pwMaterialQty">
                            </div>
                            <button type="button" class="btn btn-outline-primary" id="pwAddMaterial"><i class="bi bi-plus"></i> Dodaj</button>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="d-flex gap-2 align-items-end">
                            <div class="flex-grow-1">
                                <label class="form-label" for="pwSemi">Półprodukt</label>
                                <select id="pwSemi"></select>
                            </div>
                            <div style="width: 120px;">
                                <label class="form-label" for="pwSemiQty">Ilość <span data-unit="semi"></span></label>
                                <input class="form-control" type="number" min="1" step="1" id="pwSemiQty">
                            </div>
                            <button type="button" class="btn btn-outline-primary" id="pwAddSemi"><i class="bi bi-plus"></i> Dodaj</button>
                        </div>
                        <button type="button" class="btn btn-link px-0 mt-1" id="pwNewSemi"><i class="bi bi-plus-lg"></i> Nowy półprodukt</button>
                    </div>
                </div>
                <div id="pwLines" class="mt-3"></div>
            </div>

            {# --- 4. Przygotowanie ---------------------------------------------------------- #}
            <div class="at-step" data-step="4" hidden>
                <h4 class="at-step-title">Czynności i czas przygotowania</h4>
                <p class="at-step-lead">Rodzaj czynności i czas na partię receptury. Możesz pominąć ten krok i uzupełnić czynności później w edycji receptury.</p>
                <div class="d-flex flex-wrap gap-2 align-items-end" style="max-width: 720px;">
                    <div class="flex-grow-1">
                        <label class="form-label" for="pwPrep">Czynność</label>
                        <select class="form-select" id="pwPrep"></select>
                    </div>
                    <div style="width: 140px;">
                        <label class="form-label" for="pwPrepMin">Czas (min)</label>
                        <input class="form-control" type="number" min="0" step="0.5" id="pwPrepMin">
                    </div>
                    <button type="button" class="btn btn-outline-primary" id="pwAddPrep"><i class="bi bi-plus"></i> Dodaj</button>
                </div>
                <div id="pwPreps" class="mt-3"></div>
            </div>

            {# --- 5. Podsumowanie --------------------------------------------------------- #}
            <div class="at-step" data-step="5" hidden>
                <h4 class="at-step-title">Podsumowanie</h4>
                <p class="at-step-lead">Sprawdź dane przed zapisem.</p>
                <div id="pwSummary"></div>
                <div class="at-note at-note-safe">
                    <i class="bi bi-shield-check"></i><strong>Produkt i receptura powstaną razem, w jednej transakcji.</strong>
                    Jeśli zapis receptury (lub jej spłaszczenie, etykieta czy przeliczenie kosztu) się nie uda, produkt też nie zostanie utworzony — nic nie zostanie zapisane.
                    Po zapisie kreator przechodzi do karty produktu: logistyka kartonu i palety, produkcja na zamówienie czy na stan, grupa i wypiek, etapy pracy z czasami (Gantt), ceny (standardowa, klientów, PPWR, Belgia) i zatwierdzenie. Kalkulacja receptury jest dostępna w kroku „Receptura”.
                </div>
            </div>

            <div class="at-wizard-nav">
                <button type="button" class="btn btn-outline-dark" data-wizard-back hidden><i class="bi bi-arrow-left"></i> Wstecz</button>
                <span class="at-wizard-hint" id="prodHint" aria-live="polite"></span>
                <button type="button" class="btn btn-primary at-next" data-wizard-next>Dalej <i class="bi bi-arrow-right"></i></button>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="pwSemiModal" tabindex="-1" aria-labelledby="pwSemiTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <form class="modal-content" id="pwSemiForm" novalidate>
            <div class="modal-header">
                <div><h5 class="modal-title" id="pwSemiTitle">Nowy półprodukt</h5>
                    <p class="at-sub mb-0">Zapis bez opuszczania kreatora — półprodukt od razu wybrany w recepturze. Składniki na 1 szt. półproduktu (jak w formularzu półproduktu).</p></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12 col-md-7">
                        <label class="form-label" for="pwSemiName">Nazwa</label>
                        <input class="form-control" id="pwSemiName" maxlength="255" required placeholder="np. Krem czekoladowy do drożdżówek">
                        <div class="invalid-feedback">Wprowadź nazwę</div>
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label" for="pwSemiGroup">Grupa, która go robi</label>
                        <select class="form-select" id="pwSemiGroup"></select>
                    </div>
                    <div class="col-12">
                        <div class="d-flex gap-2 align-items-end">
                            <div class="flex-grow-1">
                                <label class="form-label" for="pwSemiMat">Składniki (szukaj surowca)</label>
                                <select id="pwSemiMat"></select>
                            </div>
                            <div style="width: 120px;">
                                <label class="form-label" for="pwSemiMatQty">Ilość <span data-unit="semi-mat"></span></label>
                                <input class="form-control" type="number" min="1" step="1" id="pwSemiMatQty">
                            </div>
                            <button type="button" class="btn btn-outline-primary" id="pwSemiMatAdd"><i class="bi bi-plus"></i> Dodaj</button>
                        </div>
                    </div>
                    <div class="col-12" id="pwSemiLines"></div>
                </div>
            </div>
            <div class="modal-footer">
                <span class="at-wizard-hint me-auto" id="pwSemiHint" aria-live="polite"></span>
                <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Anuluj</button>
                <button type="submit" class="btn btn-primary" id="pwSemiSave"><i class="bi bi-check2"></i> Utwórz i dodaj do receptury</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="pwCheckModal" tabindex="-1" aria-labelledby="pwCheckTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div><h5 class="modal-title" id="pwCheckTitle">Receptury do sprawdzenia : 1 sztuka czy 1 karton ?</h5>
                    <p class="at-sub mb-0">Kalkulacja i marże czytają recepturę produktu jako 1 karton. Te receptury wyglądają na 1 sztukę (masa składników ≈ waga sztuki) — koszt kartonu w marżach jest wtedy za niski.
                        « × sztuk w kartonie » mnoży ilości surowców i półproduktów (nowa wersja receptury, koszt i marże przeliczone) ; « Już na karton » zostawia recepturę bez zmian.</p></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
            </div>
            <div class="modal-body" id="pwCheckBody"></div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    'use strict';

    const box = document.getElementById('prodWizard');
    const MATERIALS = JSON.parse(box.dataset.materials || '[]');
    const SEMI = JSON.parse(box.dataset.semi || '[]');
    const PREPS = JSON.parse(box.dataset.preparations || '[]');
    const GROUPS = JSON.parse(box.dataset.groups || '[]');
    const PRODUCERS = JSON.parse(box.dataset.producers || '{}');
    // pole => [min, max] Karty produktu ; nowy produkt : > 0 poza opakowaniem (0 = bez) ; przydatność 1–3650 dni ; minimum opcjonalne
    const RANGES = Object.assign(JSON.parse(box.dataset.ranges || '{}'), { shelf_life: JSON.parse(box.dataset.shelfLife || '[1, 3650]'), stock_minimum: [0, 1000000] });
    const OPTIONAL = ['stock_minimum', 'ppb', 'bpc'];
    const backBtn = box.querySelector('[data-wizard-back]');
    const nextBtn = box.querySelector('[data-wizard-next]');
    const hint = document.getElementById('prodHint');
    const LAST = 5;
    const NUMERIC = ['weight', 'shelf_life', 'stock_minimum', 'ppb', 'bpc', 'ppc', 'cpl', 'lpp', 'cpp'];
    const STEP_OF = { name: 1, id_category: 1, id_section: 1, label_type: 1 };
    NUMERIC.forEach((f) => { STEP_OF[f] = 2; });

    // per : ilości wpisane na 1 karton (receptura zapisana tak jak jest) albo na 1 sztukę (× sztuk w kartonie przy zapisie).
    const state = { step: 1, lines: [], preps: [], cost: null, saving: false, per: 'carton' };
    let costTimer = null, costSeq = 0, costBusy = null;

    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const zl = (n) => Number(n || 0).toLocaleString('pl-PL', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' zł';
    const setHint = (t, err) => { hint.textContent = t || ''; hint.classList.toggle('is-error', !!err); };
    const field = (name) => box.querySelector('[data-field="' + name + '"]:not([type=radio])');
    const val = (name) => name === 'label_type'
        ? (box.querySelector('[data-field="label_type"]:checked') || {}).value || '0'
        : (field(name).value || '').trim();

    /* --- Listy wyboru z wyszukiwaniem (Choices) ----------------------------------- */
    function choices(el, groups, placeholder) {
        el.innerHTML = '<option value="">' + placeholder + '</option>' + groups;
        el.dataset.choicesInited = '1';   // inicjujemy sami, globalny inicjator pomija
        return typeof Choices === 'function'
            ? new Choices(el, { searchEnabled: true, shouldSort: false, itemSelectText: '', searchResultLimit: 30, searchPlaceholderValue: 'Szukaj…' })
            : null;
    }
    const byCategory = {};
    MATERIALS.forEach((m) => { (byCategory[m.category_name || 'Inne'] = byCategory[m.category_name || 'Inne'] || []).push(m); });
    const materialHtml = Object.keys(byCategory).sort().map((cat) => '<optgroup label="' + esc(cat) + '">' +
        byCategory[cat].map((m) => '<option value="' + m.id + '">' + esc(m.name) + ' (' + esc(m.unit_name) + ')</option>').join('') + '</optgroup>').join('');
    const semiHtml = SEMI.map((s) => '<option value="' + s.id + '">' + esc(s.name) + ' (' + esc(s.unit_name) + ')</option>').join('');
    const matSel = document.getElementById('pwMaterial');
    const semiSel = document.getElementById('pwSemi');
    const matChoices = choices(matSel, materialHtml, 'Wybierz surowiec…');
    const semiChoices = choices(semiSel, semiHtml, 'Wybierz półprodukt…');
    document.getElementById('pwPrep').innerHTML = '<option value="">Wybierz…</option>' + PREPS.map((p) => '<option value="' + p.id + '">' + esc(p.name) + '</option>').join('');

    // Nowy półprodukt [201] : okno modalne z krótkim formularzem (nazwa, grupa, surowce) — zapis AJAX, półprodukt od razu wybrany.
    const semiModalEl = document.getElementById('pwSemiModal');
    // Bootstrap tej wersji nie ma getOrCreateInstance.
    const modalOf = (el) => typeof bootstrap === 'undefined' ? null : (bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el));
    const semiModal = modalOf(semiModalEl);
    const semiForm = document.getElementById('pwSemiForm');
    const semiHint = document.getElementById('pwSemiHint');
    const semiMatSel = document.getElementById('pwSemiMat');
    const semiMatChoices = choices(semiMatSel, materialHtml, 'Wybierz surowiec…');
    const semiDraft = { lines: [], cost: null };
    document.getElementById('pwSemiGroup').innerHTML = '<option value="">— nie ustawiono —</option>' + GROUPS.map((g) => '<option value="' + g.id + '">' + esc(g.name_pl) + '</option>').join('');
    const setSemiHint = (t, err) => { semiHint.textContent = t || ''; semiHint.classList.toggle('is-error', !!err); };
    semiMatSel.addEventListener('change', () => {
        const m = MATERIALS.find((x) => +x.id === +semiMatSel.value);
        semiModalEl.querySelector('[data-unit="semi-mat"]').textContent = m ? '(' + m.unit_name + ')' : '';
    });
    document.getElementById('pwNewSemi').addEventListener('click', () => {
        semiForm.reset();
        semiDraft.lines = [];
        semiDraft.cost = null;
        if (semiMatChoices) semiMatChoices.setChoiceByValue('');
        document.getElementById('pwSemiName').classList.remove('is-invalid');
        setSemiHint('');
        renderSemiLines();
        if (semiModal) semiModal.show(); else semiModalEl.hidden = false;
        setTimeout(() => document.getElementById('pwSemiName').focus(), 200);
    });
    document.getElementById('pwSemiMatAdd').addEventListener('click', () => {
        const q = document.getElementById('pwSemiMatQty');
        const m = MATERIALS.find((x) => +x.id === +semiMatSel.value);
        if (!m) { setSemiHint('Wybierz surowiec.', true); return; }
        if (!/^[1-9]\d*$/.test(String(q.value).trim())) { setSemiHint('Podaj ilość — liczbę całkowitą większą od zera.', true); return; }
        if (semiDraft.lines.some((l) => +l.id === +m.id)) { setSemiHint('„' + m.name + '” jest już na liście.', true); return; }
        semiDraft.lines.push({ id: +m.id, name: m.name, unit: m.unit_name, quantity: +q.value });
        q.value = '';
        if (semiMatChoices) semiMatChoices.setChoiceByValue(''); else semiMatSel.value = '';
        semiModalEl.querySelector('[data-unit="semi-mat"]').textContent = '';
        setSemiHint('');
        renderSemiLines();
        semiCost();
    });
    function renderSemiLines() {
        const el = document.getElementById('pwSemiLines');
        if (!semiDraft.lines.length) { el.innerHTML = '<p class="at-empty mb-0">Brak składników — dodaj surowce powyżej.</p>'; return; }
        const price = (l) => { const c = semiDraft.cost && semiDraft.cost.lines.find((x) => +x.id === +l.id); return c ? zl(c.price) : '…'; };
        el.innerHTML = '<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Surowiec</th><th class="text-end" style="width:150px">Ilość</th><th class="text-end">Koszt</th><th></th></tr></thead><tbody>' +
            semiDraft.lines.map((l, i) => '<tr><td>' + esc(l.name) + '</td><td class="text-end">' + esc(l.quantity) + ' ' + esc(l.unit) + '</td><td class="text-end">' + price(l) + '</td>' +
                '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-dark" data-semi-remove="' + i + '" aria-label="Usuń: ' + esc(l.name) + '"><i class="bi bi-x"></i></button></td></tr>').join('') +
            '</tbody><tfoot><tr><td colspan="2"><strong>Razem · 1 szt. półproduktu</strong></td><td class="text-end"><strong>' + (semiDraft.cost ? zl(semiDraft.cost.total) : '…') + '</strong></td><td></td></tr></tfoot></table></div>';
    }
    document.getElementById('pwSemiLines').addEventListener('click', (e) => {
        const b = e.target.closest('[data-semi-remove]');
        if (!b) return;
        semiDraft.lines.splice(+b.dataset.semiRemove, 1);
        renderSemiLines();
        semiCost();
    });
    async function semiCost() {
        if (!semiDraft.lines.length) { semiDraft.cost = null; return; }
        const res = await api('/ajax/recipes/draft-cost', { method: 'POST', data: { materials: semiDraft.lines.map((l) => ({ id: l.id, quantity: l.quantity })), semi_products: [] } });
        if (res.ok) { semiDraft.cost = res.data; renderSemiLines(); }
    }
    semiForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById('pwSemiName');
        name.classList.toggle('is-invalid', !name.value.trim());
        if (!name.value.trim()) { setSemiHint('Wprowadź nazwę.', true); name.focus(); return; }
        if (!semiDraft.lines.length) { setSemiHint('Dodaj co najmniej jeden surowiec.', true); return; }
        const btn = document.getElementById('pwSemiSave');
        btn.disabled = true;
        setSemiHint('Zapisywanie…');
        const res = await api('/ajax/semi-products/quick', { method: 'POST', data: { name: name.value.trim(), group_id: document.getElementById('pwSemiGroup').value || null,
            materials: semiDraft.lines.map((l) => ({ id: l.id, quantity: l.quantity })) } });
        btn.disabled = false;
        if (!res.ok || !res.data || !res.data.id) { setSemiHint(res.message || 'Nie udało się zapisać półproduktu.', true); return; }
        const sp = res.data;
        if (!SEMI.some((x) => +x.id === +sp.id)) SEMI.push(sp);
        if (sp.group_id) PRODUCERS[sp.id] = +sp.group_id;
        const label = sp.name + ' (' + sp.unit_name + ')';
        if (semiChoices) semiChoices.setChoices([{ value: String(sp.id), label: label, selected: true }], 'value', 'label', false);
        else { semiSel.insertAdjacentHTML('beforeend', '<option value="' + sp.id + '">' + esc(label) + '</option>'); semiSel.value = String(sp.id); }
        semiSel.dispatchEvent(new Event('change'));
        if (semiModal) semiModal.hide();
        setHint('Półprodukt « ' + sp.name + ' » utworzony — podaj ilość na karton i kliknij « Dodaj ».');
        document.getElementById('pwSemiQty').focus();
    });

    matSel.addEventListener('change', () => {
        const m = MATERIALS.find((x) => +x.id === +matSel.value);
        box.querySelector('[data-unit="material"]').textContent = m ? '(' + m.unit_name + ')' : '';
    });
    semiSel.addEventListener('change', () => {
        const s = SEMI.find((x) => +x.id === +semiSel.value);
        box.querySelector('[data-unit="semi"]').textContent = s ? '(' + s.unit_name + ')' : '';
    });

    /* --- Kroki ------------------------------------------------------------------------ */
    function show(step) {
        state.step = step;
        box.querySelectorAll('[data-step]').forEach((p) => { p.hidden = +p.dataset.step !== step; });
        box.querySelectorAll('[data-step-tab]').forEach((t) => {
            const n = +t.dataset.stepTab;
            t.classList.toggle('is-active', n === step);
            t.classList.toggle('is-done', n < step);
            if (n === step) t.setAttribute('aria-current', 'step'); else t.removeAttribute('aria-current');
        });
        backBtn.hidden = step === 1;
        nextBtn.innerHTML = step === LAST ? '<i class="bi bi-check2-circle"></i> Utwórz produkt i recepturę' : 'Dalej <i class="bi bi-arrow-right"></i>';
        nextBtn.classList.toggle('btn-success', step === LAST);
        nextBtn.classList.toggle('btn-primary', step !== LAST);
        setHint('');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function markError(name, message) {
        const el = name === 'label_type' ? null : field(name);
        if (!el) return;
        el.classList.toggle('is-invalid', !!message);
        const fb = el.parentElement.querySelector('.invalid-feedback');
        if (fb) fb.textContent = message || '';
    }

    // Te same reguły co ProductService::validate (logistyka = Karta produktu, minimum opcjonalne).
    function checkStep(step) {
        const errors = {};
        if (step === 1) {
            if (!val('name')) errors.name = 'Wprowadź nazwę';
            if (!val('id_category')) errors.id_category = 'Wybierz kategorię';
            if (!val('id_section')) errors.id_section = 'Wybierz dział produkcyjny';
            ['name', 'id_category', 'id_section'].forEach((f) => markError(f, errors[f]));
        }
        if (step === 2) {
            NUMERIC.forEach((f) => {
                const v = val(f);
                const [min, max] = RANGES[f] || [1, 999999999];
                const lo = OPTIONAL.includes(f) ? 0 : Math.max(1, min);
                if (!v) { if (!OPTIONAL.includes(f)) errors[f] = 'Pole wymagane'; }
                else if (!/^\d+$/.test(v) || +v < lo || +v > max) errors[f] = 'Liczba całkowita od ' + lo + ' do ' + max;
                markError(f, errors[f]);
            });
            const n = (f) => parseInt(val(f), 10) || 0;
            if (!errors.cpp && n('cpl') && n('lpp') && n('cpp') > n('cpl') * n('lpp')) {
                errors.cpp = 'Najwyżej ' + n('cpl') * n('lpp') + ' (warstwy × kartony na warstwę)';
                markError('cpp', errors.cpp);
            }
        }
        if (step === 3 && !state.lines.length) errors.lines = 'Dodaj co najmniej jeden surowiec lub półprodukt.';
        if (step === 3 && state.lines.some((l) => !/^[1-9]\d*$/.test(String(l.quantity)))) errors.lines = 'Ilości muszą być liczbami całkowitymi większymi od zera.';
        if (step === 4 && state.preps.some((p) => !(p.minutes >= 0))) errors.preps = 'Podaj czas czynności.';
        const first = Object.values(errors)[0];
        setHint(first ? (Object.keys(errors).length > 1 ? 'Popraw zaznaczone pola.' : first) : '', !!first);
        return !first;
    }

    backBtn.addEventListener('click', () => { if (!state.saving) show(state.step - 1); });
    nextBtn.addEventListener('click', async () => {
        if (state.step < LAST) {
            if (!checkStep(state.step)) return;
            if (state.step === 2 && state.cardPending) applyCard();
            // Podsumowanie z aktualnym kosztem (ostatnia zmiana receptury mogła jeszcze nie być policzona).
            if (state.step === 4 && costTimer) { clearTimeout(costTimer); costTimer = null; await loadCost(true); }
            else if (state.step === 4 && costBusy) { await costBusy; await new Promise((r) => setTimeout(r, 0)); }
            if (state.step === 4) renderSummary();
            show(state.step + 1);
            return;
        }
        await save();
    });

    box.querySelectorAll('input[name="pw_label"]').forEach((r) => r.addEventListener('change', () => {
        box.querySelectorAll('input[name="pw_label"]').forEach((x) => x.closest('.at-choice').classList.toggle('is-checked', x.checked));
    }));
    box.addEventListener('input', (e) => {
        const f = e.target.dataset && e.target.dataset.field;
        if (f && e.target.classList.contains('is-invalid')) markError(f, '');
        if (['ppb', 'bpc', 'ppc', 'cpl', 'lpp', 'cpp'].includes(f)) packagingHints();
        if (f === 'ppc') { renderPer(); renderLines(); }
    });

    // Podpowiedzi spójności (nie blokują): ppc = ppb × bpc, cpp = cpl × lpp.
    function packagingHints() {
        const n = (f) => parseInt(val(f), 10) || 0;
        const pair = (target, a, b, label) => {
            const el = box.querySelector('[data-hint="' + target + '"]');
            if (!n(a) || !n(b)) { el.textContent = el.dataset.default || ''; el.className = 'at-run-msg'; return; }
            const product = n(a) * n(b);
            const ok = !n(target) || n(target) === product;
            el.textContent = (ok ? '✓ ' : '') + label + ': ' + n(a) + ' × ' + n(b) + ' = ' + product + (ok ? '' : ' — różni się od wpisanej wartości (' + n(target) + ')');
            el.className = 'at-run-msg' + (ok ? ' text-success' : ' text-warning');
        };
        pair('ppc', 'ppb', 'bpc', 'Wg opakowań');
        pair('cpp', 'cpl', 'lpp', 'Wg warstw');
    }

    /* --- 3. Linie receptury i koszt szkicu --------------------------------------------- */
    function addLine(type, id, qty) {
        const list = type === 'material' ? MATERIALS : SEMI;
        const item = list.find((x) => +x.id === +id);
        if (!item) { setHint(type === 'material' ? 'Wybierz surowiec.' : 'Wybierz półprodukt.', true); return false; }
        if (!/^[1-9]\d*$/.test(String(qty))) { setHint('Podaj ilość — liczbę całkowitą większą od zera.', true); return false; }
        const existing = state.lines.find((l) => l.type === type && +l.id === +id);
        if (existing) { setHint('„' + item.name + '” jest już w recepturze — zmień ilość w tabeli.', true); return false; }
        state.lines.push({ type, id: +id, name: item.name, unit: item.unit_name, quantity: +qty, price: null });
        setHint('');
        renderLines();
        scheduleCost();
        return true;
    }

    document.getElementById('pwAddMaterial').addEventListener('click', () => {
        const q = document.getElementById('pwMaterialQty');
        if (addLine('material', matSel.value, q.value)) {
            q.value = '';
            if (matChoices) matChoices.setChoiceByValue(''); else matSel.value = '';
            box.querySelector('[data-unit="material"]').textContent = '';
        }
    });
    document.getElementById('pwAddSemi').addEventListener('click', () => {
        const q = document.getElementById('pwSemiQty');
        if (addLine('semi_product', semiSel.value, q.value)) {
            q.value = '';
            if (semiChoices) semiChoices.setChoiceByValue(''); else semiSel.value = '';
            box.querySelector('[data-unit="semi"]').textContent = '';
        }
    });

    const ppcNow = () => parseInt(val('ppc'), 10) || 0;
    // Mnożnik do kartonu : 1 (ilości na karton) albo sztuk w kartonie (ilości na 1 szt.).
    const factor = () => state.per === 'piece' ? Math.max(1, ppcNow()) : 1;

    function renderPer() {
        const ppc = ppcNow();
        box.querySelector('[data-ppc-label]').textContent = ppc || '…';
        box.querySelector('[data-ppc-times]').textContent = ppc ? '(× ' + ppc + ' przy zapisie)' : '';
        box.querySelectorAll('[data-per]').forEach((b) => {
            const on = b.dataset.per === state.per;
            b.classList.toggle('is-on', on);
            b.setAttribute('aria-checked', on ? 'true' : 'false');
        });
    }
    box.querySelectorAll('[data-per]').forEach((b) => b.addEventListener('click', () => {
        if (state.per === b.dataset.per) return;
        state.per = b.dataset.per;
        renderPer();
        renderLines();
        const ppc = ppcNow();
        setHint(state.per === 'piece'
            ? 'Ilości liczone na 1 sztukę — przy zapisie × ' + (ppc || '?') + ' (receptura zapisana na 1 karton).'
            : 'Ilości liczone na 1 karton (cały produkt sprzedawany).');
    }));

    // Stopka : koszt surowców na karton (to zapisze się w kalkulacji i w marżach) + sztuka informacyjnie.
    function footHtml() {
        const ppc = ppcNow();
        const total = state.cost ? state.cost.total : null;
        const carton = total === null ? null : total * factor();
        const piece = carton === null || !ppc ? null : carton / ppc;
        return '<tr><td colspan="3"><strong>Koszt surowców / karton</strong><span class="at-run-msg">cały produkt sprzedawany' + (state.per === 'piece' && ppc ? ' : 1 szt. × ' + ppc : '') + '</span></td>' +
            '<td class="text-end"><strong data-total>' + (carton === null ? '…' : zl(carton)) + '</strong><span class="at-run-msg" data-piece>' + (ppc ? 'na 1 szt. ' + (piece === null ? '…' : zl(piece)) : '') + '</span></td><td></td></tr>';
    }

    function renderLines() {
        const el = document.getElementById('pwLines');
        if (!state.lines.length) {
            el.innerHTML = '<p class="at-empty">Receptura jest pusta. Dodaj surowce lub półprodukty powyżej.</p>';
            return;
        }
        const per = state.per === 'piece' ? 'szt.' : 'karton';
        el.innerHTML = '<div class="table-responsive"><table class="table"><thead><tr><th>Składnik</th><th>Rodzaj</th><th style="width:150px">Ilość / ' + per + '</th><th class="text-end">Koszt / ' + per + '</th><th></th></tr></thead><tbody>' +
            state.lines.map((l, i) => '<tr>' +
                '<td>' + esc(l.name) + '</td>' +
                '<td><span class="at-pill ' + (l.type === 'material' ? '' : 'at-pill-warn') + '">' + (l.type === 'material' ? 'surowiec' : 'półprodukt') + '</span>' + (l.type === 'material' ? '' : producerSelect(l)) + '</td>' +
                '<td><div class="input-group input-group-sm"><input class="form-control" type="number" min="1" step="1" value="' + esc(l.quantity) + '" data-line="' + i + '" aria-label="Ilość: ' + esc(l.name) + '"><span class="input-group-text">' + esc(l.unit) + '</span></div></td>' +
                '<td class="text-end">' + (l.price === null ? '<span class="text-muted">…</span>' : zl(l.price)) + '</td>' +
                '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-dark" data-remove="' + i + '" aria-label="Usuń: ' + esc(l.name) + '"><i class="bi bi-x"></i></button></td>' +
                '</tr>').join('') +
            '</tbody><tfoot>' + footHtml() + '</tfoot></table></div>';
    }

    // Półprodukt : grupa, która go robi — zapis od razu (dla wszystkich produktów z tym półproduktem ; tablet zamawia u niej).
    function producerSelect(l) {
        const cur = PRODUCERS[l.id] || '';
        return '<select class="form-select form-select-sm mt-1" data-producer-of="' + l.id + '" title="Robi grupa : tablet innej grupy zamawia u niej, partia produktu bierze jej numer partii" aria-label="Robi grupa: ' + esc(l.name) + '">' +
            '<option value="">Robi grupa — nie ustawiono</option>' +
            GROUPS.map((g) => '<option value="' + g.id + '"' + (+cur === +g.id ? ' selected' : '') + '>Robi grupa : ' + esc(g.name_pl) + '</option>').join('') + '</select>';
    }
    document.getElementById('pwLines').addEventListener('change', async (e) => {
        const sel = e.target.closest('[data-producer-of]');
        if (!sel) return;
        const id = +sel.dataset.producerOf;
        const res = await api('/ajax/recipes/' + id + '/producer', { method: 'PUT', data: { group_id: sel.value ? +sel.value : null } });
        if (!res.ok) { sel.value = PRODUCERS[id] || ''; setHint((res.data && res.data.message) || 'Nie udało się zapisać grupy.', true); return; }
        if (sel.value) PRODUCERS[id] = +sel.value; else delete PRODUCERS[id];
        setHint(sel.value ? 'Zapisano : « ' + sel.closest('tr').cells[0].textContent + ' » robi grupa ' + sel.options[sel.selectedIndex].text.replace('Robi grupa : ', '') + '.' : 'Grupa zdjęta.');
    });
    document.getElementById('pwLines').addEventListener('input', (e) => {
        const i = e.target.dataset.line;
        if (i === undefined) return;
        state.lines[+i].quantity = e.target.value.trim();
        scheduleCost(true);
    });
    document.getElementById('pwLines').addEventListener('click', (e) => {
        const b = e.target.closest('[data-remove]');
        if (!b) return;
        state.lines.splice(+b.dataset.remove, 1);
        renderLines();
        scheduleCost();
    });

    function scheduleCost(keepInputs) {
        clearTimeout(costTimer);
        costTimer = setTimeout(() => { costTimer = null; loadCost(keepInputs); }, 300);
    }

    async function loadCost(keepInputs) {
        const seq = ++costSeq;
        const payload = {
            materials: state.lines.filter((l) => l.type === 'material').map((l) => ({ id: l.id, quantity: l.quantity })),
            semi_products: state.lines.filter((l) => l.type === 'semi_product').map((l) => ({ id: l.id, quantity: l.quantity }))
        };
        costBusy = api('/ajax/recipes/draft-cost', { method: 'POST', data: payload });
        const res = await costBusy;
        if (seq !== costSeq) return;   // starsza odpowiedź
        costBusy = null;
        if (!res.ok) { setHint('Nie udało się policzyć kosztu.', true); return; }
        state.cost = res.data;
        state.lines.forEach((l) => {
            const c = res.data.lines.find((x) => x.type === l.type && +x.id === +l.id);
            l.price = c ? c.price : 0;
        });
        if (keepInputs) {
            // Nie przebudowujemy tabeli podczas pisania: tylko kwoty.
            const rows = document.querySelectorAll('#pwLines tbody tr');
            state.lines.forEach((l, i) => { if (rows[i]) rows[i].cells[3].textContent = zl(l.price); });
            const foot = document.querySelector('#pwLines tfoot');
            if (foot) foot.innerHTML = footHtml();
        } else {
            renderLines();
        }
    }

    /* --- 4. Czynności --------------------------------------------------------------- */
    const fmtTime = (sec) => { const m = Math.floor(sec / 60), s = sec % 60; return (m ? m + ' min' : '') + (s ? (m ? ' ' : '') + s + ' s' : (m ? '' : '0 s')); };
    document.getElementById('pwAddPrep').addEventListener('click', () => {
        const sel = document.getElementById('pwPrep');
        const min = parseFloat(String(document.getElementById('pwPrepMin').value).replace(',', '.'));
        const p = PREPS.find((x) => +x.id === +sel.value);
        if (!p) { setHint('Wybierz czynność.', true); return; }
        if (!(min >= 0)) { setHint('Podaj czas w minutach.', true); return; }
        if (state.preps.some((x) => x.id === +p.id)) { setHint('Ta czynność jest już na liście.', true); return; }
        state.preps.push({ id: +p.id, name: p.name, minutes: min });
        sel.value = '';
        document.getElementById('pwPrepMin').value = '';
        setHint('');
        renderPreps();
    });
    function renderPreps() {
        const el = document.getElementById('pwPreps');
        el.innerHTML = state.preps.length
            ? '<div class="table-responsive" style="max-width:720px"><table class="table"><thead><tr><th>Czynność</th><th style="width:160px">Czas (min)</th><th></th></tr></thead><tbody>' +
              state.preps.map((p, i) => '<tr><td>' + esc(p.name) + '</td><td><input class="form-control form-control-sm" type="number" min="0" step="0.5" value="' + p.minutes + '" data-prep="' + i + '" aria-label="Czas: ' + esc(p.name) + '"></td>' +
                  '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-dark" data-remove-prep="' + i + '" aria-label="Usuń: ' + esc(p.name) + '"><i class="bi bi-x"></i></button></td></tr>').join('') +
              '</tbody></table></div>'
            : '<p class="at-empty">Brak czynności — możesz je dodać teraz albo później.</p>';
    }
    document.getElementById('pwPreps').addEventListener('input', (e) => {
        const i = e.target.dataset.prep;
        if (i !== undefined) state.preps[+i].minutes = parseFloat(String(e.target.value).replace(',', '.'));
    });
    document.getElementById('pwPreps').addEventListener('click', (e) => {
        const b = e.target.closest('[data-remove-prep]');
        if (!b) return;
        state.preps.splice(+b.dataset.removePrep, 1);
        renderPreps();
    });

    /* --- 5. Podsumowanie i zapis --------------------------------------------------- */
    function optionText(name) { const s = field(name); return s.selectedOptions[0] ? s.selectedOptions[0].textContent.trim() : ''; }

    function renderSummary() {
        const ppc = ppcNow();
        const k = factor();
        const total = (state.cost ? state.cost.total : 0) * k;
        const row = (label, value) => '<tr><th style="width:45%">' + esc(label) + '</th><td>' + value + '</td></tr>';
        document.getElementById('pwSummary').innerHTML = '<div class="row g-3">' +
            '<div class="col-12 col-lg-6"><table class="table table-sm"><tbody>' +
                row('Nazwa', '<strong>' + esc(val('name')) + '</strong>') +
                row('Kategoria', esc(optionText('id_category'))) +
                row('Dział produkcyjny', esc(optionText('id_section'))) +
                row('Etykieta', val('label_type') === '1' ? 'Duża' : 'Mała') +
                row('Waga', esc(val('weight')) + ' g') +
                row('Przydatność', esc(val('shelf_life')) + ' dni') +
                row('Minimalny stan', val('stock_minimum') !== '' ? esc(val('stock_minimum')) + ' kart. (MTS)' : 'brak — na zamówienie (MTO)') +
                row('Opakowanie', esc(val('ppb')) + ' szt. × ' + esc(val('bpc')) + ' opak. · ' + esc(val('ppc')) + ' szt./karton') +
                row('Paleta', esc(val('cpl')) + ' kart./warstwa × ' + esc(val('lpp')) + ' warstw · ' + esc(val('cpp')) + ' kart./paleta') +
            '</tbody></table></div>' +
            '<div class="col-12 col-lg-6"><p class="mb-1"><strong>Receptura na 1 karton</strong> (cały produkt sprzedawany' + (ppc ? ' : ' + ppc + ' szt.' : '') + ')' +
                (k > 1 ? ' — ilości wpisane na 1 szt. × ' + k : '') + '</p>' +
            '<table class="table table-sm"><thead><tr><th>Składnik</th><th class="text-end">Ilość / karton</th><th class="text-end">Koszt / karton</th></tr></thead><tbody>' +
                state.lines.map((l) => '<tr><td>' + esc(l.name) + '</td><td class="text-end">' + esc(+l.quantity * k) + ' ' + esc(l.unit) + '</td><td class="text-end">' + zl((l.price || 0) * k) + '</td></tr>').join('') +
            '</tbody><tfoot><tr><td><strong>Koszt surowców / karton</strong></td><td></td><td class="text-end"><strong>' + zl(total) + '</strong><span class="at-run-msg">' + (ppc ? 'na 1 szt. ' + zl(total / ppc) : '') + '</span></td></tr></tfoot></table>' +
            '<p class="mb-1"><strong>Czynności:</strong> ' + (state.preps.length ? state.preps.map((p) => esc(p.name) + ' (' + fmtTime(Math.round(p.minutes * 60)) + ')').join(', ') : '<span class="text-muted">brak</span>') + '</p>' +
            '</div></div>';
    }

    async function save() {
        if (state.saving) return;
        state.saving = true;
        nextBtn.disabled = true;
        backBtn.disabled = true;
        setHint('Zapisywanie…');
        const product = { label_type: val('label_type') };
        ['name', 'id_category', 'id_section'].concat(NUMERIC).forEach((f) => { product[f] = val(f); });
        const k = factor();   // receptura zapisana na 1 karton
        const res = await api('/ajax/products/with-recipe', {
            method: 'POST',
            data: {
                product: product,
                materials: state.lines.filter((l) => l.type === 'material').map((l) => ({ id: l.id, quantity: +l.quantity * k })),
                semi_products: state.lines.filter((l) => l.type === 'semi_product').map((l) => ({ id: l.id, quantity: +l.quantity * k })),
                preparations: state.preps.map((p) => ({ id: p.id, duration_second: Math.round(p.minutes * 60) })),
                from_test: FROM_TEST ? FROM_TEST.test_id : null
            }
        });
        if (res.ok && res.redirect) {
            setHint('Zapisano. Przechodzę do karty produktu…');
            window.location.href = res.redirect;
            return;
        }
        state.saving = false;
        nextBtn.disabled = false;
        backBtn.disabled = false;
        if (res.errors) {
            Object.entries(res.errors).forEach(([f, m]) => markError(f, m));
            const steps = Object.keys(res.errors).map((f) => STEP_OF[f] || 1);
            show(Math.min.apply(null, steps));
        }
        setHint(res.message || 'Nie udało się zapisać (kod ' + res.status + '). Nic nie zostało zapisane.', true);
    }

    // Składniki karty technologicznej (test bez receptury) : ilości partii karty (yield_pcs szt.) → 1 karton (sztuk w kartonie).
    function applyCard() {
        const c = state.cardPending;
        state.cardPending = null;
        const ppc = ppcNow();
        const y = +c.yield_pcs || 0;
        const k = y && ppc ? ppc / y : 1;
        const skipped = (c.skipped || []).slice();
        [['material', c.materials || [], MATERIALS], ['semi_product', c.semi_products || [], SEMI]].forEach(([type, rows, list]) => rows.forEach((r) => {
            const item = list.find((x) => +x.id === +r.id);
            if (!item) { skipped.push(r.name || '#' + r.id); return; }
            if (state.lines.some((l) => l.type === type && +l.id === +r.id)) return;
            state.lines.push({ type, id: +r.id, name: item.name, unit: item.unit_name, quantity: Math.max(1, Math.round(+r.quantity * k)), price: null });
        }));
        state.per = 'carton';
        renderPer();
        renderLines();
        scheduleCost();
        setTimeout(() => setHint('Składniki z karty « ' + c.name + ' » : ' + (y && ppc ? 'partia karty (' + y + ' szt.) przeliczona na 1 karton (' + ppc + ' szt.)' : 'ilości całej partii karty (wydajność nieznana) — sprawdź, czy to 1 karton') +
            (skipped.length ? '. Bez przypisania, pominięte : ' + skipped.join(', ') : '') + '.'), 350);
    }

    // « Wprowadź » z produktu testowego : pola i receptura testu (bez ponownego wpisywania).
    const FROM_TEST = JSON.parse(box.dataset.fromTest || 'null');
    if (FROM_TEST) {
        field('name').value = FROM_TEST.name || '';
        if (FROM_TEST.id_category) field('id_category').value = String(FROM_TEST.id_category);
        if (FROM_TEST.id_section) field('id_section').value = String(FROM_TEST.id_section);
        box.querySelectorAll('[data-field="label_type"]').forEach((r) => {
            r.checked = String(r.value) === String(FROM_TEST.label_type || 0);
            r.closest('.at-choice').classList.toggle('is-checked', r.checked);
        });
        [['material', FROM_TEST.materials || [], MATERIALS], ['semi_product', FROM_TEST.semi_products || [], SEMI]].forEach(([type, rows, list]) => {
            rows.forEach((r) => {
                const item = list.find((x) => +x.id === +r.id);
                if (item && !state.lines.some((l) => l.type === type && +l.id === +r.id)) state.lines.push({ type, id: +r.id, name: item.name, unit: item.unit_name, quantity: +r.quantity, price: null });
            });
        });
        if (state.lines.length) scheduleCost();
        if (FROM_TEST.card) state.cardPending = FROM_TEST.card;
    }

    /* --- Receptury « na 1 sztukę » do sprawdzenia [201] -------------------------------- */
    const notify = (ok, m) => (typeof showSnack === 'function' ? showSnack(ok, m, m) : window.alert(m));
    const checkBox = document.getElementById('pwCheck');
    const checkModalEl = document.getElementById('pwCheckModal');
    let checkRows = [];
    function renderCheck() {
        checkBox.hidden = !checkRows.length;
        if (!checkRows.length) return;
        const n = checkRows.length;
        checkBox.innerHTML = '<i class="bi bi-exclamation-triangle"></i><div><strong>' + n + (n === 1 ? ' produkt' : (n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? ' produkty' : ' produktów')) +
            ' : receptura może być na 1 sztukę zamiast na 1 karton</strong> — koszt kartonu w marżach za niski. ' +
            '<button type="button" class="btn btn-sm btn-outline-dark ms-1" data-check-open>Sprawdź</button></div>';
        document.getElementById('pwCheckBody').innerHTML = '<div class="table-responsive"><table class="table pw-check-table"><thead><tr><th>Produkt</th><th>Dlaczego</th>' +
            '<th class="text-end">Koszt / karton teraz</th><th class="text-end">Po × szt.</th><th></th></tr></thead><tbody>' +
            checkRows.map((r) => '<tr data-check-row="' + r.id + '"><td><a href="{{ root }}/recipes/' + r.id_recipe + '/calculation" target="_blank" rel="noopener">' + esc(r.name) + '</a>' +
                '<span class="at-run-msg">#' + r.id + ' · ' + r.ppc + ' szt. w kartonie · ' + esc(String(r.created).slice(0, 10)) + '</span></td>' +
                '<td>' + esc(r.reason) + (r.blocked ? '<span class="at-run-msg text-warning">' + esc(r.blocked) + '</span>' : '') + '</td>' +
                '<td class="text-end">' + zl(r.cost) + '</td><td class="text-end"><strong>' + zl(r.cost_scaled) + '</strong></td>' +
                '<td class="text-end text-nowrap"><button type="button" class="btn btn-sm btn-primary" data-check="scale" data-id="' + r.id + '"' + (r.blocked ? ' disabled title="' + esc(r.blocked) + '"' : '') + '>× ' + r.ppc + ' (na karton)</button> ' +
                '<button type="button" class="btn btn-sm btn-outline-dark" data-check="keep" data-id="' + r.id + '">Już na karton</button></td></tr>').join('') +
            '</tbody></table></div>';
    }
    checkBox.addEventListener('click', (e) => {
        if (!e.target.closest('[data-check-open]')) return;
        const m = modalOf(checkModalEl); if (m) m.show();
    });
    checkModalEl.addEventListener('click', async (e) => {
        const b = e.target.closest('[data-check]');
        if (!b || b.disabled) return;
        const row = checkRows.find((r) => +r.id === +b.dataset.id);
        if (!row) return;
        if (b.dataset.check === 'scale' && !confirm('Pomnożyć ilości receptury « ' + row.name + ' » × ' + row.ppc + ' (1 karton) ? Koszt kartonu : ' + zl(row.cost) + ' → ok. ' + zl(row.cost_scaled) + '.')) return;
        b.closest('tr').querySelectorAll('button').forEach((x) => { x.disabled = true; });
        const res = await api('/ajax/products/' + row.id + '/recipe-check', { method: 'POST', data: { action: b.dataset.check } });
        if (!res.ok) {
            b.closest('tr').querySelectorAll('button').forEach((x) => { x.disabled = x.dataset.check === 'scale' && !!row.blocked; });
            notify(false, res.message || 'Nie udało się zapisać.');
            return;
        }
        checkRows = checkRows.filter((r) => +r.id !== +row.id);
        renderCheck();
        notify(true, (res.message || 'Zapisano.') + (res.data && res.data.decision === 'scaled' ? ' Koszt / karton : ' + zl(res.data.cost_after) + '.' : ''));
        if (!checkRows.length && modalOf(checkModalEl)) modalOf(checkModalEl).hide();
    });
    api('/ajax/products/recipe-check').then((res) => { if (res.ok && Array.isArray(res.data)) { checkRows = res.data; renderCheck(); } });

    renderPer();
    renderLines();
    renderPreps();
    show(1);
});
</script>
{% endblock %}
