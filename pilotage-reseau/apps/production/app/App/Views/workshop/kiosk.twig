<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#8D1D2C">
<title>Tablet produkcji · Tablette atelier</title>
<link rel="stylesheet" href="{{ root }}/assets/css/kiosk.css?v={{ asset_v() }}">
<link rel="manifest" href="{{ root }}/assets/kiosk/manifest.webmanifest" crossorigin="use-credentials">
<link rel="icon" href="{{ root }}/assets/kiosk/icon-192.png">
<link rel="apple-touch-icon" href="{{ root }}/assets/kiosk/apple-touch-icon.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Tablet grupy">
</head>
<body>
<div id="tfbTaskMsgs" class="tm-dock" hidden aria-live="polite"></div>
<main id="tfbKiosk" class="kiosk" data-root="{{ root }}" data-api-base="{{ api_base }}" aria-live="polite">
    <p class="kiosk-muted">Wczytywanie… / Chargement…</p>
</main>
<script src="{{ root }}/assets/js/workshop/label-ocr.js?v={{ asset_v() }}"></script>
<script src="{{ root }}/assets/js/workshop/task-messages.js?v={{ asset_v() }}"></script>
<script src="{{ root }}/assets/js/workshop/kiosk.js?v={{ asset_v() }}"></script>
<script>
    // PWA : tablet grupy instalowany jako aplikacja (ikona na ekranie, pełny ekran) ; powłoka w pamięci podręcznej.
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
            navigator.serviceWorker.register('{{ root }}/kiosk-sw.js', {scope: location.pathname.indexOf('/tablet/') >= 0 ? '{{ root }}/tablet/' : '{{ root }}/kiosk'}).catch(function () { /* bez PWA tablet działa jak strona */ });
        });
    }
</script>
</body>
</html>
