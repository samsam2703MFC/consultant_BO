{% extends "layouts/base.twig" %}

{% block title %}{{ page_title ?? 'Karty produktów · Fiches produits' }}{% endblock %}

{% block head %}{% if tablet ?? false %}
{# [431] Mode tablette (tablette de la Kierownik produkcji) : même assistant, sans menu, cibles tactiles ≥ 48 px. #}
<style>
#sidebar, #main > header { display: none !important; }
#main { margin-left: 0 !important; padding-top: 0 !important; }
.tfb-tablet-bar { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 12px; padding: 12px 18px; background: #fff; border-bottom: 1px solid #e6e0d8; }
.tfb-tablet-bar a { display: inline-flex; align-items: center; gap: 8px; min-height: 52px; padding: 0 18px; border: 1px solid #e6e0d8; border-radius: 8px; color: #1c1a17; font-size: 18px; text-decoration: none; }
.tfb-tablet-bar span { color: #7a736a; font-size: 15px; }
.tfb-tablet .tfb { font-size: 16px; }
.tfb-tablet .tfb .btn { min-height: 48px; padding: 10px 18px; font-size: 16px; }
.tfb-tablet .tfb .btn-sm { min-height: 44px; font-size: 15px; }
.tfb-tablet .tfb .form-control, .tfb-tablet .tfb .form-select { min-height: 48px; font-size: 17px; }
.tfb-tablet .tfb .form-check-input { width: 1.5em; height: 1.5em; }
.tfb-tablet .tfb .at-steps a { padding: 12px 10px; font-size: 15px; }
.tfb-tablet .tfb table td, .tfb-tablet .tfb table th { padding: 10px 8px; font-size: 15px; }
</style>
<script>document.documentElement.classList.add('tfb-tablet');</script>
{% endif %}{% endblock %}

{% block content %}
{% if tablet ?? false %}<nav class="tfb-tablet-bar"><a href="{{ root }}/tablet/quality">← Tablet jakości</a><span>Karty produktów — te same co w ERP</span></nav>{% endif %}
<section class="section tfb">
    {# Application du module atelier : tout passe par l'API, rien n'est lu en base ici. #}
    <div id="tfbProducts" class="tfb-app" data-root="{{ root }}" data-api-base="{{ api_base }}" data-user="{{ session_user }}" data-labels="workshop" data-can-toggle="{{ can_toggle ? 1 : 0 }}"{% if start_view is defined %} data-start-view="{{ start_view }}"{% endif %} aria-live="polite">
        <p class="text-muted">Wczytywanie… / Chargement…</p>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script src="{{ root }}/assets/js/workshop/api.js?v={{ asset_v() }}"></script>
<script src="{{ root }}/assets/js/pallet-views.js?v={{ asset_v() }}"></script>
<script src="{{ root }}/assets/js/workshop/products.js?v={{ asset_v() }}"></script>
{% endblock %}
