{% extends "layouts/base.twig" %}

{% block title %}Załadunek {{ date|date('d.m.Y') }}{% endblock %}

{% set t = totals %}
{% set sourceLabels = {day: 'pojazd na ten dzień', tour: 'pojazd z trasy', last_cmr: 'podpowiedź: ostatni CMR'} %}
{% set tourLabels = {day: 'trasa na ten dzień', tour: 'stała trasa klienta'} %}

{% block page_heading %}
    <div class="page-heading at-profit-head">
        <div class="page-title">
            <h3>Załadunek: klienci i palety</h3>
            <p class="text-subtitle text-muted">Dzień wysyłki: {{ date|day_pl }}</p>
        </div>
        <form method="get" action="{{ root }}/logistics" class="at-profit-period at-logi-date">
            <label for="logiDate" class="visually-hidden">Dzień wysyłki</label>
            <select id="logiDate" name="date" class="form-select" onchange="this.form.submit()">
                {% set found = false %}
                {% for d in dates %}
                    {% if d.ship_date == date %}{% set found = true %}{% endif %}
                    <option value="{{ d.ship_date }}" {{ d.ship_date == date ? 'selected' : '' }}>{{ d.ship_date|day_pl }} · {{ d.customers|plural_pl('klient', 'klientów', 'klientów') }}</option>
                {% endfor %}
                {% if not found %}<option value="{{ date }}" selected>{{ date|date('d.m') }} · brak zamówień</option>{% endif %}
            </select>
            <a class="btn btn-primary" href="{{ root }}/logistics/notices?date={{ date }}"><i class="bi bi-chat-dots"></i> Powiadom klientów</a>
            <a class="btn btn-outline-primary" href="{{ root }}/logistics/tours"><i class="bi bi-signpost-split"></i> Trasy</a>
            <a class="btn btn-outline-primary" href="{{ root }}/logistics/vehicles"><i class="bi bi-truck"></i> Pojazdy</a>
        </form>
    </div>
{% endblock %}

{% block content %}
<section class="section at-logi">
<style>
/* [329] Trasy i klienci — makieta 59 */
.lt-legend{display:flex;flex-wrap:wrap;gap:14px;list-style:none;margin:0;padding:0;font-size:12px;color:var(--at-muted,#78716C)}
.lt-legend i{display:inline-block;width:12px;height:12px;border-radius:3px;vertical-align:-2px;margin-right:4px}
.lt-legend i.is-free,.lt-s.is-free{border:1.5px dashed #ddd5ca;background:transparent}
.lt-warn{color:var(--at-danger,#C41E3A)}
.lt-tour{border:1px solid var(--at-line,#e6e0d8);border-radius:16px;padding:16px 18px;margin-bottom:14px;display:grid;grid-template-columns:210px minmax(0,1fr) 120px;gap:12px 20px;align-items:center}
@media (max-width:900px){.lt-tour{grid-template-columns:1fr}}
.lt-name{display:flex;gap:10px;align-items:flex-start}.lt-name strong{font-size:15px;display:block}.lt-name .at-sub{display:block}
.lt-dot{width:12px;height:12px;border-radius:50%;margin-top:4px;flex:none}
.lt-truck{display:flex;align-items:flex-end;gap:4px}
.lt-trailer{flex:1;position:relative;border:2px solid #cfc6ba;border-radius:8px 4px 4px 8px;padding:5px;display:grid;grid-template-rows:repeat(2,20px);grid-auto-flow:row;gap:3px;background:#fbf9f6}
.lt-s{display:block;border-radius:3px;min-width:0}
.lt-cab{width:42px;height:38px;border:2px solid #cfc6ba;border-radius:4px 14px 4px 4px;background:#fff;position:relative;flex:none}
.lt-cab:after{content:'';position:absolute;right:5px;top:6px;width:13px;height:10px;border-radius:2px 8px 2px 2px;background:#e8eef7}
.lt-wheels{display:flex;justify-content:space-between;padding:0 30px 0 20px;margin-top:-3px}
.lt-wheels i{width:13px;height:13px;border-radius:50%;background:#4b4640;border:3px solid #fff;box-shadow:0 0 0 1px #cfc6ba}
.lt-over-tag{position:absolute;right:8px;top:-13px;background:var(--at-danger,#C41E3A);color:#fff;border-radius:6px;font-size:12px;font-weight:700;padding:2px 7px}
.lt-fill{text-align:right}.lt-fill strong{display:block;font-size:24px;line-height:1;font-variant-numeric:tabular-nums}
.lt-bar{height:6px;border-radius:4px;background:#eee7de;margin-top:8px;overflow:hidden}.lt-bar i{display:block;height:100%;background:#2E7D4F}
.lt-fill.is-over strong{color:var(--at-danger,#C41E3A)}.lt-fill.is-over .lt-bar i{background:var(--at-danger,#C41E3A)}
.lt-chips{grid-column:2/4;display:flex;flex-wrap:wrap;gap:6px}
@media (max-width:900px){.lt-chips{grid-column:1}}
.lt-chip{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--at-line,#e6e0d8);border-radius:8px;padding:4px 10px 4px 6px;font-size:13px;background:#fff;color:inherit}
.lt-chip b{font-variant-numeric:tabular-nums}.lt-chip[aria-expanded=true]{border-color:var(--at-primary,#8D1D2C);box-shadow:0 0 0 1px var(--at-primary,#8D1D2C)}
.lt-chip.is-warn{border-color:#f0b4bf;background:#fdf3f5}
.lt-n{min-width:20px;height:20px;border-radius:5px;color:#fff;font-size:11px;font-weight:700;display:inline-grid;place-items:center;padding:0 4px}
.lt-detail{grid-column:1/-1;border-top:1px solid #eee7de;padding-top:14px;display:grid;grid-template-columns:210px minmax(0,1fr);gap:20px}
.lt-detail[hidden]{display:none}
.lt-detail.at-logi-customer{border:0;border-top:1px solid #eee7de;border-radius:0;background:none;box-shadow:none;margin:0;padding:14px 0 0}
@media (max-width:900px){.lt-detail{grid-template-columns:1fr}}
.lt-detail-info{display:flex;flex-direction:column;gap:3px;align-items:flex-start}.lt-detail-name{font-size:15px}
.lt-pals{display:flex;flex-wrap:wrap;gap:12px;list-style:none;margin:0 0 12px;padding:0;align-items:flex-end}
.lt-pal{width:74px;text-align:center;font-size:11px;color:var(--at-muted,#78716C);line-height:1.3}
.lt-pal b{display:block;color:var(--at-ink,#1c1a17);font-size:12px}.lt-pal span{display:block}
.lt-box{height:80px;border-radius:4px 4px 0 0;display:flex;flex-direction:column-reverse;overflow:hidden;border:1px solid var(--at-line,#e6e0d8);background:#faf7f3}
.lt-box div{border-top:1px solid rgba(255,255,255,.6)}
.lt-base{height:7px;background:repeating-linear-gradient(90deg,#b99b74 0 10px,#fbf9f6 10px 14px);border-radius:0 0 2px 2px;margin-bottom:5px}
.lt-pal.is-over .lt-box{outline:2px solid var(--at-danger,#C41E3A)}
.lt-edit{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.lt-edit .form-select{width:auto;max-width:280px}
.lt-notour{border:1px dashed #d9a05b;border-radius:16px;padding:14px 18px;margin-bottom:14px}
.lt-notour-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.lt-notour-label{font-weight:600;color:#8a5a12;margin-right:6px}
.lt-notour .lt-detail{margin-top:14px}
</style>

    {% for w in notices %}
        <div class="alert alert-warning at-profit-warn"><i class="bi bi-exclamation-triangle"></i> {{ w }}</div>
    {% endfor %}

    <div class="at-logi-tiles">
        <div class="at-tile"><span class="at-tile-label"><i class="bi bi-people"></i> Klienci</span><strong class="at-tile-value">{{ t.customers }}</strong><span class="at-tile-meta">{{ t.orders|plural_pl('zamówienie', 'zamówienia', 'zamówień') }} · {{ t.cartons|number_format(0, ',', ' ') }} kartonów</span></div>
        <div class="at-tile"><span class="at-tile-label"><i class="bi bi-stack"></i> Palety (wyliczone)</span><strong class="at-tile-value">{{ t.pallets }}</strong><span class="at-tile-meta">zeskanowane: {{ t.scanned }} · {{ settings.mixed ? 'z paletami mieszanymi' : 'bez palet mieszanych' }}</span></div>
        <div class="at-tile"><span class="at-tile-label"><i class="bi bi-box-seam"></i> Waga</span><strong class="at-tile-value">{{ t.weight_kg|number_format(0, ',', ' ') }} kg</strong><span class="at-tile-meta">z tarą {{ settings.tare_kg|number_format(0) }} kg / paleta</span></div>
        <div class="at-tile"><span class="at-tile-label"><i class="bi bi-truck"></i> Miejsca w pojazdach</span><strong class="at-tile-value">{{ t.pallets }} / {{ t.places }}</strong><span class="at-tile-meta">palety / miejsca pojazdów z klientami</span></div>
    </div>

    {# --- Pojazdy ---------------------------------------------------------------- #}
    <div class="at-logi-trucks">
        {% for truck in fleet %}
            {% set fill = truck.fill_pct ?? 0 %}
            <div class="card at-logi-truck {{ truck.over ? 'is-over' : '' }} {{ truck.customers ? '' : 'is-empty' }}">
                <div class="card-body">
                    <div class="at-logi-truck-head">
                        <div><strong>{{ truck.label }}</strong><div class="at-sub">{{ truck.carrier }}{{ truck.driver ? ' · ' ~ truck.driver : '' }}</div></div>
                        <div class="text-end"><span class="at-sub">wyjazd</span> <strong>{{ truck.departure }}</strong><div class="at-sub">załadunek od {{ truck.loading_from }}</div></div>
                    </div>
                    {% if truck.places %}
                        <div class="at-logi-fill" role="img" aria-label="{{ truck.pallets }} palet na {{ truck.places }} miejsc">
                            <span style="width: {{ min(100, fill)|round(1) }}%"></span>
                        </div>
                        <div class="at-logi-fill-text"><strong>{{ truck.pallets }} / {{ truck.places }} palet</strong> · {{ fill|round }} %
                            {% if truck.max_kg %} · {{ truck.weight_kg|number_format(0, ',', ' ') }} / {{ truck.max_kg|number_format(0, ',', ' ') }} kg{% else %} · {{ truck.weight_kg|number_format(0, ',', ' ') }} kg{% endif %}
                        </div>
                    {% else %}
                        <div class="at-logi-fill-text"><strong>{{ truck.pallets }} palet</strong> · <a href="{{ root }}/logistics/vehicles">podaj pojemność</a></div>
                    {% endif %}
                    {% if truck.customers %}
                        <ol class="at-logi-stops">
                            {% for cid in truck.customers %}
                                {% set c = by_id[cid] %}
                                <li><span>{{ c.name }}<span class="at-sub"> {{ c.town }}</span></span><strong>{{ c.pallets }} pal.</strong></li>
                            {% endfor %}
                        </ol>
                        <a class="btn btn-sm btn-outline-primary" href="{{ root }}/logistics/loading-list?date={{ date }}&vehicle={{ truck.id }}" target="_blank" rel="noopener"><i class="bi bi-printer"></i> Lista załadunku</a>
                    {% else %}
                        <p class="at-sub mb-0">Brak klientów na ten dzień.</p>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
        {% if unassigned %}
            <div class="card at-logi-truck is-unassigned">
                <div class="card-body">
                    <div class="at-logi-truck-head"><strong>Bez pojazdu</strong><strong>{{ unassigned|reduce((s, c) => s + c.pallets, 0) }} pal.</strong></div>
                    <ol class="at-logi-stops">
                        {% for c in unassigned %}<li><span>{{ c.name }}<span class="at-sub"> {{ c.town }}</span></span><strong>{{ c.pallets }} pal.</strong></li>{% endfor %}
                    </ol>
                </div>
            </div>
        {% endif %}
    </div>

    {# [328] « Palety dnia według rodzaju kartonu » usunięte. #}

    {# --- [329] Trasy i klienci (makieta 59) : jedna ciężarówka = jedna linia, miejsca palet w kolorze klienta,
         klik na klienta : jego palety narysowane + trasa / pojazd / kolejność. --------------------------------- #}
    {% set ltColors = ['#8D1D2C', '#2c5282', '#2E7D4F', '#d9a05b', '#7c4d8a', '#c47b5a', '#3b7a8a', '#a8475a'] %}
    {% macro trailer(cids, by_id, places, colors) %}
        {% set slots = [] %}
        {% for cid in cids %}{% set cust = by_id[cid] %}{% set ci = loop.index0 %}
            {% for ct in cust.carton_types %}{% for p in ct.pallets %}{% set slots = slots|merge([{c: colors[ci % colors|length], mixed: p.kind != 'full', who: cust.name}]) %}{% endfor %}{% endfor %}
        {% endfor %}
        {% set cap = places > 0 ? places : slots|length %}
        {% set shown = max(cap, 2) %}
        <div class="lt-truck" role="img" aria-label="{{ slots|length }} palet{{ places > 0 ? ' na ' ~ places ~ ' miejsc' : '' }}">
            <div class="lt-trailer" style="grid-template-columns:repeat({{ (shown / 2)|round(0, 'ceil') }},1fr)">
                {% for i in 0..(shown - 1) %}
                    {% set sl = slots[i] ?? null %}
                    {% if sl %}<i class="lt-s" title="{{ sl.who }}" style="background:{{ sl.mixed ? 'repeating-linear-gradient(45deg,' ~ sl.c ~ ' 0 4px,' ~ sl.c ~ '66 4px 8px)' : sl.c }}"></i>{% else %}<i class="lt-s is-free"></i>{% endif %}
                {% endfor %}
                {% if places > 0 and slots|length > places %}<span class="lt-over-tag">+{{ slots|length - places }} pal. nie mieści się</span>{% endif %}
            </div>
            <div class="lt-cab"></div>
        </div>
        <div class="lt-wheels"><i></i><i></i><i></i></div>
    {% endmacro %}
    {% import _self as lt %}
    {% set overTours = tours|filter(x => x.places and x.pallets > x.places)|length %}
    <div class="card lt-card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h4 class="card-title mb-0">Trasy i klienci: palety i pojazd</h4>
            <ul class="lt-legend" aria-label="Legenda">
                <li><i style="background:#8D1D2C"></i> pełna paleta</li>
                <li><i style="background:repeating-linear-gradient(45deg,#c47b5a 0 4px,#e9c7b3 4px 8px)"></i> {{ settings.mixed ? 'paleta mieszana' : 'paleta niepełna' }}</li>
                <li><i class="is-free"></i> wolne miejsce</li>
                {% if overTours %}<li class="lt-warn">{{ overTours }} przeładowana</li>{% endif %}
            </ul>
        </div>
        <div class="card-body pt-0">
            {% for tour in tours %}
            {% set over = tour.places and tour.pallets > tour.places %}
            <section class="lt-tour" data-lt-tour aria-label="Trasa {{ tour.name }}">
                <div class="lt-name">
                    <span class="lt-dot" style="background:{{ tour.color ?: '#8d1d2c' }}"></span>
                    <div><strong>{{ tour.name }}</strong>
                        <span class="at-sub">wyjazd {{ tour.departure }}{% for v in tour.vehicles %} · {{ v.label }}{% else %} · <a href="{{ root }}/logistics/tours">dodaj pojazd</a>{% endfor %}</span>
                        <span class="at-sub">{{ tour.customers|length|plural_pl('klient', 'klientów', 'klientów') }}</span></div>
                </div>
                <div>{{ lt.trailer(tour.customers, by_id, tour.places, ltColors) }}</div>
                <div class="lt-fill{{ over ? ' is-over' : '' }}">
                    <strong>{{ tour.pallets }}{{ tour.places ? '/' ~ tour.places : '' }}</strong>
                    <span class="at-sub">{{ tour.fill_pct is not null ? tour.fill_pct|round ~ ' % · ' : '' }}{{ tour.weight_kg|number_format(0, ',', ' ') }} kg</span>
                    {% if tour.places %}<div class="lt-bar"><i style="width:{{ min(100, tour.fill_pct ?? 0)|round(1) }}%"></i></div>{% endif %}
                </div>
                <div class="lt-chips">
                    {% for cid in tour.customers %}{% set c = by_id[cid] %}
                        <button type="button" class="lt-chip{{ (c.pallets_over ?? 0) or c.missing_cpp ? ' is-warn' : '' }}" data-lt-open="{{ cid }}" aria-expanded="false"><span class="lt-n" style="background:{{ ltColors[loop.index0 % ltColors|length] }}">{{ c.stop ?: loop.index }}</span>{{ c.name }} <b>{{ c.pallets }} pal.</b></button>
                    {% else %}
                        <span class="at-sub">Brak zamówień klientów tej trasy na ten dzień.</span>
                    {% endfor %}
                </div>
                {% for cid in tour.customers %}
                    {% include 'logistics/_customer_card.twig' with {c: by_id[cid], color: ltColors[loop.index0 % ltColors|length]} %}
                {% endfor %}
            </section>
            {% endfor %}
            {% if no_tour %}
            <section class="lt-notour" data-lt-tour aria-label="Bez trasy">
                <div class="lt-notour-row">
                    <span class="lt-notour-label"><i class="bi bi-exclamation-triangle"></i> Bez trasy</span>
                    {% for cid in no_tour %}{% set c = by_id[cid] %}
                        <button type="button" class="lt-chip" data-lt-open="{{ cid }}" aria-expanded="false"><span class="lt-n" style="background:#7a736a">–</span>{{ c.name }} <b>{{ c.pallets }} pal.</b></button>
                    {% endfor %}
                    <button type="button" class="btn btn-primary btn-sm ms-auto" data-lt-assign="{{ no_tour|first }}">Przypisz do trasy</button>
                </div>
                {% for cid in no_tour %}
                    {% include 'logistics/_customer_card.twig' with {c: by_id[cid], color: '#7a736a'} %}
                {% endfor %}
            </section>
            {% endif %}
            {% if not customers %}
                <p class="at-empty">Brak zamówień na ten dzień.</p>
            {% endif %}
        </div>
    </div>

    {% set missingProducts = products|filter(p => p.issue == 'missing') %}
    {% set layerProducts = products|filter(p => p.issue == 'layers') %}
    {% macro palletRows(list, root) %}
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead><tr><th>Produkt</th><th>Kartony na warstwę</th><th>Warstwy</th><th>Kartony na paletę</th><th></th></tr></thead>
                <tbody>
                {% for p in list %}
                    <tr data-product="{{ p.id }}">
                        <td><a href="{{ root }}/workshop/products#/product/{{ p.id }}">{{ p.name }}</a>
                            <div class="at-sub">{{ p.placeholder ?? false ? '1 / 1 / 1 — wartość domyślna (1 karton na paletę), popraw' : (p.cpp ? 'warstwy × kartony = ' ~ ((p.cpl ?? 0) * (p.lpp ?? 0)) ~ ' ≠ ' ~ p.cpp : 'brak kartonów na paletę') }}</div></td>
                        <td><input class="form-control form-control-sm at-logi-num" name="cpl" inputmode="numeric" value="{{ p.cpl }}" aria-label="Kartony na warstwę {{ p.name }}"></td>
                        <td><input class="form-control form-control-sm at-logi-num" name="lpp" inputmode="numeric" value="{{ p.lpp }}" aria-label="Warstwy {{ p.name }}"></td>
                        <td><input class="form-control form-control-sm at-logi-num" name="cpp" inputmode="numeric" value="{{ p.cpp }}" aria-label="Kartony na paletę {{ p.name }}"></td>
                        <td><button type="button" class="btn btn-sm btn-primary" data-save-product>Zapisz</button></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endmacro %}
    {% if missingProducts %}
    <div class="card">
        <div class="card-header"><h4 class="card-title mb-0">Karta produktu: brak kartonów na paletę</h4></div>
        <div class="card-body pt-0">
            {{ _self.palletRows(missingProducts, root) }}
            <p class="at-profit-note">Bez tej liczby palety produktu nie są policzone. Te same pola co w karcie produktu (Produkty → edycja).</p>
        </div>
    </div>
    {% endif %}
    {% if layerProducts %}
    <div class="card">
        <details class="card-body at-logi-layers">
            <summary><strong>{{ layerProducts|length }} produktów dnia: warstwy × kartony na warstwę ≠ kartony na paletę</strong>
                <span class="at-sub">— do liczenia palet używane są „kartony na paletę”; popraw, gdy warstwy są dobre.</span></summary>
            {{ _self.palletRows(layerProducts, root) }}
        </details>
    </div>
    {% endif %}
</section>
{% endblock %}

{% block scripts %}
{% include 'page_components/ajax_helpers.twig' %}
<script>
(() => {
    const date = {{ date|json_encode|raw }};
    const reload = (res) => {
        at.notify(res.ok, res.message || (res.ok ? 'Zapisano' : 'Błąd'));
        if (res.ok) window.setTimeout(() => window.location.reload(), 500);
    };
    // [329] Klik na klienta (makieta 59) : jego palety i ustawienia ; drugi klik zamyka.
    document.querySelectorAll('[data-lt-open]').forEach(chip => chip.addEventListener('click', () => {
        const box = chip.closest('[data-lt-tour]');
        const card = document.getElementById('lt-c-' + chip.dataset.ltOpen);
        const open = chip.getAttribute('aria-expanded') !== 'true';
        box.querySelectorAll('[data-lt-open]').forEach(b => b.setAttribute('aria-expanded', 'false'));
        box.querySelectorAll('.lt-detail').forEach(d => { d.hidden = true; });
        if (open && card) { chip.setAttribute('aria-expanded', 'true'); card.hidden = false; }
    }));
    document.querySelectorAll('[data-lt-assign]').forEach(btn => btn.addEventListener('click', () => {
        const chip = btn.closest('[data-lt-tour]').querySelector(`[data-lt-open="${btn.dataset.ltAssign}"]`);
        if (chip && chip.getAttribute('aria-expanded') !== 'true') chip.click();
        document.querySelector(`#lt-c-${btn.dataset.ltAssign} [data-field=tour_id]`)?.focus();
    }));
    document.querySelectorAll('[data-customer]').forEach(row => row.addEventListener('change', (e) => {
        const field = e.target.dataset.field;
        if (!field) return;
        const value = (name) => row.querySelector(`[data-field=${name}]`).value;
        const tour = value('tour_id');
        const data = {
            date, customer_id: Number(row.dataset.customer),
            tour_id: tour === 'none' ? null : tour,
            // Nowa trasa : pojazd z jej pojazdów ; „na stałe” zmienia się tylko polem wyboru.
            vehicle_id: field === 'tour_id' ? 'auto' : (value('vehicle_id') || null),
            stop: value('stop').trim() || null,
        };
        if (field !== 'tour_id' && tour !== 'none') data.remember = row.querySelector('[data-field=remember]').checked;
        at.send('/ajax/logistics/assignments', 'PUT', data).then(reload);
    }));
    document.querySelectorAll('tr[data-product]').forEach(row => row.querySelector('[data-save-product]').addEventListener('click', () => {
        const data = {};
        row.querySelectorAll('input[name]').forEach(i => { data[i.name] = i.value.trim(); });
        at.send(`/ajax/logistics/products/${row.dataset.product}/pallet`, 'PATCH', data).then(reload);
    }));
})();
</script>
{% endblock %}
