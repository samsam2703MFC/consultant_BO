{# [329] Makieta 59 : szczegóły klienta po kliknięciu (palety narysowane, trasa, pojazd, kolejność). Ukryte domyślnie. #}
{% set col = color ?? '#8D1D2C' %}
{% set d = delivery[c.id] ?? null %}
<article class="at-logi-customer lt-detail" data-customer="{{ c.id }}" id="lt-c-{{ c.id }}" hidden>
    <div class="lt-detail-info">
        <strong class="lt-detail-name">{{ c.name }}</strong>
        {% if d %}<a class="badge {{ d.status == 'delivered' ? 'bg-success' : (d.status == 'arrived' ? 'bg-info text-dark' : 'bg-danger') }}" href="{{ root }}/logistics/deliveries?date={{ date }}" title="Tablet kierowcy">{{ d.status == 'delivered' ? 'dostarczono ' ~ d.recorded_at|date('H:i') : (d.status == 'arrived' ? 'na miejscu od ' ~ (d.arrived_at ?: d.recorded_at)|date('H:i') : 'problem : ' ~ d.reason_label) }}</a>{% endif %}
        <span class="at-sub">{{ c.pallets|plural_pl('paleta', 'palety', 'palet') }} · {{ c.weight_kg|number_format(0, ',', ' ') }} kg{% if c.stop %} · rozładunek {{ c.stop }}{% endif %}</span>
        <span class="at-sub">{{ c.town }}{{ c.country ? ', ' ~ c.country : '' }}</span>
        {% if c.pallets_over ?? 0 %}<span class="lt-warn">{{ c.pallets_over|plural_pl('paleta', 'palety', 'palet') }} ponad limit</span>{% endif %}
        {% if c.missing_cpp %}<span class="lt-warn">{{ c.missing_cpp }} prod. bez kartonów na paletę</span>{% endif %}
        {% if c.scanned %}<span class="at-sub">zeskanowane {{ c.scanned }} / {{ c.pallets }}</span>{% endif %}
        {% if c.stack_pallets ?? 0 %}<a class="at-sub" href="{{ root }}/products/cartons/mixed?date={{ date }}&amp;customer={{ c.id }}"><i class="bi bi-layers"></i> palety mieszane — warstwy, etykieta</a>
        {% elseif (c.mixed_pallets ?? 0) >= 2 %}<a class="at-sub" href="{{ root }}/products/cartons/mixed?date={{ date }}&amp;customer={{ c.id }}"><i class="bi bi-layers"></i> {{ c.mixed_pallets }} niepełne — sprawdź paletę mieszaną</a>{% endif %}
    </div>
    <div>
        <ol class="lt-pals" aria-label="Palety {{ c.name }}">
            {% set n = 0 %}
            {% for ct in c.carton_types %}
                {% for p in ct.pallets %}
                    {% set n = n + 1 %}
                    {% set ld = p.load ?? null %}
                    {% set over = ld and (ld.over_kg or ld.over_height or ld.over_truck) %}
                    {% set total = p.items|reduce((s, i) => s + i.cartons, 0) %}
                    {% set label = p.kind == 'stack' ? 'warstwy · ' ~ p.items|length ~ ' prod.' : (p.items|length > 1 ? 'mix · ' ~ p.items|length ~ ' prod.' : p.items[0].product) %}
                    <li class="lt-pal{{ over ? ' is-over' : '' }}" title="{{ p.items|map(i => i.product ~ ': ' ~ i.cartons|number_format(0, ',', ' ') ~ ' kart.')|join('\n') }}">
                        <div class="lt-box">
                            {% if p.kind == 'full' %}
                                <div style="flex:1 0 0;background:{{ col }}"></div>
                            {% else %}
                                {% set fill = p.kind == 'stack' ? 1 : p.fill %}
                                {% for i in p.items %}<div style="flex:{{ (total > 0 ? i.cartons / total : 1) * fill * 100 }} 0 0;background:{{ ['#c47b5a', '#d9a05b', '#a8475a', '#7c4d8a', '#3b7a8a'][loop.index0 % 5] }}"></div>{% endfor %}
                                {% if fill < 1 %}<div style="flex:{{ (1 - fill) * 100 }} 0 0"></div>{% endif %}
                            {% endif %}
                        </div>
                        <div class="lt-base"></div>
                        <b>{{ n }}</b>{{ label|length > 16 ? label|slice(0, 15) ~ '…' : label }}
                        {% if ld %}<span class="{{ over ? 'lt-warn' : '' }}">{{ ld.kg|number_format(0, ',', ' ') }} kg{{ over ? ' ⚠' : '' }}</span>{% else %}<span>{{ total|number_format(0, ',', ' ') }} kart.</span>{% endif %}
                    </li>
                {% endfor %}
            {% endfor %}
        </ol>
        <div class="lt-edit">
            <select class="form-select form-select-sm" data-field="tour_id" aria-label="Trasa {{ c.name }}">
                <option value="none">— bez trasy —</option>
                {% for o in tour_options|filter(o => o.active or o.id == c.tour_id) %}
                    <option value="{{ o.id }}" {{ o.id == c.tour_id ? 'selected' : '' }}>Trasa: {{ o.name }}{{ o.active ? '' : ' (nieaktywna)' }}</option>
                {% endfor %}
            </select>
            {% set auto = c.vehicle_source == 'tour' %}
            <select class="form-select form-select-sm" data-field="vehicle_id" aria-label="Pojazd {{ c.name }}">
                {% if c.tour_vehicles %}<option value="auto" {{ auto ? 'selected' : '' }}>Auto z trasy{{ auto and c.vehicle_id ? ': ' ~ (all_vehicles[c.vehicle_id].regis_num ?: all_vehicles[c.vehicle_id].carrier) : '' }}</option>{% endif %}
                <option value="" {{ not auto and c.vehicle_id is null ? 'selected' : '' }}>{{ vehicles ? '— bez pojazdu —' : '— brak pojazdów w użyciu —' }}</option>
                {% for v in vehicles %}
                    <option value="{{ v.id }}" {{ not auto and v.id == c.vehicle_id ? 'selected' : '' }}>{{ v.regis_num ?: v.carrier }}{{ v.pallet_places ? ' (' ~ v.pallet_places ~ ' pal.)' : '' }} · {{ v.carrier|slice(0, 22) }}</option>
                {% endfor %}
                {% if not auto and c.vehicle_id and vehicles|filter(v => v.id == c.vehicle_id) is empty and all_vehicles[c.vehicle_id] is defined %}
                    {% set iv = all_vehicles[c.vehicle_id] %}
                    <option value="{{ iv.id }}" selected>{{ iv.regis_num ?: iv.carrier }} · {{ iv.carrier|slice(0, 22) }} (nieaktywny)</option>
                {% endif %}
            </select>
            <input class="form-control form-control-sm at-logi-stop" data-field="stop" inputmode="numeric" value="{{ c.stop }}" placeholder="kol." aria-label="Kolejność rozładunku {{ c.name }}">
            <label class="at-sub mb-0" title="Klient na stałe w tej trasie (kolejne dni tygodnia trasy)"><input type="checkbox" class="form-check-input" data-field="remember" {{ c.tour_member ? 'checked' : '' }} {{ c.tour_id ? '' : 'disabled' }}> na stałe w trasie</label>
        </div>
    </div>
</article>
