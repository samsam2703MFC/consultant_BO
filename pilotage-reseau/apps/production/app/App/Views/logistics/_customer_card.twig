{# [329] Makieta 59 : szczegóły klienta po kliknięciu (palety narysowane, trasa, pojazd, kolejność). Ukryte domyślnie. #}
{% set col = color ?? '#8D1D2C' %}
{% set d = delivery[c.id] ?? null %}
<article class="at-logi-customer lt-detail" data-customer="{{ c.id }}" id="lt-c-{{ c.id }}" hidden>
    <div class="lt-detail-info">
        <strong class="lt-detail-name">{{ c.name }}</strong>
        <span class="at-sub">{{ c.pallets }} pal. · {{ c.weight_kg|number_format(0, ',', ' ') }} kg</span>
        {% if d %}<a class="badge {{ d.status == 'delivered' ? 'bg-success' : (d.status == 'arrived' ? 'bg-info text-dark' : 'bg-danger') }}" href="{{ root }}/logistics/deliveries?date={{ date }}">{{ d.status == 'delivered' ? 'dostarczono ' ~ d.recorded_at|date('H:i') : (d.status == 'arrived' ? 'na miejscu' : 'problem') }}</a>{% endif %}
        {% set heavy = c.carton_types|reduce((n, ct) => n + ct.pallets|filter(p => p.load.over_kg ?? false)|length, 0) %}
        {% if heavy %}<span class="lt-warn"><i class="bi bi-exclamation-triangle"></i> {{ heavy }} za ciężkie</span>{% endif %}
        {% if c.missing_cpp %}<span class="lt-warn"><i class="bi bi-exclamation-triangle"></i> {{ c.missing_cpp }} bez danych palety</span>{% endif %}
    </div>
    <div>
        {# [330] Palety : ta sama wielkość, tylko numer (lean) ; klik → szczegóły. #}
        {% set layerColors = ['#c47b5a', '#d9a05b', '#a8475a', '#7c4d8a', '#3b7a8a', '#2E7D4F', '#8D1D2C', '#b0846a'] %}
        {% set pals = [] %}
        {% for ct in c.carton_types %}{% for p in ct.pallets %}{% set pals = pals|merge([p|merge({format: ct.name})]) %}{% endfor %}{% endfor %}
        <ol class="lt-pals" aria-label="Palety {{ c.name }}">
            {% for p in pals %}
                {% set ld = p.load ?? null %}
                {% set total = p.items|reduce((s, i) => s + i.cartons, 0) %}
                <li><button type="button" class="lt-pal{{ ld and ld.over_kg ? ' is-over' : '' }}" data-lt-pal="{{ c.id }}-{{ loop.index }}" aria-expanded="false" title="{{ p.items|map(i => i.product ~ ': ' ~ i.cartons|number_format(0, ',', ' ') ~ ' kart.')|join('\n') }}">
                    <span class="lt-box">
                        {% if p.kind == 'full' %}<i style="flex:1 0 0;background:{{ col }}"></i>
                        {% else %}{% for i in p.items %}<i style="flex:{{ total > 0 ? i.cartons / total * 100 : 1 }} 0 0;background:{{ layerColors[loop.index0 % layerColors|length] }}"></i>{% endfor %}{% endif %}
                    </span>
                    <span class="lt-base"></span>
                    <b class="lt-pn">{{ loop.index }}{{ ld and ld.over_kg ? ' ⚠' : '' }}</b>
                </button></li>
            {% endfor %}
        </ol>
        <div class="lt-edit">
            <select class="form-select form-select-sm" data-field="tour_id" aria-label="Trasa {{ c.name }}">
                <option value="none">— bez trasy —</option>
                {% for o in tour_options|filter(o => o.active or o.id == c.tour_id) %}
                    <option value="{{ o.id }}" {{ o.id == c.tour_id ? 'selected' : '' }}>Trasa: {{ o.name }}{{ o.active ? '' : ' (nieaktywna)' }}</option>
                {% endfor %}
            </select>
            {% set auto = c.vehicle_source == 'tour' %}
            <select class="form-select form-select-sm" data-field="vehicle_id" aria-label="Pojazd {{ c.name }}">
                {% if c.tour_vehicles %}<option value="auto" {{ auto ? 'selected' : '' }}>Auto z trasy{{ auto and c.vehicle_id ? ': ' ~ (all_vehicles[c.vehicle_id].regis_num ?: all_vehicles[c.vehicle_id].carrier) : '' }}</option>{% endif %}
                <option value="" {{ not auto and c.vehicle_id is null ? 'selected' : '' }}>{{ vehicles ? '— bez pojazdu —' : '— brak pojazdów w użyciu —' }}</option>
                {% for v in vehicles %}
                    <option value="{{ v.id }}" {{ not auto and v.id == c.vehicle_id ? 'selected' : '' }}>{{ v.regis_num ?: v.carrier }}{{ v.pallet_places ? ' (' ~ v.pallet_places ~ ' pal.)' : '' }} · {{ v.carrier|slice(0, 22) }}</option>
                {% endfor %}
                {% if not auto and c.vehicle_id and vehicles|filter(v => v.id == c.vehicle_id) is empty and all_vehicles[c.vehicle_id] is defined %}
                    {% set iv = all_vehicles[c.vehicle_id] %}
                    <option value="{{ iv.id }}" selected>{{ iv.regis_num ?: iv.carrier }} · {{ iv.carrier|slice(0, 22) }} (nieaktywny)</option>
                {% endif %}
            </select>
            <input class="form-control form-control-sm at-logi-stop" data-field="stop" inputmode="numeric" value="{{ c.stop }}" placeholder="kol." aria-label="Kolejność rozładunku {{ c.name }}">
            <label class="at-sub mb-0" title="Klient na stałe w tej trasie (kolejne dni tygodnia trasy)"><input type="checkbox" class="form-check-input" data-field="remember" {{ c.tour_member ? 'checked' : '' }} {{ c.tour_id ? '' : 'disabled' }}> na stałe w trasie</label>
        </div>
    </div>
    {% for p in pals %}
        {% set ld = p.load ?? null %}
        <div class="lt-pd" data-lt-pd="{{ c.id }}-{{ loop.index }}" hidden>
            <div class="lt-side">
                <div class="lt-side-box">
                    {% for i in p.items %}<div style="flex:{{ i.layers ?? 1 }} 0 0;background:{{ p.kind == 'full' ? col : layerColors[loop.index0 % layerColors|length] }}"><span>{{ i.product }}</span><span>{{ i.layers ? '×' ~ i.layers : '' }}</span></div>{% endfor %}
                </div>
                <div class="lt-base"></div>
            </div>
            <table class="lt-pd-table">
                <thead><tr><th>Paleta {{ loop.index }}</th><th class="n">Kartony</th><th class="n">Waga</th></tr></thead>
                <tbody>
                {% for i in p.items %}
                    <tr><td><i class="lt-sw" style="background:{{ p.kind == 'full' ? col : layerColors[loop.index0 % layerColors|length] }}"></i>{{ i.product }}</td>
                        <td class="n">{{ i.cartons|number_format(0, ',', ' ') }}</td><td class="n">{{ i.kg is not null ? i.kg|number_format(0, ',', ' ') ~ ' kg' : '—' }}</td></tr>
                {% endfor %}
                {% if ld %}<tr class="lt-pd-sum"><td><b>Razem</b></td><td class="n"><b>{{ p.items|reduce((s, i) => s + i.cartons, 0)|number_format(0, ',', ' ') }}</b></td>
                    <td class="n"><b class="{{ ld.over_kg ? 'lt-warn' : '' }}">{{ ld.kg|number_format(0, ',', ' ') }} / {{ ld.max_kg|number_format(0, ',', ' ') }} kg</b></td></tr>{% endif %}
                </tbody>
            </table>
            <div class="lt-pd-btns">
                {% if p.kind == 'stack' and p.mixed_id is defined %}<a class="btn btn-primary btn-sm" href="{{ root }}/products/cartons/mixed/label?pallet={{ p.mixed_id }}" target="_blank" rel="noopener"><i class="bi bi-printer"></i> Etykieta</a>{% endif %}
                {% if p.kind != 'full' %}<a class="btn btn-outline-primary btn-sm" href="{{ root }}/products/cartons/mixed?date={{ date }}&amp;customer={{ c.id }}"><i class="bi bi-layers"></i> Warstwy</a>{% endif %}
            </div>
        </div>
    {% endfor %}
</article>
