{% extends "layouts/base.twig" %}

{% block title %}Kto co zrobił{% endblock %}

{% block page_heading %}
    <div class="page-heading at-profit-head">
        <div class="page-title">
            <h3>Kto co zrobił</h3>
            <p class="text-subtitle text-muted mb-0">Funkcje i zadania › Wykonanie · wszystkie stanowiska — zadania z kreatorem, ręczne i automatyczne (cron), spóźnione z przypomnieniem.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            {% if can_see('/organization/positions') %}<a class="btn btn-outline-primary" href="{{ root }}/organization/positions"><i class="bi bi-arrow-left"></i> Funkcje i zadania</a>{% endif %}
        </div>
    </div>
{% endblock %}

{% block content %}
