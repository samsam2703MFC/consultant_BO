{% extends "layouts/base.twig" %}
{# [368] Administracja › Struktura i obowiązki (makiety 70 i 70 B) : organigram stanowisk (przeciągnij i upuść = nowy
   przełożony) i matryca obowiązek → stanowisko → asystent kontroli. Dane : /ajax/organization/structure. #}
{% block title %}Struktura i obowiązki{% endblock %}

{% block page_heading %}
    <div class="page-heading at-profit-head">
        <div class="page-title">
            <h3>Struktura i obowiązki</h3>
            <p class="text-subtitle text-muted">Organigram stanowisk i matryca : każdy obowiązek z zakresu prac → stanowisko → asystent kontroli (zadanie stanowiska).</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-primary" href="{{ root }}/organization/positions"><i class="bi bi-person-badge"></i> Stanowiska i zadania</a>
        </div>
    </div>
{% endblock %}

{% block content %}
<section class="section st-page" id="stPage" data-tab="{{ tab }}">
    <nav class="lc-tabs st-tabs" aria-label="Struktura i obowiązki">
        <a href="?tab=chart" data-st-tab="chart"><i class="bi bi-diagram-3"></i> Organigram</a>
        <a href="?tab=matrix" data-st-tab="matrix"><i class="bi bi-grid-3x3-gap"></i> Matryca obowiązków <b data-st-count></b></a>
    </nav>
    <div data-st-body><p class="text-muted">Wczytywanie…</p></div>
</section>
<style>
.st-tabs{display:flex;gap:4px;border-bottom:1px solid var(--at-line);margin:0 0 14px;flex-wrap:wrap}
.st-tabs a{padding:9px 14px;font-size:13.5px;color:var(--at-muted);border-bottom:2px solid transparent;margin-bottom:-1px;text-decoration:none;display:inline-flex;gap:6px;align-items:center}
.st-tabs a.on{color:var(--at-brand,#8D1D2C);border-color:var(--at-brand,#8D1D2C);font-weight:700}
.st-tabs b{background:var(--at-bg-2);border-radius:7px;padding:0 6px;font-size:11px;color:var(--at-muted)}
.st-grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:14px;align-items:start}
@media (max-width:1100px){.st-grid{grid-template-columns:minmax(0,1fr)}}
.st-canvas{background:#fff;border:1px solid var(--at-line);border-radius:14px;padding:16px 10px 22px;overflow:auto;background-image:radial-gradient(#ece5dd 1px,transparent 1px);background-size:18px 18px}
.st-rootzone{border:2px dashed var(--at-line);border-radius:10px;padding:7px 10px;font-size:12px;color:var(--at-muted);text-align:center;margin:0 auto 14px;max-width:420px}
.st-rootzone.is-over{border-color:#2e7d4f;background:#f1faf4;color:#1f6b33}
/* Drzewo : klasyczny organigram w CSS (linie od rodzica do dzieci). */
.st-tree,.st-tree ul{display:flex;justify-content:center;padding:18px 0 0;margin:0;position:relative;list-style:none}
.st-tree{padding-top:0;width:max-content;min-width:100%;margin:0 auto} /* plus large que le cadre : défilement, rien n'est coupé à gauche */
.st-tree li{display:flex;flex-direction:column;align-items:center;position:relative;padding:18px 4px 0}
.st-tree>li{padding-top:0}
.st-tree li::before,.st-tree li::after{content:"";position:absolute;top:0;right:50%;border-top:1.6px solid #cbbfb2;width:50%;height:18px}
.st-tree li::after{right:auto;left:50%;border-left:1.6px solid #cbbfb2}
.st-tree li:only-child::before,.st-tree li:only-child::after{display:none}
.st-tree li:only-child{padding-top:18px}
.st-tree>li:only-child{padding-top:0}
.st-tree li:first-child::before,.st-tree li:last-child::after{border:0 none}
.st-tree li:last-child::before{border-right:1.6px solid #cbbfb2;border-radius:0 6px 0 0}
.st-tree li:first-child::after{border-radius:6px 0 0 0}
.st-tree ul ul::before,.st-tree li>ul::before{content:"";position:absolute;top:0;left:50%;border-left:1.6px solid #cbbfb2;height:18px}
.st-node{width:152px;background:#fff;border:1.5px solid #e0d6cb;border-radius:12px;padding:8px 10px 9px;box-shadow:0 4px 12px rgba(40,30,20,.06);cursor:grab;text-align:left;position:relative;user-select:none}
.st-node h4{margin:0;font-size:12.5px;font-weight:700;line-height:1.25}
.st-node .m{font-size:11px;color:var(--at-muted);margin-top:2px}
.st-node .bar{height:5px;border-radius:3px;background:#efe9e3;margin-top:6px;overflow:hidden}.st-node .bar i{display:block;height:100%;background:#2e7d4f}
.st-node .k{position:absolute;top:-9px;right:8px;font-size:10px;font-weight:700;border-radius:6px;padding:1px 6px;background:#efe9e3;color:#5d554f}
.st-node.is-sel{outline:3px solid var(--at-brand,#8D1D2C);outline-offset:2px}
.st-node.is-over{border-color:#2e7d4f;background:#eef8f1}
.st-node.is-drag{opacity:.4}
.st-node.is-atelier{border-style:dashed}
.st-side{display:flex;flex-direction:column;gap:12px}
.st-card{background:#fff;border:1px solid var(--at-line);border-radius:14px;padding:14px}
.st-lbl{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--at-brand,#8D1D2C);font-weight:700;margin:0 0 8px}
.st-kv{display:grid;grid-template-columns:110px 1fr;gap:6px 10px;font-size:12.5px;margin:10px 0 0}.st-kv dt{color:var(--at-muted);font-weight:500}.st-kv dd{margin:0}
.st-big{font-size:26px;font-weight:700}
.st-bar{height:8px;border-radius:4px;background:#efe9e3;overflow:hidden}.st-bar i{display:block;height:100%;background:#2e7d4f}
.st-chip{display:inline-block;font-size:11.5px;border-radius:6px;padding:1px 7px;background:var(--at-bg-2);margin:0 4px 4px 0}
.st-pal{display:flex;flex-direction:column;gap:8px}
.st-help{font-size:12px;color:var(--at-muted);margin-top:8px}
.st-tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:0 0 12px}
@media (max-width:900px){.st-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
.st-tile{background:#fff;border:1px solid var(--at-line);border-radius:12px;padding:10px 12px}.st-tile span{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--at-muted);font-weight:700}.st-tile b{display:block;font-size:24px}.st-tile small{color:var(--at-muted)}
.st-filters{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
.st-filters .form-select,.st-filters .form-control{width:auto;min-width:150px}
.st-table td,.st-table th{vertical-align:middle;font-size:12.5px}
.st-table tr.st-grp td{background:#faf6f2;font-weight:700;color:var(--at-brand,#8D1D2C);font-size:12px}
.st-table tr.st-area td{background:#fcfaf8;font-weight:600;color:var(--at-text);font-size:12px}
.st-table tr[data-duty]{cursor:pointer}.st-table tr[data-duty]:hover td{background:#fbf6f2}.st-table tr.is-sel td{background:#fbf4f5}
.st-table .form-select-sm{min-width:150px;max-width:240px;font-size:12px}
.st-st{display:inline-block;font-size:11px;border-radius:6px;padding:2px 7px;font-weight:600;white-space:nowrap}
.st-st.ok{background:#e7f4ea;color:#1f6b33}.st-st.proposed{background:#fde8e8;color:#9b1c1c}.st-st.none{background:#fff3d6;color:#7a5a00}
.st-drawer textarea{min-height:90px}
.st-side[data-drawer]{position:sticky;top:12px} /* le panneau d'édition reste visible en descendant la matrice */
.st-preview{max-height:52vh;overflow:auto;border:1px solid var(--at-line);border-radius:10px;padding:8px 10px;margin:8px 0}
.st-preview h6{margin:8px 0 4px;font-size:12.5px;color:var(--at-brand,#8D1D2C)}
.st-preview label{display:flex;gap:8px;font-size:12.5px;padding:2px 0}
</style>
{% endblock %}

{% block scripts %}
{% include 'page_components/ajax_helpers.twig' %}
<script src="{{ root }}/assets/js/organization/structure.js?v={{ asset_v() }}"></script>
{% endblock %}
