{% extends "layouts/base.twig" %}

{% block title %}Mój podpis{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <div class="page-title">
            <h3>Mój podpis</h3>
            <p class="text-subtitle text-muted mb-0">Podpis do dokumentów : trafia do pola 22 CMR (« Podpis i stempel nadawcy ») każdej wysyłki, którą wystawiasz.
                Pole 23 podpisuje kierowca na tablecie przy starcie trasy, pole 24 — odbiorca.</p>
        </div>
    </div>
{% endblock %}

{% block content %}
{# [311] App\Controllers\Web\Organization\UserSignatureController. #}
<style>
.ms-wrap{display:grid;grid-template-columns:minmax(280px,1fr) minmax(260px,360px);gap:16px;align-items:start}
.ms-card{background:#fff;border:1px solid #eee;border-radius:12px;padding:16px}
.ms-pad{width:100%;height:220px;border:1px dashed #c9c2bc;border-radius:10px;background:#fff;touch-action:none;cursor:crosshair}
.ms-current{display:flex;align-items:center;justify-content:center;min-height:120px;border:1px solid #eee;border-radius:10px;background:#fafafa}
.ms-current img{max-width:100%;max-height:110px}
.ms-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
@media (max-width:900px){.ms-wrap{grid-template-columns:1fr}}
</style>
<section class="section ms-wrap" id="mySignature" data-root="{{ root }}">
    <div class="ms-card">
        <h5 class="mb-2">Narysuj podpis</h5>
        <canvas class="ms-pad" width="900" height="300" data-pad aria-label="Pole podpisu"></canvas>
        <div class="ms-row">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-clear>Wyczyść</button>
            <label class="btn btn-outline-secondary btn-sm mb-0">Wgraj obraz (PNG / JPG)<input type="file" accept="image/png,image/jpeg" data-file hidden></label>
            <button type="button" class="btn btn-primary btn-sm ms-auto" data-save>Zapisz podpis</button>
        </div>
        <p class="small text-muted mt-2 mb-0" data-msg></p>
    </div>
    <div class="ms-card">
        <h5 class="mb-2">Obecny podpis</h5>
        <div class="ms-current" data-current>
            {% if has_signature %}<img src="{{ root }}/ajax/my-signature/image?t={{ updated_at|date('U') }}" alt="Mój podpis">{% else %}<span class="text-muted small">Brak podpisu — pole 22 CMR będzie puste.</span>{% endif %}
        </div>
        {% if has_signature %}<p class="small text-muted mt-2 mb-1">Zapisany {{ updated_at|date('d.m.Y H:i') }}</p>
        <button type="button" class="btn btn-link btn-sm text-danger p-0" data-delete>Usuń podpis</button>{% endif %}
    </div>
</section>
{% endblock %}

{% block scripts %}
<script>
(() => {
    const box = document.getElementById('mySignature');
    const root = box.dataset.root;
    const canvas = box.querySelector('[data-pad]');
    const ctx = canvas.getContext('2d');
    const msg = box.querySelector('[data-msg]');
    let strokes = 0, drawing = false;
    const clear = () => { ctx.clearRect(0, 0, canvas.width, canvas.height); strokes = 0; };
    ctx.lineWidth = 3.5; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.strokeStyle = '#1f2a44';
    const point = (e) => { const r = canvas.getBoundingClientRect(); return [(e.clientX - r.left) * canvas.width / r.width, (e.clientY - r.top) * canvas.height / r.height]; };
    canvas.addEventListener('pointerdown', (e) => { drawing = true; strokes++; canvas.setPointerCapture(e.pointerId); const [x, y] = point(e); ctx.beginPath(); ctx.moveTo(x, y); });
    canvas.addEventListener('pointermove', (e) => { if (!drawing) return; const [x, y] = point(e); ctx.lineTo(x, y); ctx.stroke(); });
    canvas.addEventListener('pointerup', () => { drawing = false; });
    box.querySelector('[data-clear]').addEventListener('click', clear);
    // Obraz wgrany : dopasowany do pola (tło zostaje, PNG zapisany z pola).
    box.querySelector('[data-file]').addEventListener('change', async (e) => {
        const f = e.target.files[0];
        if (!f) return;
        const bmp = await createImageBitmap(f);
        clear();
        const scale = Math.min(canvas.width / bmp.width, canvas.height / bmp.height);
        const w = bmp.width * scale, h = bmp.height * scale;
        ctx.drawImage(bmp, (canvas.width - w) / 2, (canvas.height - h) / 2, w, h);
        strokes = 1;
    });
    const send = async (method, body) => {
        const res = await fetch(root + '/ajax/my-signature', {method, headers: {'Content-Type': 'application/json', 'Accept': 'application/json'}, credentials: 'same-origin', body: body ? JSON.stringify(body) : undefined});
        const json = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(json.message || (json.errors && json.errors[0] && json.errors[0].message) || 'Błąd');
        return json;
    };
    /** Podpis przycięty do narysowanej części (mniej pustego miejsca w polu CMR). */
    const cropped = () => {
        const d = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
        let x0 = canvas.width, y0 = canvas.height, x1 = 0, y1 = 0;
        for (let y = 0; y < canvas.height; y++) for (let x = 0; x < canvas.width; x++) {
            if (d[(y * canvas.width + x) * 4 + 3] > 10) { if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }
        }
        if (x1 <= x0 || y1 <= y0) return canvas.toDataURL('image/png');
        const pad = 12, out = document.createElement('canvas');
        x0 = Math.max(0, x0 - pad); y0 = Math.max(0, y0 - pad); x1 = Math.min(canvas.width, x1 + pad); y1 = Math.min(canvas.height, y1 + pad);
        out.width = Math.max(60, x1 - x0); out.height = Math.max(30, y1 - y0);
        out.getContext('2d').drawImage(canvas, x0, y0, x1 - x0, y1 - y0, 0, 0, x1 - x0, y1 - y0);
        return out.toDataURL('image/png');
    };
    box.querySelector('[data-save]').addEventListener('click', async () => {
        if (!strokes) { msg.textContent = 'Najpierw narysuj albo wgraj podpis.'; return; }
        try { const r = await send('POST', {image: cropped()}); msg.textContent = r.message; window.setTimeout(() => location.reload(), 600); }
        catch (err) { msg.textContent = err.message; }
    });
    const del = box.querySelector('[data-delete]');
    if (del) del.addEventListener('click', async () => {
        if (!window.confirm('Usunąć podpis ?')) return;
        try { await send('DELETE'); location.reload(); } catch (err) { msg.textContent = err.message; }
    });
})();
</script>
{% endblock %}
