{% extends "layouts/base.twig" %}

{% block title %}Najpierw to zadanie{% endblock %}

{% block content %}
{# [280] Zadania obowiązkowe (makieta 46) : ERP zablokowany, dopóki obowiązkowe zadanie nie jest zrobione. #}
<section class="section tl-wrap" id="taskRequired" data-root="{{ root }}">
    <div class="tl-card">
        <h2>Najpierw to zadanie</h2>
        <div class="tl-sub">{{ now|date('d.m.Y · H:i') }}</div>
        <div class="tl-warn"><i class="bi bi-lock-fill"></i> ERP jest zablokowany, bo obowiązkowe zadanie nie jest zrobione. Zakończ je w asystencie — reszta ERP wróci od razu.</div>
        {% for b in blocking %}
        <div class="tl-task">
            <i class="bi bi-lock-fill tl-lock" aria-hidden="true"></i>
            <div><b>{{ b.title }}</b><small>termin {{ b.due|date('d.m') }}{{ b.due_time ? ' ' ~ b.due_time : '' }} · blokada od {{ b.block_at|date('d.m H:i') }}{{ show_minutes and b.minutes ? ' · ok. ' ~ b.minutes ~ ' min' : '' }}</small></div>
            <span class="tl-sp"></span>
            <button type="button" class="kw-btn ghost" data-unblock="{{ b.task_id }}" data-title="{{ b.title }}">Poproś o odblokowanie</button>
            <a class="kw-btn pri" href="{{ root }}{{ b.link }}">Otwórz asystenta <i class="bi bi-arrow-right"></i></a>
        </div>
        {% endfor %}
        <p class="tl-note">Problem (awaria, brak danych) ? « Poproś o odblokowanie » — przełożony albo administrator dostaje powiadomienie i może odblokować ERP na dziś.
            <a href="{{ root }}/logout">Wyloguj</a></p>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script>
(function () {
    const app = document.getElementById('taskRequired');
    const root = app.dataset.root;
    app.addEventListener('click', async (e) => {
        const b = e.target.closest('[data-unblock]');
        if (!b) return;
        const reason = prompt('Dlaczego nie możesz zrobić zadania « ' + b.dataset.title + ' » ? (powód dla przełożonego)');
        if (!reason) return;
        const r = await fetch(root + '/ajax/tasks/' + b.dataset.unblock + '/unblock-request', {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/json', 'Accept': 'application/json'}, body: JSON.stringify({reason})});
        const j = await r.json().catch(() => ({}));
        alert(j.message || (r.ok ? 'Wysłane.' : 'Błąd.'));
        if (r.ok) { b.disabled = true; b.textContent = 'Prośba wysłana'; }
    });
})();
</script>
{% endblock %}
