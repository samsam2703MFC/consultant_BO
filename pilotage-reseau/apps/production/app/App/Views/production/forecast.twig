{% extends "layouts/base.twig" %}

{% block title %}Prognoza 13 tygodni{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <div class="page-title">
            <h3>Prognoza 13 tygodni</h3>
            <p class="text-subtitle text-muted mb-0">Co tydzień te same 13 tygodni do przodu : kartony na produkt (zamówienia, N-1 × trend sieci, gamy sezonowe panelu TF Buddy — tylko nasze produkty), palety, godziny produkcji i zakupy surowców. Zatwierdzenie w poniedziałek — Kierownik produkcji.</p>
        </div>
    </div>
{% endblock %}

{% block content %}
{# Produkcja › Prognoza 13 tygodni [220] (makiety 1–3) : zakładki Prognoza / Sezony z panelu / Zakupy 13 tygodni.
   App\Services\Forecast\ForecastService ; panel TF Buddy tylko do odczytu (GET). #}
<section class="section fc" id="forecastApp" data-root="{{ root }}">
    <div class="fc-bar">
        <div class="at-tabs" role="tablist" data-fc-tabs>
            <button type="button" data-fc-tab="forecast" class="active">Prognoza</button>
            <button type="button" data-fc-tab="seasons">Sezony z panelu <span class="at-tab-count" data-fc-count="seasons"></span></button>
            <button type="button" data-fc-tab="buy">Zakupy 13 tygodni <span class="at-tab-count" data-fc-count="buy"></span></button>
        </div>
        <span class="fc-approval" data-fc-approval></span>
    </div>
    <div data-fc-body><p class="at-empty">Ładowanie…</p></div>
</section>
<script type="application/json" id="forecastBoot">{{ boot|raw }}</script>
{% endblock %}

{% block scripts %}
<script src="{{ root }}/assets/js/production/forecast.js?v={{ asset_v() }}"></script>
{% endblock %}
