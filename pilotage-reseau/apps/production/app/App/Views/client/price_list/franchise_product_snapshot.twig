{% extends "layouts/base.twig" %}

{% set diagnostic_labels = {'ok':'Poprawny', 'inactive_supplier':'Wyłączony u dostawcy', 'missing_price':'Brak ceny', 'zero_price':'Cena zero', 'missing_sku':'Brak SKU', 'invalid_payload':'Nieprawidłowe dane'} %}
{% set diagnostic_classes = {'ok':'bg-success', 'inactive_supplier':'bg-secondary', 'missing_price':'bg-warning text-dark', 'zero_price':'bg-warning text-dark', 'missing_sku':'bg-danger', 'invalid_payload':'bg-danger'} %}
{% set diagnostic_descriptions = {'ok':'Brak problemu', 'inactive_supplier':'Pozycja jest wyłączona po stronie dostawcy.', 'missing_price':'Dostawca nie przekazał ceny netto.', 'zero_price':'Dostawca przekazał cenę netto równą zero.', 'missing_sku':'Dostawca nie przekazał identyfikatora SKU.', 'invalid_payload':'Brakuje wymaganego pola albo jego wartość ma nieprawidłowy format.'} %}

{% block page_heading %}
<div class="page-heading"><div class="page-title"><div class="row align-items-center">
    <div class="col-12 col-md-7 order-md-1 order-last"><h3 class="mb-0">Diagnostyka produktów franczyzowych</h3><p class="text-subtitle text-muted mb-0">{{ client.company|default('Nieznany klient') }}{% if client.franchisee_uid|default %} <span class="ms-1">({{ client.franchisee_uid }})</span>{% endif %}</p></div>
    <div class="col-12 col-md-5 order-md-2 order-first"><nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ root }}">Dashboard</a></li><li class="breadcrumb-item"><a href="{{ root }}/clients">Klienci</a></li><li class="breadcrumb-item active">Diagnostyka</li></ol></nav></div>
</div></div></div>
{% endblock %}

{% block content %}
<style>
    #snapshot-items-table { font-size: .8rem; }
    #snapshot-items-table thead th { background: #f8f9fa; border-bottom: 1px solid #dee2e6; color: #6c757d; font-size: .7rem; font-weight: 600; letter-spacing: .05em; padding: .45rem .6rem; text-transform: uppercase; white-space: nowrap; }
    #snapshot-items-table tbody td { padding: .45rem .6rem; vertical-align: middle; }
    .snapshot-stat { min-width: 115px; } .snapshot-stat .value { font-size: 1.35rem; font-weight: 600; line-height: 1.1; }
</style>
<section class="section"><div class="card">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2"><div><h4 class="card-title mb-1">Snapshot cennika dostawcy</h4><span class="text-muted small">Widok diagnostyczny bez możliwości edycji produktów.</span></div><button type="button" class="btn btn-primary" id="refresh-snapshot-button" {% if client is empty %}disabled{% endif %}><i class="bi bi-arrow-clockwise me-1"></i>Odśwież snapshot</button></div>
    <div class="card-body">
        <div class="row g-3 mb-4"><div class="col-12 col-lg-6"><div class="border rounded p-3 h-100"><div class="d-flex justify-content-between align-items-center mb-2"><strong>Ostatni poprawny snapshot</strong><span class="badge {{ latest_successful ? 'bg-success' : 'bg-secondary' }}">{{ latest_successful ? 'Sukces' : 'Brak' }}</span></div>{% if latest_successful %}<div class="small text-muted">Pobrano: {{ latest_successful.created_at|date('d.m.Y H:i') }}</div><div class="small text-muted">HTTP {{ latest_successful.http_code|default('-') }}, czas {{ latest_successful.duration_ms|default('-') }} ms</div>{% else %}<div class="small text-muted">Nie pobrano jeszcze poprawnej listy produktów.</div>{% endif %}</div></div>
        <div class="col-12 col-lg-6"><div class="border rounded p-3 h-100"><div class="d-flex justify-content-between align-items-center mb-2"><strong>Ostatnia próba</strong><span class="badge {{ latest_attempt.status|default('') == 'success' ? 'bg-success' : (latest_attempt.status|default('') == 'failed' ? 'bg-danger' : 'bg-secondary') }}">{{ latest_attempt.status|default('') == 'success' ? 'Sukces' : (latest_attempt.status|default('') == 'failed' ? 'Błąd' : 'Brak') }}</span></div>{% if latest_attempt %}<div class="small text-muted">Uruchomiono: {{ latest_attempt.created_at|date('d.m.Y H:i') }}</div><div class="small text-muted">HTTP {{ latest_attempt.http_code|default('-') }}{% if latest_attempt.error_code|default %}, {{ latest_attempt.error_code }}{% endif %}</div>{% if latest_attempt.error_message|default %}<div class="small text-danger mt-1">{{ latest_attempt.error_message }}</div>{% endif %}{% else %}<div class="small text-muted">Nie uruchomiono jeszcze odświeżenia.</div>{% endif %}</div></div></div>
        <div class="d-flex flex-wrap gap-2 mb-4"><div class="border rounded p-2 snapshot-stat"><div class="text-muted small">Wszystkie</div><div class="value">{{ statistics.all }}</div></div><div class="border rounded p-2 snapshot-stat"><div class="text-muted small">Aktywne</div><div class="value text-success">{{ statistics.active }}</div></div><div class="border rounded p-2 snapshot-stat"><div class="text-muted small">Nieaktywne</div><div class="value text-secondary">{{ statistics.inactive }}</div></div><div class="border rounded p-2 snapshot-stat"><div class="text-muted small">Problemy</div><div class="value text-danger">{{ statistics.problems }}</div></div></div>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3"><div class="btn-group" role="group"><button type="button" class="btn btn-outline-secondary active" data-snapshot-filter="all">Wszystkie</button><button type="button" class="btn btn-outline-secondary" data-snapshot-filter="active">Aktywne</button><button type="button" class="btn btn-outline-secondary" data-snapshot-filter="inactive">Wyłączone</button><button type="button" class="btn btn-outline-secondary" data-snapshot-filter="problems">Problemy</button><button type="button" class="btn btn-outline-secondary" data-snapshot-filter="missing-price">Brak ceny</button></div><span class="text-muted small" id="visible-items-count"></span></div>
        <div class="table-responsive"><table class="table table-sm table-hover mb-0" id="snapshot-items-table"><thead><tr><th>SKU</th><th>Nazwa</th><th>Dostępność supplier</th><th class="text-end">Cena netto</th><th>Valid from</th><th>Opakowanie</th><th>Status diagnostyczny</th><th>Opis problemu</th></tr></thead><tbody>
        {% for item in items %}{% set status = item.diagnostic_status|default('invalid_payload') %}<tr data-active="{{ item.is_active == 1 ? '1' : '0' }}" data-status="{{ status }}"><td>{{ item.sku|default('-') }}</td><td>{{ item.product_name|default('-') }}</td><td>{% if item.is_active == 1 %}<i class="bi bi-check-circle-fill text-success" title="Aktywna"></i>{% elseif item.is_active == 0 %}<i class="bi bi-dash-circle-fill text-danger" title="Wyłączona"></i>{% else %}<i class="bi bi-question-circle-fill text-warning" title="Nieznana"></i>{% endif %}</td><td class="text-end">{{ item.price_net is not null and item.price_net != '' ? item.price_net|number_format(2, ',', ' ') : '-' }}</td><td>{{ item.valid_from|default('-') }}</td><td><span class="package-size" data-package-size="{{ item.package_size|default('') }}"></span> {{ item.package_unit|default('') }}</td><td><span class="badge {{ diagnostic_classes[status]|default('bg-danger') }}">{{ diagnostic_labels[status]|default('Nieprawidłowe dane') }}</span></td><td class="text-muted">{{ diagnostic_descriptions[status]|default(diagnostic_descriptions.invalid_payload) }}</td></tr>{% else %}<tr><td colspan="8" class="text-center text-muted py-5">Brak pozycji w ostatnim poprawnym snapshotcie.</td></tr>{% endfor %}
        </tbody></table></div>
    </div>
</div></section>
{% endblock %}

{% block scripts %}
<script>
(() => { const clientId = {{ client.id|default(0) }}; const rows = Array.from(document.querySelectorAll('#snapshot-items-table tbody tr[data-status]')); const buttons = document.querySelectorAll('[data-snapshot-filter]'); const count = document.getElementById('visible-items-count'); const apply = (filter) => { let visible = 0; rows.forEach((row) => { const status = row.dataset.status; const active = row.dataset.active === '1'; const show = filter === 'all' || (filter === 'active' && active) || (filter === 'inactive' && !active) || (filter === 'problems' && status !== 'ok') || (filter === 'missing-price' && (status === 'missing_price' || status === 'zero_price')); row.classList.toggle('d-none', !show); if (show) visible++; }); count.textContent = rows.length ? `Widoczne: ${visible} z ${rows.length}` : ''; }; buttons.forEach((button) => button.addEventListener('click', () => { buttons.forEach((other) => other.classList.remove('active')); button.classList.add('active'); apply(button.dataset.snapshotFilter); })); document.querySelectorAll('.package-size').forEach((element) => { const value = Number(element.dataset.packageSize); element.textContent = Number.isFinite(value) ? value.toLocaleString('pl-PL', { maximumFractionDigits: 4 }) : '-'; }); const button = document.getElementById('refresh-snapshot-button'); if (button && clientId) button.addEventListener('click', () => { const label = button.innerHTML; button.disabled = true; button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Odświeżanie'; api(`/ajax/clients/${clientId}/franchise-product-snapshot/refresh`, { method: 'POST' }).then((response) => { if (response.ok && response.snapshot?.status === 'success') { window.location.reload(); return; } showSnack(false, response.snapshot?.error_message || response.error || response.message || 'Nie udało się odświeżyć snapshotu.'); }).catch(() => showSnack(false, 'Nie udało się połączyć z usługą snapshotu.')).finally(() => { button.disabled = false; button.innerHTML = label; }); }); apply('all'); })();
</script>
{% endblock %}
