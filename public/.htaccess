# Cockpit CEO — Apache (fonctionne à la racine d'un vhost comme en sous-répertoire)
DirectoryIndex index.html
RewriteEngine On

# Le shell et les modules JS/CSS sont REVALIDÉS à chaque visite. Sans en-tête
# explicite, Apache ne renvoie qu'un ETag et le navigateur applique alors son
# cache heuristique : après une livraison il continue de servir l'ancien
# fichier, et l'écran paraît inchangé alors que le serveur est à jour.
# « no-cache » n'interdit pas de stocker, il impose de revalider : avec l'ETag
# la requête coûte un 304 vide, pas un téléchargement.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# API REST → contrôleur frontal
RewriteRule ^api/cockpit(/.*)?$ api/index.php [L,QSA]

# Photos annexées au planogramme.
#
# Rien n'y est EXÉCUTÉ : un fichier déposé dont le nom finirait en .php doit
# rester un fichier. La règle vient avant tout le reste, pour qu'aucune
# réécriture ultérieure ne puisse l'atteindre.
RewriteRule ^uploads/.*\.(php|phtml|phar|phps|cgi|pl|py|sh|htaccess)$ - [F,L]

# Et une photo ABSENTE rend un 404, pas la page de l'application. Sans cette
# règle, la réécriture SPA plus bas renvoyait le shell HTML avec un statut 200 :
# la balise <img> recevait du HTML, affichait une image cassée, et rien
# n'indiquait que le fichier manquait.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^uploads/ - [R=404,L]

# SPA : tout chemin qui n'est pas un fichier réel → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "^uploads/">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
