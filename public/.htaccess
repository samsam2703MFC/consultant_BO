# Cockpit CEO — Apache (fonctionne à la racine d'un vhost comme en sous-répertoire)
DirectoryIndex index.html
RewriteEngine On

# Le shell et les modules JS/CSS sont REVALIDÉS à chaque visite. Sans en-tête
# explicite, Apache ne renvoie qu'un ETag et le navigateur applique alors son
# cache heuristique : après une livraison il continue de servir l'ancien
# fichier, et l'écran paraît inchangé alors que le serveur est à jour.
# « no-cache » n'interdit pas de stocker, il impose de revalider : avec l'ETag
# la requête coûte un 304 vide, pas un téléchargement.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# API REST → contrôleur frontal
RewriteRule ^api/cockpit(/.*)?$ api/index.php [L,QSA]

# SPA : tout chemin qui n'est pas un fichier réel → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Photos annexées au planogramme : servies telles quelles, mais JAMAIS exécutées.
# Un fichier déposé qui se terminerait en .php doit rester un fichier.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^uploads/.*\.(php|phtml|phar|cgi|pl|py|sh)$ - [F,L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^uploads/">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
