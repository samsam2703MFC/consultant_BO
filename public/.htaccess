# Cockpit CEO — Apache (fonctionne à la racine d'un vhost comme en sous-répertoire)
DirectoryIndex index.html
RewriteEngine On

# Le shell et les modules JS/CSS sont REVALIDÉS à chaque visite. Sans en-tête
# explicite, Apache ne renvoie qu'un ETag et le navigateur applique alors son
# cache heuristique : après une livraison il continue de servir l'ancien
# fichier, et l'écran paraît inchangé alors que le serveur est à jour.
# « no-cache » n'interdit pas de stocker, il impose de revalider : avec l'ETag
# la requête coûte un 304 vide, pas un téléchargement.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Le lecteur de code-barres (vendor/zxing) charge un .wasm : avec le bon type,
# le navigateur le compile pendant le téléchargement.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  # Le manifeste de la tablette des vendeuses (PWA) : sans son type, certains
  # navigateurs refusent de proposer l'installation.
  AddType application/manifest+json .webmanifest
</IfModule>

# API REST → contrôleur frontal
RewriteRule ^api/cockpit(/.*)?$ api/index.php [L,QSA]

# API de l'assistant de campagne (copie du module marketing). L'assistant
# appelle ../api/v1/marketing/… depuis /assistant/ ; sans cette règle, le
# repli SPA renverrait le shell HTML avec un statut 200.
RewriteRule ^api/v1/marketing(/.*)?$ api/marketing/index.php [L,QSA]

# Photos annexées au planogramme, et visuels de l'assistant de campagne.
#
# Rien n'y est EXÉCUTÉ : un fichier déposé dont le nom finirait en .php doit
# rester un fichier. La règle vient avant tout le reste, pour qu'aucune
# réécriture ultérieure ne puisse l'atteindre.
RewriteRule ^(uploads|assistant/uploads)/.*\.(php|phtml|phar|phps|cgi|pl|py|sh|htaccess)$ - [F,L]

# Et une photo ABSENTE rend un 404, pas la page de l'application. Sans cette
# règle, la réécriture SPA plus bas renvoyait le shell HTML avec un statut 200 :
# la balise <img> recevait du HTML, affichait une image cassée, et rien
# n'indiquait que le fichier manquait.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(uploads|assistant/uploads)/ - [R=404,L]

# La tablette des vendeuses (tablette/, application compilée) : un fichier
# ABSENT rend un 404, jamais le shell du cockpit. Sans cette règle, un morceau
# de script périmé ou une image mal nommée recevait la page HTML du cockpit avec
# un statut 200 — « Unexpected token < » à l'écran, et un cache hors ligne qui
# garde du HTML à la place d'une image. La règle est ici et pas dans
# tablette/.htaccess : la mise à jour remplace le dossier entier.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^tablette(/|$) - [R=404,L]

# SPA : tout chemin qui n'est pas un fichier réel → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "^uploads/">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
