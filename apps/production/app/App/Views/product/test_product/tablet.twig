{% extends "layouts/base.twig" %}

{% block title %}{{ product.name }} · nowy produkt{% endblock %}

{% set stage = product.dev.stage %}
{% set planned = trials|filter(t => t.status == 'planned') %}

{% block page_heading %}
    <div class="page-heading at-profit-head">
        <div class="page-title">
            <h3><i class="bi bi-kanban"></i> {{ product.name }}</h3>
            <p class="text-subtitle text-muted">Nowy produkt : etap {{ product.dev.stage_label|lower }}{% if product.dev.group %} · grupa {{ product.dev.group.name }} (jej tablet){% endif %}{% if product.target_date %} · cel {{ product.target_date|date('d.m.Y') }}{% endif %}.
                Testy i recepturę zespół potwierdza na tablecie — tu widać wynik, bez ponownego wpisywania.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-primary" href="{{ root }}/test-products/{{ product.id }}/edit"><i class="bi bi-pencil"></i> Produkt testowy i receptura</a>
            <a class="btn btn-outline-primary" href="{{ root }}/test-products/{{ product.id }}/changelogs"><i class="bi bi-clock-history"></i> Dziennik</a>
            <a class="btn btn-outline-secondary" href="{{ root }}/test-products/pipeline"><i class="bi bi-kanban"></i> Wszystkie etapy</a>
        </div>
    </div>
{% endblock %}

{% block content %}
<section class="section at-dev">
    <div class="card">
        <div class="card-body">
            <ol class="at-dev-flow" aria-label="Etapy">
                {% for f in flow %}<li class="is-{{ f.state }}"><span class="at-dev-flow-dot">{{ f.state == 'done' ? '✓' : loop.index }}</span>{{ f.label }}</li>{% endfor %}
            </ol>
            <div class="at-dev-next">
                {% if stage == 'stopped' %}<span class="at-pill at-pill-muted">Wstrzymany</span> Produkt nie jest pokazywany na tablecie.
                {% elseif product.dev.next %}<i class="bi bi-arrow-right-circle"></i> <strong>Następny krok :</strong> {{ product.dev.next.label }}
                    {% if product.dev.next.kind == 'trial' and not planned %} — zaplanuj test poniżej albo zespół doda go sam na tablecie.{% endif %}
                    {% if product.dev.next.kind == 'recipe' %} — na tablecie grupy (karta produktu → « Potwierdź recepturę »).{% endif %}
                    {% if product.dev.next.kind == 'office' %} — wybierz produkt ERP w « Wprowadzenie ».{% endif %}
                {% elseif stage == 'launched' %}<i class="bi bi-check2-circle"></i> Wprowadzony{% if product.final_product_name %} : <a href="{{ root }}/products/{{ product.final_product_id }}/edit">{{ product.final_product_name }}</a>{% endif %}.
                {% endif %}
                <form id="stageForm" class="at-dev-stage">
                    <select class="form-select form-select-sm" name="stage" aria-label="Etap">
                        {% if stage == 'launched' %}<option value="" selected disabled>Wprowadzony</option>{% endif %}
                        {% for s in stage_choices %}<option value="{{ s.code }}" {{ s.code == stage ? 'selected' : '' }}>{{ s.label }}</option>{% endfor %}
                    </select>
                    <button class="btn btn-sm btn-outline-secondary" type="submit">Zmień etap</button>
                </form>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h4 class="card-title">Testy receptury</h4>
            <p class="at-sub mb-0">Zaplanowany test pojawia się na tablecie grupy. Zespół robi go i potwierdza : zdjęcia (z godziną), ilość, wynik, co zmienić.
                OK po teście 1 → test 2 ; OK po teście 2 → receptura do zatwierdzenia ; « do poprawy » → kolejny test.</p></div>
        <div class="card-body pt-0">
            {% for t in trials %}
            <div class="at-dev-trial {{ t.status == 'planned' ? 'is-planned' : '' }}">
                <div class="at-dev-trial-head">
                    <strong>Test {{ t.no }}</strong>
                    {% if t.status == 'planned' %}
                        <span class="at-pill at-pill-muted">Zaplanowany{% if t.planned_date %} · {{ t.planned_date|date('d.m.Y') }}{% endif %}</span>
                        {% if t.group %}<span class="at-sub">{{ t.group }}</span>{% endif %}
                        <button type="button" class="btn btn-sm btn-outline-danger ms-auto" data-cancel-trial="{{ t.id }}"><i class="bi bi-x-lg"></i> Usuń</button>
                    {% else %}
                        <span class="at-pill {{ {ok: 'at-pill-ok', fix: 'at-pill-warn', ko: 'at-pill-danger'}[t.result] }}">{{ t.result_label }}</span>
                        <span class="at-sub">{{ t.done_at|date('d.m.Y H:i') }}{% if t.employee %} · {{ t.employee }}{% endif %}{% if t.group %} · {{ t.group }}{% endif %}{% if t.quantity is not null %} · ilość {{ t.quantity|number_format(t.quantity == t.quantity|round ? 0 : 2, ',', ' ') }}{% endif %}</span>
                    {% endif %}
                </div>
                {% if t.instructions %}<p class="mb-1"><span class="at-sub">Wskazówki :</span> {{ t.instructions|nl2br }}</p>{% endif %}
                {% if t.notes %}<p class="mb-1"><span class="at-sub">Zespół :</span> {{ t.notes|nl2br }}</p>{% endif %}
                {% if t.photos %}
                <div class="at-dev-trial-photos">
                    {% for ph in t.photos %}<a href="{{ root }}/test-products/trial-photos/{{ ph.id }}" target="_blank" rel="noopener"><img src="{{ root }}/test-products/trial-photos/{{ ph.id }}" alt="Test {{ t.no }} — {{ ph.taken_at|date('d.m H:i') }}" loading="lazy"><span>{{ ph.taken_at|date('d.m H:i') }}</span></a>{% endfor %}
                </div>
                {% endif %}
            </div>
            {% else %}
            <p class="at-empty">Brak testów.</p>
            {% endfor %}

            {% if stage not in ['launch', 'launched', 'stopped'] %}
            <form id="trialForm" class="at-purch-form mt-3">
                <label class="at-purch-label">Data testu<input class="form-control" type="date" name="planned_date"></label>
                <label class="at-purch-label">Grupa (jej tablet)
                    <select class="form-select" name="id_group" required>
                        {% for g in groups %}<option value="{{ g.id }}" {{ g.id == product.group_id ? 'selected' : '' }}>{{ g.name_pl }}</option>{% endfor %}
                    </select></label>
                <label class="at-purch-label at-purch-wide">Wskazówki dla zespołu (co sprawdzić, ile zrobić)<input class="form-control" name="instructions" maxlength="2000"></label>
                <div class="at-purch-actions"><span class="at-sub">Test {{ (trials|last ? trials|last.no : 0) + 1 }}</span><button class="btn btn-primary" type="submit"><i class="bi bi-calendar-plus"></i> Zaplanuj test</button></div>
            </form>
            {% endif %}
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><h4 class="card-title">Receptura</h4></div>
                <div class="card-body pt-0">
                    {% if product.recipe_id %}
                        <p class="mb-2"><a href="{{ root }}/recipes/{{ product.recipe_id }}/edit">{{ product.recipe_name }}</a> · <a href="{{ root }}/recipes/{{ product.recipe_id }}/calculation">kalkulacja</a></p>
                    {% else %}
                        <p class="mb-2"><span class="at-pill at-pill-warn">Brak receptury</span> Wybierz ją w <a href="{{ root }}/test-products/{{ product.id }}/edit">« Produkt testowy »</a> — tablet pokaże składniki, a zespół ją zatwierdzi.</p>
                    {% endif %}
                    {% if product.recipe_confirmed_at %}
                        <p class="mb-0"><i class="bi bi-patch-check text-success"></i> Zatwierdzona na tablecie {{ product.recipe_confirmed_at|date('d.m.Y H:i') }}{% if product.recipe_confirmed_name %} — {{ product.recipe_confirmed_name }}{% endif %}.</p>
                    {% else %}
                        <p class="at-sub mb-0">Zespół zatwierdza recepturę na tablecie po udanym teście 2.</p>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><h4 class="card-title">Wprowadzenie</h4></div>
                <div class="card-body pt-0">
                    {% if stage == 'launched' %}
                        <p class="mb-0"><i class="bi bi-check2-circle text-success"></i> Produkt ERP : {% if product.final_product_id %}<a href="{{ root }}/products/{{ product.final_product_id }}/edit">{{ product.final_product_name }}</a>{% else %}—{% endif %}. Data wprowadzenia w module kierownika produkcji i w raporcie miesięcznym.</p>
                    {% else %}
                        <form id="launchForm" class="d-flex gap-2 flex-wrap align-items-end">
                            <label class="at-purch-label" style="flex: 1 1 260px">Produkt ERP (po utworzeniu karty produktu)
                                <input class="form-control" name="final_product" list="finalProducts" placeholder="Szukaj produktu…" autocomplete="off"></label>
                            <datalist id="finalProducts">{% for fp in final_products %}<option value="{{ fp.name }} · #{{ fp.id }}"></option>{% endfor %}</datalist>
                            <button class="btn btn-primary" type="submit"><i class="bi bi-rocket-takeoff"></i> Wprowadź</button>
                        </form>
                        <p class="at-sub mt-2 mb-0">Produkt znika z tabletu, etap « Wprowadzony », produkt testowy zakończony.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header"><h4 class="card-title">Na tablecie</h4>
            <p class="at-sub mb-0">{{ product.status ?: '—' }} · {{ product.type ?: '—' }}{% if product.section %} · dział {{ product.section }}{% endif %}{% if stages %} · dziennik : {{ stages[0].stage }}{% endif %}</p></div>
        <div class="card-body pt-0">
            <form id="devForm" class="at-purch-form">
                <label class="form-check form-switch at-purch-wide"><input class="form-check-input" type="checkbox" name="on_tablet" {{ product.on_tablet ? 'checked' : '' }}> Pokaż na tablecie grupy</label>
                <label class="at-purch-label">Grupa (jej tablet)
                    <select class="form-select" name="id_group">
                        <option value="">— według działu —</option>
                        {% for g in groups %}<option value="{{ g.id }}" {{ g.id == product.group_id ? 'selected' : '' }}>{{ g.name_pl }}</option>{% endfor %}
                    </select></label>
                <label class="at-purch-label">Data docelowa<input class="form-control" type="date" name="target_date" value="{{ product.target_date }}"></label>
                <label class="at-purch-label at-purch-wide">Film (YouTube, Vimeo, plik mp4 albo link)<input class="form-control" name="video_url" type="url" maxlength="500" value="{{ product.video_url }}" placeholder="https://www.youtube.com/watch?v=…"></label>
                {% if product.video %}<p class="at-sub at-purch-wide mb-0 align-self-end"><i class="bi bi-play-btn"></i> {{ {youtube: 'YouTube — odtwarzacz na tablecie', vimeo: 'Vimeo — odtwarzacz na tablecie', file: 'plik wideo — odtwarzacz na tablecie', link: 'link — otwierany w nowej karcie'}[product.video.kind] }}</p>{% endif %}
                <label class="at-purch-label" style="grid-column: 1 / -1">Notatki dla zespołu (wykonanie, na co uważać, co ocenić)<textarea class="form-control" name="notes" rows="4" maxlength="5000">{{ product.notes }}</textarea></label>
                <div class="at-purch-actions"><span></span><button class="btn btn-primary" type="submit">Zapisz</button></div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h4 class="card-title">Zdjęcia wzorcowe <span class="at-sub">({{ photos|length }} / {{ max_photos }})</span></h4>
            <p class="at-sub mb-0">Jak ma wyglądać produkt (zdjęcia z testów są wyżej). Zmniejszane w przeglądarce (JPEG, najdłuższy bok 1600 px) ; podpis opcjonalny.</p></div>
        <div class="card-body pt-0">
            <div class="at-dev-photos">
                {% for ph in photos %}
                <figure class="at-dev-photo">
                    <img src="{{ root }}/test-products/photos/{{ ph.id }}" alt="{{ ph.caption ?: product.name }}" loading="lazy">
                    <figcaption>{{ ph.caption ?: '—' }} <button type="button" class="btn btn-sm btn-outline-danger" data-del-photo="{{ ph.id }}" aria-label="Usuń zdjęcie"><i class="bi bi-trash"></i></button></figcaption>
                </figure>
                {% else %}<p class="at-sub">Brak zdjęć.</p>{% endfor %}
            </div>
            {% if photos|length < max_photos %}
            <form id="photoForm" class="d-flex gap-2 flex-wrap align-items-end mt-2">
                <input class="form-control" type="file" name="file" accept="image/*" multiple required style="flex: 2 1 240px">
                <input class="form-control" name="caption" maxlength="200" placeholder="Podpis (opcjonalnie)" style="flex: 2 1 200px">
                <button class="btn btn-primary" type="submit"><i class="bi bi-upload"></i> Dodaj</button>
            </form>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}

{% block scripts %}
{% include "page_components/ajax_helpers.twig" %}
<script>
(function () {
    const id = {{ product.id }};
    const done = (res) => { at.notify(res.ok, res.message || (res.ok ? 'Zapisano' : 'Błąd')); if (res.ok) setTimeout(() => location.reload(), 500); };
    const form = document.getElementById('devForm');
    form.addEventListener('submit', (e) => {
        e.preventDefault();
        at.send(`/ajax/test-products/${id}/tablet`, 'PUT', {on_tablet: form.on_tablet.checked, video_url: form.video_url.value, notes: form.notes.value,
            id_group: form.id_group.value || null, target_date: form.target_date.value || null}).then(done);
    });
    const stageForm = document.getElementById('stageForm');
    stageForm.addEventListener('submit', (e) => {
        e.preventDefault();
        at.send(`/ajax/test-products/${id}/stage`, 'PUT', {stage: stageForm.stage.value}).then(done);
    });
    const trialForm = document.getElementById('trialForm');
    if (trialForm) trialForm.addEventListener('submit', (e) => {
        e.preventDefault();
        at.send(`/ajax/test-products/${id}/trials`, 'POST', {planned_date: trialForm.planned_date.value || null, id_group: trialForm.id_group.value, instructions: trialForm.instructions.value}).then(done);
    });
    document.querySelectorAll('[data-cancel-trial]').forEach(b => b.addEventListener('click', () => {
        if (!confirm('Usunąć zaplanowany test ?')) return;
        at.send(`/ajax/test-products/${id}/trials/${b.dataset.cancelTrial}`, 'DELETE').then(done);
    }));
    const launchForm = document.getElementById('launchForm');
    if (launchForm) launchForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const m = /#(\d+)\s*$/.exec(launchForm.final_product.value);
        if (!m) { at.notify(false, 'Wybierz produkt ERP z listy.'); return; }
        if (!confirm('Wprowadzić produkt ? Zniknie z tabletu.')) return;
        at.send(`/ajax/test-products/${id}/launch`, 'PUT', {final_product_id: Number(m[1])}).then(done);
    });
    // Zdjęcie zmniejszone w przeglądarce do JPEG (najdłuższy bok 1600 px).
    const shrink = (file) => new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => {
            const scale = Math.min(1, 1600 / Math.max(img.width, img.height));
            const c = document.createElement('canvas');
            c.width = Math.round(img.width * scale); c.height = Math.round(img.height * scale);
            c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
            URL.revokeObjectURL(img.src);
            resolve(c.toDataURL('image/jpeg', 0.8));
        };
        img.onerror = reject;
        img.src = URL.createObjectURL(file);
    });
    const photoForm = document.getElementById('photoForm');
    if (photoForm) photoForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = photoForm.querySelector('button');
        btn.disabled = true;
        let ok = true;
        for (const file of photoForm.file.files) {
            let image;
            try { image = await shrink(file); } catch (err) { at.notify(false, 'Nie udało się wczytać zdjęcia : ' + file.name); ok = false; continue; }
            const res = await at.send(`/ajax/test-products/${id}/photos`, 'POST', {image, caption: photoForm.caption.value});
            if (!res.ok) { at.notify(false, res.message || 'Błąd'); ok = false; break; }
        }
        btn.disabled = false;
        if (ok) at.notify(true, 'Dodano zdjęcia.');
        setTimeout(() => location.reload(), 500);
    });
    document.querySelectorAll('[data-del-photo]').forEach(b => b.addEventListener('click', () => {
        if (!confirm('Usunąć zdjęcie ?')) return;
        at.send(`/ajax/test-products/${id}/photos/${b.dataset.delPhoto}`, 'DELETE').then(res => { at.notify(res.ok, res.message); if (res.ok) b.closest('figure').remove(); });
    }));
})();
</script>
{% endblock %}
