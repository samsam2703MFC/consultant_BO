{% extends "layouts/base.twig" %}

{% block title %}Plan tygodnia — {{ plan.position.name_pl }}{% endblock %}

{% block page_heading %}
    <div class="page-heading at-profit-head">
        <div class="page-title">
            <h3>Plan tygodnia stanowiska</h3>
            <p class="text-subtitle text-muted mb-0">Funkcje i zadania › {{ plan.position.name_pl }} — dni, minuty, link do strony ERP i czas rzeczywisty ; osoby na stanowisku widzą ten plan na stronie Dzisiaj (« Mój tydzień »).</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-primary" href="{{ root }}/organization/positions"><i class="bi bi-arrow-left"></i> Funkcje i zadania</a>
        </div>
    </div>
{% endblock %}

{% block content %}
{# Plan tygodnia [219] (makieta 2, tylko administrator) : App\Services\Organization\PositionTaskService::weekPlan / saveWeekPlan / copyPlan.
   Tabela budowana w assets/js/organization/week-plan.js z danych poniżej ; zapis całego planu naraz. #}
<section class="section" id="weekPlanApp" data-position="{{ plan.position.id }}">
    <div class="kw"><p class="at-empty">Ładowanie…</p></div>
</section>
<script type="application/json" id="weekPlanBoot">{{ plan|json_encode|raw }}</script>
{% endblock %}

{% block scripts %}
{% include 'page_components/ajax_helpers.twig' %}
<script src="{{ root }}/assets/js/organization/week-plan.js?v={{ asset_v() }}"></script>
{% endblock %}
