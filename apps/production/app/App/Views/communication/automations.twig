{% extends "layouts/base.twig" %}

{% set event_labels = {
    'order_received': 'Zamówienie przyjęte',
    'delivery_planned': 'Planowana dostawa',
    'shipment_sent': 'Wysyłka wyjechała',
    'wdt_issued': 'Wystawiono WDT',
    'invoice_issued': 'Wystawiono fakturę',
    'proforma_issued': 'Wystawiono proformę'
} %}
{% set rule_labels = {
    'ORDER_CONFIRMATION': 'Potwierdzenie zamówienia do klienta (z proformą)',
    'DELIVERY_PLANNED': 'Informacja o planowanej dostawie',
    'SHIPMENT_SENT': 'Wysyłka w drodze (z dokumentem WZ)',
    'WDT_TO_CLIENT': 'Faktura WDT do klienta',
    'INVOICE_TO_CLIENT': 'Faktura do klienta',
    'ACCOUNTING_WDT': 'Kopia WDT do biura rachunkowego',
    'ACCOUNTING_INVOICE': 'Kopia faktury do biura rachunkowego',
    'ACCOUNTING_PROFORMA': 'Kopia proformy do biura rachunkowego'
} %}
{% set recipient_labels = {
    'client_head': 'Klient — adres główny',
    'client_accountant': 'Klient — księgowość',
    'client_salesman': 'Klient — handlowiec',
    'fixed': 'Stały adres (biuro rachunkowe)'
} %}

{% block title %}Automatyczne e-maile{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <div class="page-title">
            <h3>Automatyczne e-maile</h3>
            <p class="text-subtitle text-muted">Potwierdzenia zamówień, dostawy, faktury do klientów i kopie dokumentów dla księgowości.</p>
        </div>
    </div>
{% endblock %}

{% block content %}
<section class="section at-mail">

    <div class="alert {{ delivery_mode == 'live' ? 'alert-light-secondary' : 'alert-warning' }} d-flex align-items-center gap-2">
        <i class="bi {{ delivery_mode == 'live' ? 'bi-send-check' : 'bi-shield-lock' }}"></i>
        <span class="me-auto"><strong>{{ delivery_label }}</strong>
            {% if delivery_mode != 'live' %} — ustawienie MAIL_DELIVERY_MODE w pliku .env serwera.{% endif %}
            {% if not has_account and delivery_mode != 'log_only' %} Brak aktywnego konta e-mail: <a href="{{ root }}/communication/email-settings">skonfiguruj</a>.{% endif %}
        </span>
        <button type="button" class="btn btn-sm btn-primary" id="mailRunNow"><i class="bi bi-play-fill"></i> Uruchom teraz</button>
    </div>

    <div class="card">
        <div class="card-header"><h4 class="card-title">Ustawienia</h4></div>
        <div class="card-body pt-0">
            <form id="mailSettings" class="row g-3 align-items-end">
                <div class="col-12 col-md-6">
                    <label class="form-label" for="accountingAddress">Adres biura rachunkowego / serwera księgowego</label>
                    <input type="email" class="form-control" id="accountingAddress" value="{{ accounting_address }}" placeholder="faktury@biuro-rachunkowe.pl">
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="clientLanguage">Język e-maili do klientów</label>
                    <select class="form-select" id="clientLanguage">
                        {% for code, label in {'fr': 'Francuski', 'nl': 'Niderlandzki', 'pl': 'Polski'} %}
                            <option value="{{ code }}" {{ client_language == code ? 'selected' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-6 col-md-3"><button type="submit" class="btn btn-outline-dark w-100">Zapisz</button></div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="card-title mb-0">Reguły</h4>
            <a class="at-link" href="{{ root }}/communication/templates">Szablony wiadomości</a>
        </div>
        <div class="card-body pt-0">
            <p class="text-muted small">Włączenie reguły dotyczy tylko nowych zdarzeń: dokumenty wystawione wcześniej nie zostaną wysłane.</p>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th>Aktywna</th><th>Reguła</th><th>Odbiorca</th><th>Język</th><th>Załącznik</th><th class="text-end">Wysłane / problemy</th><th></th></tr>
                    </thead>
                    <tbody>
                    {% for r in rules %}
                        <tr data-rule="{{ r.id }}">
                            <td>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" type="checkbox" data-field="enabled" {{ r.enabled ? 'checked' }} aria-label="Aktywna">
                                </div>
                            </td>
                            <td>
                                <strong>{{ rule_labels[r.code]|default(r.code) }}</strong>
                                <div class="text-muted small">{{ event_labels[r.event]|default(r.event) }}
                                    {% if r.event == 'delivery_planned' %}
                                        · <label class="d-inline">dni przed <input type="number" min="0" max="14" class="form-control form-control-sm d-inline-block at-days-input" data-field="days_before" value="{{ r.days_before }}"></label>
                                    {% endif %}
                                    {% if r.enabled and r.enabled_at %} · od {{ r.enabled_at }}{% endif %}
                                </div>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" data-field="recipient_kind">
                                    {% for code, label in recipient_labels %}
                                        <option value="{{ code }}" {{ r.recipient_kind == code ? 'selected' }}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                                <input type="email" class="form-control form-control-sm mt-1 {{ r.recipient_kind != 'fixed' ? 'd-none' }}" data-field="fixed_address"
                                       value="{{ r.fixed_address }}" placeholder="adres biura rachunkowego z ustawień">
                            </td>
                            <td>
                                <select class="form-select form-select-sm" data-field="language">
                                    {% for code, label in {'client': 'Klienta', 'fr': 'FR', 'nl': 'NL', 'pl': 'PL'} %}
                                        <option value="{{ code }}" {{ r.language == code ? 'selected' }}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td>
                                {% if r.event != 'delivery_planned' %}
                                    <div class="form-check form-switch m-0"><input class="form-check-input" type="checkbox" data-field="attach_document" {{ r.attach_document ? 'checked' }} aria-label="Załącznik PDF"></div>
                                {% else %}—{% endif %}
                            </td>
                            <td class="text-end">{{ r.queued_count }} / {{ r.problem_count }}</td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-dark" data-preview="{{ r.id }}">Podgląd</button></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h4 class="card-title">Ostatnie zdarzenia</h4></div>
        <div class="card-body pt-0">
            {% if dispatches %}
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Kiedy</th><th>Reguła</th><th>Zdarzenie</th><th>Odbiorca / temat</th><th>Stan</th><th></th></tr></thead>
                    <tbody>
                    {% for d in dispatches %}
                        <tr>
                            <td>{{ d.created_at }}</td>
                            <td>{{ rule_labels[d.rule_code]|default(d.rule_code) }}</td>
                            <td><code>{{ d.ref_key }}</code></td>
                            <td>{% if d.id_message %}<a href="{{ root }}/communication/messages/{{ d.id_message }}">{{ d.recipient_email }}</a><div class="text-muted small">{{ d.subject_text }}</div>{% else %}—{% endif %}</td>
                            <td>
                                {% if d.status == 'queued' %}
                                    {% if d.message_status == 'sent' and (d.provider_message_id ?? '') starts with 'LOG_ONLY:' %}
                                        <span class="at-pill at-pill-muted">Zarejestrowana (nie wysłana)</span>
                                    {% elseif d.message_status == 'sent' %}<span class="at-pill at-pill-ok">Wysłana</span>
                                    {% elseif d.message_status == 'failed' %}<span class="at-pill at-pill-danger">Błąd wysyłki</span>
                                    {% else %}<span class="at-pill at-pill-warn">W kolejce</span>{% endif %}
                                {% else %}
                                    <span class="at-pill {{ d.status == 'failed' ? 'at-pill-danger' : 'at-pill-warn' }}">{{ d.status == 'failed' ? 'Błąd' : 'Pominięte' }}</span>
                                    <div class="text-muted small">{{ d.reason }}</div>
                                {% endif %}
                            </td>
                            <td class="text-end">{% if d.status != 'queued' %}<button type="button" class="btn btn-sm btn-outline-dark" data-retry="{{ d.id }}">Ponów</button>{% endif %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <p class="at-empty">Brak zdarzeń. Włącz regułę: obsłuży nowe zamówienia, wysyłki i dokumenty.</p>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script>
(() => {
    const root = {{ root|json_encode|raw }};
    const send = (url, method, data) => fetch(root + url, {
        method, credentials: 'same-origin',
        headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
        body: data ? JSON.stringify(data) : undefined,
    }).then(r => r.json().then(body => ({ok: r.ok, ...body})));
    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));

    document.querySelectorAll('[data-rule]').forEach(row => {
        row.addEventListener('change', (e) => {
            const field = e.target.dataset.field;
            if (!field) return;
            const value = e.target.type === 'checkbox' ? e.target.checked : e.target.value;
            if (field === 'recipient_kind') row.querySelector('[data-field="fixed_address"]').classList.toggle('d-none', value !== 'fixed');
            send(`/ajax/communication/automations/${row.dataset.rule}`, 'PATCH', {[field]: value}).then(res => {
                showSnack(res.ok, res.message || (res.ok ? 'Zapisano' : 'Błąd'));
                if (!res.ok && e.target.type === 'checkbox') e.target.checked = !value;
            });
        });
    });

    document.getElementById('mailSettings').addEventListener('submit', (e) => {
        e.preventDefault();
        send('/ajax/communication/automations/settings', 'POST', {
            accounting_address: document.getElementById('accountingAddress').value,
            client_language: document.getElementById('clientLanguage').value,
        }).then(res => showSnack(res.ok, res.message));
    });

    document.getElementById('mailRunNow').addEventListener('click', (e) => {
        e.target.disabled = true;
        send('/ajax/communication/automations/run', 'POST').then(res => {
            Swal.fire({icon: res.ok ? 'success' : 'error', text: res.message}).then(() => location.reload());
        }).finally(() => { e.target.disabled = false; });
    });

    document.addEventListener('click', (e) => {
        const preview = e.target.closest('[data-preview]');
        const retry = e.target.closest('[data-retry]');
        if (retry) {
            send(`/ajax/communication/automations/dispatches/${retry.dataset.retry}/retry`, 'POST').then(res => { showSnack(res.ok, res.message); location.reload(); });
        }
        if (!preview) return;
        send(`/ajax/communication/automations/${preview.dataset.preview}/preview`, 'GET').then(res => {
            const p = res.data || {};
            if (!res.ok) return Swal.fire({icon: 'error', text: res.message});
            if (p.empty) return Swal.fire({icon: 'info', text: 'Brak zdarzenia tego typu do pokazania.'});
            Swal.fire({
                width: 640,
                title: 'Podgląd',
                html: `<div class="text-start small">
                    <p class="mb-1"><strong>Do:</strong> ${esc(p.recipient) || '—'} · <strong>Język:</strong> ${esc(p.language)} · <strong>Szablon:</strong> ${esc(p.template) || '—'}</p>
                    <p class="mb-1"><strong>Zdarzenie:</strong> <code>${esc(p.ref_key)}</code>${p.attachment ? ' · <strong>Załącznik:</strong> ' + esc(p.attachment.source) + ' ' + esc(p.attachment.id) : ''}</p>
                    ${p.problem ? `<div class="alert alert-warning py-2">${esc(p.problem)}</div>` : ''}
                    ${p.subject ? `<p class="mb-1"><strong>${esc(p.subject)}</strong></p><pre class="at-mail-body">${esc(p.body)}</pre>` : ''}
                </div>`,
            });
        });
    });
})();
</script>
{% endblock %}
