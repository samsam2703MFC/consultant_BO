{% extends "layouts/base.twig" %}

{% block title %}{{ page_title ?? 'Karty produktów · Fiches produits' }}{% endblock %}

{% block content %}
<section class="section tfb">
    {# Application du module atelier : tout passe par l'API, rien n'est lu en base ici. #}
    <div id="tfbProducts" class="tfb-app" data-root="{{ root }}" data-api-base="{{ api_base }}" data-user="{{ session_user }}" data-labels="workshop"{% if start_view is defined %} data-start-view="{{ start_view }}"{% endif %} aria-live="polite">
        <p class="text-muted">Wczytywanie… / Chargement…</p>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script src="{{ root }}/assets/js/workshop/api.js?v={{ asset_v() }}"></script>
<script src="{{ root }}/assets/js/pallet-views.js?v={{ asset_v() }}"></script>
<script src="{{ root }}/assets/js/workshop/products.js?v={{ asset_v() }}"></script>
{% endblock %}
