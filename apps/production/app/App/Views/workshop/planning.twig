{% extends "layouts/base.twig" %}

{% block title %}Plan pracowni · Plan de l'atelier{% endblock %}

{% block content %}
<section class="section tfb">
    <div id="tfbPlanning" class="tfb-app" data-root="{{ root }}" data-api-base="{{ api_base }}" data-user="{{ session_user }}" data-week-start-day="{{ week_start_day }}" data-labels="planning" aria-live="polite">
        <p class="text-muted">Wczytywanie… / Chargement…</p>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script src="{{ root }}/assets/js/workshop/api.js"></script>
<script src="{{ root }}/assets/js/workshop/planning.js"></script>
{% endblock %}
