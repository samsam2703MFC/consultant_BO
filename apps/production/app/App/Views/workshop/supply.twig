{% extends "layouts/base.twig" %}

{% block title %}Zaopatrzenie · Approvisionnement{% endblock %}

{% block content %}
<section class="section tfb">
    <div id="tfbSupply" class="tfb-app" data-root="{{ root }}" data-api-base="{{ api_base }}" data-user="{{ session_user }}" data-labels="supply" aria-live="polite">
        <p class="text-muted">Wczytywanie… / Chargement…</p>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script src="{{ root }}/assets/js/workshop/api.js?v={{ asset_v() }}"></script>
<script src="{{ root }}/assets/js/workshop/price-history.js?v={{ asset_v() }}"></script>
<script src="{{ root }}/assets/js/workshop/invoice-classify.js?v={{ asset_v() }}"></script>
<script src="{{ root }}/assets/js/workshop/invoice-price-up.js?v={{ asset_v() }}"></script>
<script src="{{ root }}/assets/js/workshop/invoice-wizard.js?v={{ asset_v() }}"></script>
<script src="{{ root }}/assets/js/workshop/supply.js?v={{ asset_v() }}"></script>
{% endblock %}
