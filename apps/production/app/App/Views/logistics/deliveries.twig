{% extends "layouts/base.twig" %}

{% block title %}Dostawy · potwierdzenia{% endblock %}

{% block page_heading %}
    <div class="page-heading at-profit-head">
        <div class="page-title">
            <h3>Dostawy : potwierdzenia z tabletu kierowcy</h3>
            <p class="text-subtitle text-muted">Dzień wysyłki {{ date|date('d.m.Y') }} : start i koniec trasy, dostawy potwierdzone (odbiorca, podpis, zdjęcie, palety) i problemy · Livraisons confirmées sur la tablette chauffeur</p>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <a class="btn btn-outline-primary" href="{{ root }}/logistics/deliveries?date={{ prev }}" aria-label="Poprzedni dzień"><i class="bi bi-chevron-left"></i></a>
            <form method="get" class="d-flex gap-2"><input type="date" class="form-control" name="date" value="{{ date }}" aria-label="Dzień wysyłki" onchange="this.form.submit()"></form>
            <a class="btn btn-outline-primary" href="{{ root }}/logistics/deliveries?date={{ next }}" aria-label="Następny dzień"><i class="bi bi-chevron-right"></i></a>
            <a class="btn btn-outline-primary" href="{{ root }}/logistics?date={{ date }}"><i class="bi bi-boxes"></i> Załadunek dnia</a>
        </div>
    </div>
{% endblock %}

{% block content %}
<section class="section at-deliveries">
    <div class="card"><div class="card-body d-flex flex-wrap gap-4">
        <div><div class="at-sub">Klienci</div><strong class="fs-4">{{ totals.customers }}</strong></div>
        <div><div class="at-sub">Dostarczono</div><strong class="fs-4 text-success">{{ totals.delivered }}</strong></div>
        <div><div class="at-sub">Problemy</div><strong class="fs-4 {{ totals.problems ? 'text-danger' : '' }}">{{ totals.problems }}</strong></div>
        <div><div class="at-sub">Bez potwierdzenia</div><strong class="fs-4">{{ totals.customers - totals.delivered - totals.problems }}</strong></div>
        <p class="at-sub mb-0 ms-auto align-self-center" style="max-width: 420px">Tablet kierowcy : Produkcja › Tablet produkcji › Zarządzanie › Tablety → « Tablet kierowcy » z pojazdem, potem strona /driver na tablecie.</p>
    </div></div>

    {% macro stopRow(r, root) %}
        {% set s = r.stop %}
        <tr class="{{ s and s.status == 'problem' ? 'table-danger' : '' }}">
            <td><strong>{{ r.name }}</strong>{% if r.town %}<div class="at-sub">{{ r.town }}</div>{% endif %}</td>
            <td class="text-end">{{ r.pallets ?? '—' }}</td>
            <td>
                {% if not s %}<span class="badge bg-light text-dark">bez potwierdzenia</span>
                {% elseif s.status == 'delivered' %}<span class="badge bg-success">dostarczono {{ s.recorded_at|date('H:i') }}</span>
                {% else %}<span class="badge bg-danger">problem {{ s.recorded_at|date('H:i') }} : {{ s.reason_label }}</span>{% endif %}
            </td>
            <td>{{ s ? (s.receiver_name ?: '—') : '' }}{% if s and s.note %}<div class="at-sub">{{ s.note }}</div>{% endif %}</td>
            <td class="text-end">{{ s and s.pallets_delivered is not null ? s.pallets_delivered : '' }}</td>
            <td class="text-end">{{ s and s.pallets_returned is not null ? s.pallets_returned : '' }}</td>
            <td class="at-deliv-media">
                {% if s and s.signature_id %}<a href="{{ root }}/logistics/deliveries/media/{{ s.signature_id }}" target="_blank" rel="noopener"><img src="{{ root }}/logistics/deliveries/media/{{ s.signature_id }}" alt="Podpis {{ r.name }}" loading="lazy"></a>{% endif %}
                {% for p in s ? s.photo_ids : [] %}<a href="{{ root }}/logistics/deliveries/media/{{ p }}" target="_blank" rel="noopener"><img src="{{ root }}/logistics/deliveries/media/{{ p }}" alt="Zdjęcie {{ r.name }}" loading="lazy"></a>{% endfor %}
            </td>
            <td class="text-end text-nowrap">{% if s %}<a class="btn btn-sm btn-outline-primary" href="{{ root }}/logistics/deliveries/{{ s.id }}/proof.pdf" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                <a class="btn btn-sm btn-outline-secondary" href="{{ root }}/logistics/deliveries/{{ s.id }}/proof.pdf?lang=fr" target="_blank" rel="noopener">FR</a>{% endif %}</td>
        </tr>
    {% endmacro %}

    {% for t in trucks %}
    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between gap-2 align-items-center">
            <div><h4 class="card-title mb-0">{{ t.label }} <span class="at-sub">{{ t.carrier != t.label ? t.carrier : '' }}{{ t.driver ? ' · ' ~ t.driver : '' }}</span></h4>
                <div class="at-sub">Wyjazd planowany {{ t.departure }}{% if t.started_at %} · start {{ t.started_at|date('H:i') }}{% endif %}{% if t.finished_at %} · koniec {{ t.finished_at|date('d.m H:i') }}{% endif %}</div></div>
            <div><span class="badge bg-success">{{ t.delivered }}/{{ t.rows|length }} dostarczono</span>{% if t.problems %} <span class="badge bg-danger">{{ t.problems }} problem(y)</span>{% endif %}</div>
        </div>
        <div class="card-body pt-0"><div class="table-responsive"><table class="table table-sm align-middle mb-0">
            <thead><tr><th>Klient</th><th class="text-end">Palety plan</th><th>Status</th><th>Odbiorca / uwagi</th><th class="text-end">Dostarczone</th><th class="text-end">Zwrócone EUR</th><th>Podpis, zdjęcie</th><th></th></tr></thead>
            <tbody>{% for r in t.rows %}{{ _self.stopRow(r, root) }}{% endfor %}</tbody>
        </table></div></div>
    </div>
    {% else %}
    <div class="card"><div class="card-body text-muted">Brak pojazdów z klientami w tym dniu.</div></div>
    {% endfor %}

    {% if other %}
    <div class="card">
        <div class="card-header"><h4 class="card-title">Inne potwierdzenia</h4><p class="at-sub mb-0">Klienci potwierdzeni na tablecie, ale bez pojazdu w załadunku dnia.</p></div>
        <div class="card-body pt-0"><div class="table-responsive"><table class="table table-sm align-middle mb-0">
            <thead><tr><th>Klient</th><th class="text-end">Palety plan</th><th>Status</th><th>Odbiorca / uwagi</th><th class="text-end">Dostarczone</th><th class="text-end">Zwrócone EUR</th><th>Podpis, zdjęcie</th><th></th></tr></thead>
            <tbody>{% for r in other %}{{ _self.stopRow(r, root) }}{% endfor %}</tbody>
        </table></div></div>
    </div>
    {% endif %}
</section>
{% endblock %}
