{% extends "layouts/base.twig" %}

{% block title %}Pakowanie {{ date|date('d.m.Y') }}{% endblock %}

{% block content %}
<section class="section lg-board" data-board="packing">
    {% include 'logistics/_board.twig' with {board: 'packing'} %}
    <div id="lgBoard" data-board="packing" data-date="{{ date }}" aria-live="polite"><p class="text-muted">Wczytywanie…</p></div>
    <script type="application/json" id="lgState">{{ state|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>
</section>
{% endblock %}

{% block scripts %}
{% include 'page_components/ajax_helpers.twig' %}
<script src="{{ root }}/assets/js/logistics/board.js?v={{ asset_v() }}"></script>
{% endblock %}
