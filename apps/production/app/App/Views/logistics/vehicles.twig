{% extends "layouts/base.twig" %}

{% block title %}Pojazdy i pojemność{% endblock %}

{% block page_heading %}
    <div class="page-heading at-profit-head">
        <div class="page-title">
            <h3>Pojazdy i pojemność</h3>
            <p class="text-subtitle text-muted">Miejsca paletowe, ładowność i godzina wyjazdu pojazdów przewoźników</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-primary" href="{{ root }}/logistics"><i class="bi bi-stack"></i> Załadunek dnia</a>
            <a class="btn btn-outline-primary" href="{{ root }}/logistics/tours"><i class="bi bi-signpost-split"></i> Trasy</a>
        </div>
    </div>
{% endblock %}

{% block content %}
<section class="section at-logi">
    <div class="card">
        <div class="card-header"><h4 class="card-title mb-0">Dodaj pojazd</h4></div>
        <div class="card-body pt-0">
            <form id="addVehicle" class="at-logi-add">
                <label>Przewoźnik
                    <select class="form-select" name="carrier_id" required>
                        <option value="">— wybierz —</option>
                        {% for c in carriers %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}
                    </select>
                </label>
                <label>Nr rejestracyjny<input class="form-control" name="regis_num" maxlength="60" required placeholder="DX 02760"></label>
                <label>Miejsca paletowe<input class="form-control" name="pallet_places" inputmode="numeric" value="{{ default_places }}" required></label>
                <label>Ładowność (kg)<input class="form-control" name="max_load_kg" inputmode="numeric" placeholder="np. 24000" data-nullable></label>
                <label>Wyjazd<input class="form-control" type="time" name="departure_time" placeholder="{{ default_departure }}" data-nullable></label>
                <label>Kierowca<input class="form-control" name="driver_name" placeholder="Imię"></label>
                <label>&nbsp;<input class="form-control" name="driver_surname" placeholder="Nazwisko" aria-label="Nazwisko kierowcy"></label>
                <label>Telefon<input class="form-control" name="driver_phone" inputmode="tel"></label>
                <div class="at-logi-add-actions"><button class="btn btn-primary"><i class="bi bi-plus"></i> Dodaj pojazd</button></div>
            </form>
            <p class="at-profit-note">Pojazd trafia do przewoźnika w ERP (Wysyłka → Przewoźnicy), z kierowcą jak w CMR.</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h4 class="card-title mb-0">Pojazdy</h4></div>
        <div class="card-body pt-0">
            <div class="table-responsive">
                <table class="table mb-0 at-logi-vehicles">
                    <thead><tr><th>Pojazd</th><th>Miejsca paletowe</th><th>Ładowność (kg)</th><th>Wyjazd</th><th class="text-center">W użyciu</th><th></th></tr></thead>
                    <tbody>
                    {% for v in vehicles %}
                        <tr data-vehicle="{{ v.id }}" class="{{ v.carrier_active ? '' : 'at-staff-inactive' }}">
                            <td><strong>{{ v.regis_num ?: '—' }}</strong><div class="at-sub">{{ v.carrier }}{{ v.driver ? ' · ' ~ v.driver : '' }}{{ v.carrier_active ? '' : ' · przewoźnik nieaktywny' }}</div>
                                <div class="at-sub">{% if v.tours %}<i class="bi bi-signpost-split"></i> {{ v.tours|join(', ') }}{% else %}<a href="{{ root }}/logistics/tours">bez trasy</a>{% endif %}</div></td>
                            <td><input class="form-control form-control-sm at-logi-num" name="pallet_places" inputmode="numeric" value="{{ v.pallet_places }}" placeholder="{{ default_places }}" aria-label="Miejsca paletowe {{ v.regis_num }}"></td>
                            <td><input class="form-control form-control-sm at-logi-kg" name="max_load_kg" inputmode="numeric" value="{{ v.max_load_kg }}" placeholder="bez kontroli" aria-label="Ładowność {{ v.regis_num }}"></td>
                            <td><input class="form-control form-control-sm at-logi-time" type="time" name="departure_time" value="{{ v.departure_time }}" aria-label="Wyjazd {{ v.regis_num }}"><div class="at-sub">puste = {{ default_departure }}</div></td>
                            <td class="text-center"><input type="checkbox" class="form-check-input" name="active" {{ v.active ? 'checked' : '' }} aria-label="W użyciu {{ v.regis_num }}"></td>
                            <td><button type="button" class="btn btn-sm {{ v.configured ? 'btn-outline-primary' : 'btn-primary' }}" data-save>{{ v.configured ? 'Zapisz' : 'Ustaw pojemność' }}</button></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <p class="at-profit-note">Miejsca paletowe w paletach EUR (120 × 80). Ładowność pusta = waga nie jest sprawdzana. Godzina wyjazdu ustala koniec załadunku (minus czas załadunku) dla klientów pojazdu.</p>
        </div>
    </div>
</section>
{% endblock %}

{% block scripts %}
{% include 'page_components/ajax_helpers.twig' %}
<script>
(() => {
    at.bindForm(document.getElementById('addVehicle'), '/ajax/logistics/vehicles');
    document.querySelectorAll('tr[data-vehicle]').forEach(row => row.querySelector('[data-save]').addEventListener('click', () => {
        const value = (n) => row.querySelector(`[name=${n}]`);
        at.send(`/ajax/logistics/vehicles/${row.dataset.vehicle}`, 'PUT', {
            pallet_places: value('pallet_places').value.trim() || value('pallet_places').placeholder,
            max_load_kg: value('max_load_kg').value.trim(),
            departure_time: value('departure_time').value,
            active: value('active').checked,
        }).then(res => {
            at.notify(res.ok, res.message || (res.ok ? 'Zapisano' : 'Błąd'));
            if (res.ok) window.setTimeout(() => window.location.reload(), 500);
        });
    }));
})();
</script>
{% endblock %}
