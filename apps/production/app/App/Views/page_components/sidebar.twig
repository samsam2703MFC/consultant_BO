                <li><a href="{{ root }}/workshop/execution#devices" data-where="Tablety › Zarządzanie : tablety, PIN, czas pracy"><i class="bi bi-tablet"></i> Nowy tablet biurowy : rodzaj « Tablet biurowy » (wszystkie działy, bez grupy), kod parowania, strona /office</a></li>
                <li><a href="{{ root }}/workshop/execution#people" data-where="Tablety › Zarządzanie : tablety, PIN, czas pracy"><i class="bi bi-phone"></i> PIN dla pracowników biura (Administracja) : pierwszy skan osobistego kodu QR telefonem prosi o PIN</a></li>
                <li><a href="{{ root }}/other-settings#params" data-where="Ustawienia › Ustawienia › Parametry"><i class="bi bi-qr-code-scan"></i> Ważność osobistego kodu QR tabletu biurowego (parametr kiosk.office_qr_ttl_s, sekundy)</a></li>
                <li><a href="{{ root }}/other-settings#params" data-where="Ustawienia › Ustawienia › Parametry"><i class="bi bi-lock"></i> Ceny surowców tylko przez ofertę, fakturę albo zapytanie ofertowe (parametr prices.manual_edit = 0 : « Nowa cena » znika)</a></li>
                <li><a href="{{ root }}/workshop/traceability" data-where="Produkcja › Produkcja › Partie i identyfikowalność"><i class="bi bi-truck"></i> Dokąd poszła partia : kartony produktu z dnia produkcji → palety → klienci, data dostawy, WZ</a></li>
                <li><a href="{{ root }}/workshop/traceability" data-where="Produkcja › Produkcja › Partie i identyfikowalność"><i class="bi bi-exclamation-octagon"></i> Wycofanie z rynku : numer partii surowca → partie wyrobu → klienci do powiadomienia</a></li>
                <li><a href="{{ root }}/test-products" data-where="Produkt › Produkty › Nowe produkty (etapy i lista)"><i class="bi bi-list-ul"></i> Nowe produkty : przełącznik Etapy / Lista (jedna strona, dwa widoki)</a></li>
            </ul>
        </div>

        <button class="sidebar-toggler btn x"><i data-feather="x"></i></button>
    </div>
</div>

<script>
    // Uprawnienia stanowisk : linki do stron, których użytkownik nie widzi, znikają z railu i wyszukiwarki (serwer i tak
    // odmawia dostępu) ; podmenu i sekcje bez linków znikają ; grupa z zakładkami prowadzi do pierwszej widocznej zakładki.
    (function () {
        var access = {{ rail_access()|json_encode|raw }};
        var prefixes = Object.keys(access);
        if (!prefixes.length) return;
        var base = (document.querySelector('#sidebar .logo a') || {pathname: ''}).pathname.replace(/\/home\/?$/, '');
        // Jak serwer : decyduje najdłuższy pasujący prefiks ; ścieżka spoza katalogu jest widoczna.
        var off = function (path) {
            var p = path.replace(/\/+$/, '') || '/', best = null;
            prefixes.forEach(function (h) { if ((p === h || p.indexOf(h + '/') === 0) && (best === null || h.length > best.length)) best = h; });
            return best !== null && !access[best];
        };
        var rel = function (a) { return a.pathname.indexOf(base) === 0 ? a.pathname.slice(base.length) || '/' : a.pathname; };
        document.querySelectorAll('#sidebar a[href]').forEach(function (a) {
            if (a.getAttribute('href') === '#' || a.closest('.logo')) return;
            if (!off(rel(a))) return;
            var also = (a.dataset.also || '').split(' ').filter(function (u) { return u && !off(u); });
            if (also.length) { a.setAttribute('href', base + also[0]); return; }
            var li = a.closest('li');
            if (li) li.remove();
        });
        document.querySelectorAll('#sidebar .sidebar-item.has-sub').forEach(function (li) {
            if (!li.querySelector('.submenu a[href]')) li.remove();
        });
        document.querySelectorAll('#sidebar .sidebar-title').forEach(function (title) {
            var n = title.nextElementSibling;
            while (n && !n.classList.contains('sidebar-title') && !n.classList.contains('sidebar-item')) n = n.nextElementSibling;
            if (!n || n.classList.contains('sidebar-title')) title.remove();
        });
    })();

    // Pozycja bieżącej strony: podświetlona i rozwinięta (mazer.js szuka .sidebar-item.active).
    (function () {
        var here = location.pathname.replace(/\/+$/, '');
        var best = null, bestLen = -1;
        // Prefiks aplikacji (np. /production) : z linku logo /dashboard.
        var base = (document.querySelector('#sidebar .logo a') || {pathname: ''}).pathname.replace(/\/home\/?$/, '');
        document.querySelectorAll('#sidebar .menu a[href]').forEach(function (a) {
            if (a.getAttribute('href') === '#') return;
            // Grupa z zakładkami (data-also) : pozycja aktywna na każdej stronie grupy.
            var paths = [a.pathname].concat((a.dataset.also || '').split(' ').filter(Boolean).map(function (u) { return base + u; }));
            paths.forEach(function (raw) {
                var p = raw.replace(/\/+$/, '');
                if ((here === p || here.indexOf(p + '/') === 0) && p.length > bestLen) { best = a; bestLen = p.length; }
            });
        });
        if (!best) return;
        var li = best.closest('li');
        li.classList.add('active');
        var sub = li.closest('.submenu');
        if (sub) { sub.classList.add('active'); sub.closest('.sidebar-item').classList.add('active'); }
    })();
</script>
