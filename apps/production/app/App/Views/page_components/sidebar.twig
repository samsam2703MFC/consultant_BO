                                <i class="bi bi-sliders"></i> Pozostałe
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="sidebar-item has-sub">
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-display"></i>
                        <span>Urządzenia</span>
                    </a>
                    <ul class="submenu">
                        <li class="submenu-item">
                            <a href="{{ root }}/devices">
                                <i class="bi bi-list-ul"></i> Przegląd urządzeń
                            </a>
                        </li>
                        <li class="submenu-item">
                            <a href="{{ root }}/devices/new">
                                <i class="bi bi-plus-circle"></i> Dodaj urządzenie
                            </a>
                        </li>
                        <li class="submenu-item">
                            <a href="{{ root }}/devices/logs">
                                <i class="bi bi-journal-text"></i> Logi urządzeń
                            </a>
                        </li>
                    </ul>
                </li>

            </ul>
        </div>

        <button class="sidebar-toggler btn x"><i data-feather="x"></i></button>
    </div>
</div>

<script>
    // Pozycja bieżącej strony: podświetlona i rozwinięta (mazer.js szuka .sidebar-item.active).
    (function () {
        var here = location.pathname.replace(/\/+$/, '');
        var best = null, bestLen = -1;
        document.querySelectorAll('#sidebar .menu a[href]').forEach(function (a) {
            if (a.getAttribute('href') === '#') return;
            var p = a.pathname.replace(/\/+$/, '');
            if ((here === p || here.indexOf(p + '/') === 0) && p.length > bestLen) { best = a; bestLen = p.length; }
        });
        if (!best) return;
        var li = best.closest('li');
        li.classList.add('active');
        var sub = li.closest('.submenu');
        if (sub) { sub.classList.add('active'); sub.closest('.sidebar-item').classList.add('active'); }
    })();
</script>
