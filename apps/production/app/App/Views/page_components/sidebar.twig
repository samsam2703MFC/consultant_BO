<script>
    // Pozycja bieżącej strony: podświetlona i rozwinięta (mazer.js szuka .sidebar-item.active).
    (function () {
        var here = location.pathname.replace(/\/+$/, '');
        var best = null, bestLen = -1;
        // Prefiks aplikacji (np. /production) : z linku logo /dashboard.
        var base = (document.querySelector('#sidebar .logo a') || {pathname: ''}).pathname.replace(/\/dashboard\/?$/, '');
        document.querySelectorAll('#sidebar .menu a[href]').forEach(function (a) {
            if (a.getAttribute('href') === '#') return;
            // Grupa z zakładkami (data-also) : pozycja aktywna na każdej stronie grupy.
            var paths = [a.pathname].concat((a.dataset.also || '').split(' ').filter(Boolean).map(function (u) { return base + u; }));
            paths.forEach(function (raw) {
                var p = raw.replace(/\/+$/, '');
                if ((here === p || here.indexOf(p + '/') === 0) && p.length > bestLen) { best = a; bestLen = p.length; }
            });
        });
        if (!best) return;
        var li = best.closest('li');
        li.classList.add('active');
        var sub = li.closest('.submenu');
        if (sub) { sub.classList.add('active'); sub.closest('.sidebar-item').classList.add('active'); }
    })();
</script>
