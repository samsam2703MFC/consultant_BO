{% extends "layouts/base.twig" %}

{% block title %}{{ translations.product_margin_title|default('Marża obowiązująca produktu') }}{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <div class="page-title">
            <div class="row">
                <div class="col-12 col-md-6 order-md-1 order-last">
                    <h3>{{ translations.product_margin_title|default('Marża obowiązująca produktu') }}</h3>
                    <p class="text-subtitle text-muted">{{ translations.product_margin_subtitle|default('Kalkulacja marży na podstawie uśrednionych kosztów działu') }}</p>
                </div>
                <div class="col-12 col-md-6 order-md-2 order-first">
                    <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="{{ root }}/dashboard">{{ translations.dashboard|default('Dashboard') }}</a></li>
                            <li class="breadcrumb-item active" aria-current="page">{{ translations.product_margin_title|default('Marża produktu') }}</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
<section class="section">

    {# ── FORMULARZ WYBORU ──────────────────────────────────────────────────── #}
    <div class="card">
        <div class="card-body">
            <form method="get" action="{{ root }}/finances/product-margin" id="marginForm">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" for="product_id_select">{{ translations.product_margin_product|default('Produkt') }}</label>
                        <select class="form-select choices" name="product_id" id="product_id_select" required>
                            <option value="">{{ translations.product_margin_select_prompt|default('Wybierz produkt...') }}</option>
                            {% for product in products %}
                                <option value="{{ product.id }}"
                                    {% if product.id == selected_product_id %}selected{% endif %}>
                                    {{ product.name }}{% if product.section_name %} [{{ product.section_name }}]{% endif %}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label fw-semibold" for="months_select">{{ translations.product_margin_months_label|default('Liczba miesięcy') }}</label>
                        <select class="form-select" name="months" id="months_select">
                            {% for m in [1, 3, 6, 12, 24] %}
                                {% if m <= available_months_count or m == 12 %}
                                <option value="{{ m }}" {% if m == selected_months %}selected{% endif %}>
                                    {{ m }} {{ translations.product_margin_months_suffix|default('mies.') }}
                                    {% if m == 12 and available_months_count >= 12 %} — pełny rok{% endif %}
                                    {% if available_months_count < m %} (dostępne: {{ available_months_count }}){% endif %}
                                </option>
                                {% endif %}
                            {% endfor %}
                        </select>
                        <div class="form-text">
                            <i class="bi bi-lock-fill text-success"></i>
                            {{ translations.product_margin_locked_basis|default('Podstawa: zamknięte miesiące') }}
                            ({{ available_months_count }} {{ translations.product_margin_months_suffix|default('mies.') }})
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-calculator"></i>
                            {{ translations.product_margin_calculate|default('Oblicz marżę') }}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {% if analysis %}
        {% set kpi = analysis.kpi %}
        {% set sim = analysis.simulation_base %}

        {# ── BANER PODSTAWY OBLICZENIA ─────────────────────────────────────── #}
        {% if analysis.data_basis is defined %}
            {% set db = analysis.data_basis %}
            <div class="alert {{ db.all_locked ? 'alert-success' : 'alert-warning' }} mt-3 mb-0 py-2 d-flex align-items-center gap-2">
                {% if db.all_locked %}
                    <i class="bi bi-lock-fill fs-5"></i>
                    <div>
                        <strong>{{ translations.product_margin_basis_locked|default('Podstawa: zamknięte miesiące') }}</strong>
                        — {{ db.label }}
                    </div>
                {% else %}
                    <i class="bi bi-unlock-fill fs-5 text-warning"></i>
                    <div>
                        <strong>{{ translations.product_margin_basis_open|default('Uwaga: podstawa zawiera miesiące niezamknięte') }}</strong>
                        — {{ db.label }}
                        <br><small>{{ translations.product_margin_basis_open_hint|default('Zamknij miesiące w Kalkulatorze kosztów, aby uzyskać zatwierdzone dane.') }}</small>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {# ── OSTRZEŻENIA ───────────────────────────────────────────────────── #}
        {% if analysis.warnings is not empty %}
            <div class="alert alert-warning mt-2">
                <strong><i class="bi bi-exclamation-triangle"></i> {{ translations.product_margin_warnings|default('Uwagi') }}:</strong>
                <ul class="mb-0 mt-1">
                    {% for w in analysis.warnings %}
                        <li>{{ w }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {# ── INFORMACJA O PRODUKCIE ────────────────────────────────────────── #}
        <div class="alert alert-info mt-2 mb-0 py-2">
            <strong>{{ analysis.product.name }}</strong>
            &nbsp;|&nbsp; {{ translations.product_margin_section|default('Dział') }}: <strong>{{ analysis.product.section_name|default('–') }}</strong>
            &nbsp;|&nbsp; {{ translations.product_margin_months_used|default('Podstawa') }}: <strong>{{ analysis.months_used }} {{ translations.product_margin_months_suffix|default('mies.') }}</strong>
            {% if analysis.data_basis is defined and analysis.data_basis.from %}
                &nbsp;|&nbsp; <strong>{{ analysis.data_basis.from }} – {{ analysis.data_basis.to }}</strong>
            {% endif %}
            &nbsp;|&nbsp; {{ translations.product_margin_exchange_rate|default('Kurs EUR') }}: <strong>{{ kpi.exchange_rate|number_format(4, '.', ' ') }} PLN</strong>
        </div>

        {# ── MODAL: STRUKTURA FOODCOST ────────────────────────────────────── #}
        <div class="modal fade" id="foodcostModal" tabindex="-1" aria-labelledby="foodcostModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header" style="background:rgba(13,202,240,.08);">
                        <h5 class="modal-title" id="foodcostModalLabel">
                            <i class="bi bi-layers me-2 text-info"></i>
                            Struktura foodcost &mdash; <span id="fcModalProductName">{{ analysis.product.name }}</span>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-0" id="foodcostModalBody">
                        <div class="text-center py-5 text-muted" id="fcLoadingSpinner">
                            <div class="spinner-border spinner-border-sm me-2"></div>
                            Ładowanie struktury receptury…
                        </div>
                    </div>
                    <div class="modal-footer">
                        <span class="text-muted small me-auto" id="fcModalTotal"></span>
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Zamknij</button>
                    </div>
                </div>
            </div>
        </div>





        {# ── SYMULACJA – SUWAKI ─────────────────────────────────────────────── #}
        <div class="card mt-3">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0">
                    <i class="bi bi-sliders"></i> {{ translations.product_margin_simulation|default('Symulacja zmian') }}
                    <span class="badge bg-light text-muted border ms-2 small fw-normal" id="simActiveLabel" style="display:none;">
                        <i class="bi bi-pencil-fill text-warning me-1"></i>{{ translations.product_margin_sim_active|default('aktywna') }}
                    </span>
                </h5>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    {# ── LIVE PRZELICZNIK KURSU ── #}
                    <div class="d-flex align-items-center gap-1">
                        <label class="form-label mb-0 small fw-semibold text-nowrap" for="overviewLiveRate">
                            <i class="bi bi-currency-exchange text-warning me-1"></i>1 EUR =
                        </label>
                        <input type="number" class="form-control form-control-sm" id="overviewLiveRate"
                               style="width:90px;" min="1" step="0.0001"
                               value="{{ kpi.exchange_rate|number_format(4, '.', '') }}"
                               oninput="recalcOverviewEur()"
                               title="Zmień kurs aby zobaczyć koszty w EUR">
                        <span class="small text-muted">PLN</span>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" id="toggleSliders"
                            onclick="toggleSlidersPanel()"
                            title="{{ translations.product_margin_show_sliders|default('Pokaż/ukryj suwaki') }}">
                        <i class="bi bi-chevron-down me-1" id="toggleSlidersIcon"></i>
                        <span id="toggleSlidersLabel">{{ translations.product_margin_show_sliders|default('Dostosuj symulację') }}</span>
                    </button>
                </div>
            </div>

            {# Panel suwaków – domyślnie ukryty #}
            <div id="slidersPanel" style="display:none;">
                <div class="card-body pb-0">
                    <div class="row g-4">

                    {# Suwak: wolumen sprzedaży #}
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" for="sl_volume">
                            <i class="bi bi-boxes text-success"></i>
                            {{ translations.product_margin_volume_slider|default('Zmiana wolumenu sprzedaży') }}:
                            <span class="badge bg-success ms-1" id="lbl_volume">+0%</span>
                        </label>
                        <input type="range" class="form-range sim-slider" id="sl_volume"
                               min="-50" max="100" step="5" value="0" data-target="volume">
                        <div class="d-flex justify-content-between text-muted small">
                            <span>-50%</span><span>0%</span><span>+100%</span>
                        </div>
                        <div class="text-muted small mt-1">{{ translations.product_margin_volume_hint|default('Wzrost wolumenu obniża koszt jednostkowy (rozkład stałych kosztów)') }}</div>
                    </div>

                    {# Suwak: koszty mediów #}
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" for="sl_media">
                            <i class="bi bi-lightning text-warning"></i>
                            {{ translations.product_margin_media_slider|default('Zmiana cen mediów') }}:
                            <span class="badge bg-warning text-dark ms-1" id="lbl_media">+0%</span>
                        </label>
                        <input type="range" class="form-range sim-slider" id="sl_media"
                               min="-30" max="100" step="5" value="0" data-target="media">
                        <div class="d-flex justify-content-between text-muted small">
                            <span>-30%</span><span>0%</span><span>+100%</span>
                        </div>
                    </div>

                    {# Suwak: wynagrodzenia #}
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" for="sl_labor">
                            <i class="bi bi-people text-primary"></i>
                            {{ translations.product_margin_labor_slider|default('Zmiana kosztów wynagrodzeń') }}:
                            <span class="badge bg-primary ms-1" id="lbl_labor">+0%</span>
                        </label>
                        <input type="range" class="form-range sim-slider" id="sl_labor"
                               min="-20" max="80" step="5" value="0" data-target="labor">
                        <div class="d-flex justify-content-between text-muted small">
                            <span>-20%</span><span>0%</span><span>+80%</span>
                        </div>
                    </div>

                    {# Suwak: amortyzacja / inne koszty #}
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" for="sl_other">
                            <i class="bi bi-tools text-secondary"></i>
                            {{ translations.product_margin_other_slider|default('Zmiana amortyzacji / kosztów stałych') }}:
                            <span class="badge bg-secondary ms-1" id="lbl_other">+0%</span>
                        </label>
                        <input type="range" class="form-range sim-slider" id="sl_other"
                               min="-20" max="80" step="5" value="0" data-target="other">
                        <div class="d-flex justify-content-between text-muted small">
                            <span>-20%</span><span>0%</span><span>+80%</span>
                        </div>
                    </div>

                    {# Suwak: koszty logistyki #}
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" for="sl_logistics">
                            <i class="bi bi-truck text-dark"></i>
                            {{ translations.product_margin_logistics_slider|default('Zmiana kosztów logistycznych') }}:
                            <span class="badge bg-dark ms-1" id="lbl_logistics">+0%</span>
                        </label>
                        <input type="range" class="form-range sim-slider" id="sl_logistics"
                               min="-50" max="100" step="5" value="0" data-target="logistics">
                        <div class="d-flex justify-content-between text-muted small">
                            <span>-50%</span><span>0%</span><span>+100%</span>
                        </div>
                        <div class="text-muted small mt-1">{{ translations.product_margin_logistics_hint_slider|default('Koszt zakładowy – zmiana cen paliwa, frachtu, usług kurierskich itp.') }}</div>
                    </div>
                </div>{# /row g-4 #}

                <div class="d-flex justify-content-end mt-3">
                    <button class="btn btn-sm btn-outline-secondary" id="resetSimulation">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>{{ translations.product_margin_reset|default('Resetuj suwaki') }}
                    </button>
                </div>
            </div>{# /card-body #}
            </div>{# /slidersPanel #}

            {# Tabela porównawcza baza vs symulacja – zawsze widoczna #}
            <div class="card-body pt-0">
                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-sm align-middle">
                        <thead class="table-light">
                        <tr>
                            <th>{{ translations.product_margin_cost_item|default('Składnik') }}</th>
                            <th class="text-end">{{ translations.product_margin_base|default('Baza / karton') }}</th>
                            <th class="text-end">{{ translations.product_margin_simulated|default('Symulacja / karton') }}</th>
                            <th class="text-end">{{ translations.product_margin_diff|default('Różnica') }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr>
                            <td>
                                <span class="badge bg-info me-1">&nbsp;</span>
                                <a href="#" class="text-decoration-none text-reset"
                                   onclick="openFoodcostModal({{ analysis.product.id }}); return false;"
                                   title="Kliknij aby zobaczyć strukturę foodcost">
                                    {{ translations.product_margin_foodcost|default('Foodcost') }}
                                    <i class="bi bi-info-circle text-info ms-1" style="font-size:.8rem;"></i>
                                </a>
                            </td>
                            <td class="text-end">
                                <span id="eur_base_foodcost" class="fw-semibold">—</span> €
                                <br><small class="text-muted">{{ kpi.foodcost|number_format(2, '.', ' ') }} PLN</small>
                            </td>
                            <td class="text-end">
                                <span id="eur_sim_foodcost" class="fw-semibold">—</span> €
                                <br><small class="text-muted" id="sim_foodcost">{{ kpi.foodcost|number_format(2, '.', ' ') }}</small> <small class="text-muted">PLN</small>
                            </td>
                            <td class="text-end" id="sim_diff_foodcost">0,00</td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-warning me-1">&nbsp;</span>{{ translations.product_margin_media_cost|default('Media') }}</td>
                            <td class="text-end">
                                <span id="eur_base_media" class="fw-semibold">—</span> €
                                <br><small class="text-muted">{{ kpi.avg_media_per_carton|number_format(2, '.', ' ') }} PLN</small>
                            </td>
                            <td class="text-end">
                                <span id="eur_sim_media" class="fw-semibold">—</span> €
                                <br><small class="text-muted" id="sim_media">{{ kpi.avg_media_per_carton|number_format(2, '.', ' ') }}</small> <small class="text-muted">PLN</small>
                            </td>
                            <td class="text-end" id="sim_diff_media">0,00</td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-primary me-1">&nbsp;</span>{{ translations.product_margin_labor_cost|default('Wynagrodzenia') }}</td>
                            <td class="text-end">
                                <span id="eur_base_labor" class="fw-semibold">—</span> €
                                <br><small class="text-muted">{{ kpi.avg_labor_per_carton|number_format(2, '.', ' ') }} PLN</small>
                            </td>
                            <td class="text-end">
                                <span id="eur_sim_labor" class="fw-semibold">—</span> €
                                <br><small class="text-muted" id="sim_labor">{{ kpi.avg_labor_per_carton|number_format(2, '.', ' ') }}</small> <small class="text-muted">PLN</small>
                            </td>
                            <td class="text-end" id="sim_diff_labor">0,00</td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-secondary me-1">&nbsp;</span>{{ translations.product_margin_other_cost|default('Koszty stałe') }}</td>
                            <td class="text-end">
                                <span id="eur_base_other" class="fw-semibold">—</span> €
                                <br><small class="text-muted">{{ kpi.avg_other_per_carton|number_format(2, '.', ' ') }} PLN</small>
                            </td>
                            <td class="text-end">
                                <span id="eur_sim_other" class="fw-semibold">—</span> €
                                <br><small class="text-muted" id="sim_other">{{ kpi.avg_other_per_carton|number_format(2, '.', ' ') }}</small> <small class="text-muted">PLN</small>
                            </td>
                            <td class="text-end" id="sim_diff_other">0,00</td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-dark me-1">&nbsp;</span>{{ translations.product_margin_logistics_cost|default('Logistyka') }}</td>
                            <td class="text-end">
                                <span id="eur_base_logistics" class="fw-semibold">—</span> €
                                <br><small class="text-muted">{{ kpi.avg_logistics_per_carton|number_format(2, '.', ' ') }} PLN</small>
                            </td>
                            <td class="text-end">
                                <span id="eur_sim_logistics" class="fw-semibold">—</span> €
                                <br><small class="text-muted" id="sim_logistics">{{ kpi.avg_logistics_per_carton|number_format(2, '.', ' ') }}</small> <small class="text-muted">PLN</small>
                            </td>
                            <td class="text-end" id="sim_diff_logistics">0,00</td>
                        </tr>
                        <tr class="table-danger fw-semibold">
                            <td>{{ translations.product_margin_total_cost|default('Łączny koszt wytworzenia') }}</td>
                            <td class="text-end">
                                <span id="eur_base_total" class="fw-semibold">—</span> €
                                <br><small class="text-muted fw-normal">{{ kpi.total_cost_per_carton|number_format(2, '.', ' ') }} PLN</small>
                            </td>
                            <td class="text-end">
                                <span id="eur_sim_total" class="fw-semibold">—</span> €
                                <br><small class="text-muted fw-normal" id="sim_total_cost">{{ kpi.total_cost_per_carton|number_format(2, '.', ' ') }}</small> <small class="text-muted fw-normal">PLN</small>
                            </td>
                            <td class="text-end" id="sim_diff_total">0,00</td>
                        </tr>
                        <tr class="table-light">
                            <td>{{ translations.product_margin_sale_price|default('Cena sprzedaży') }}</td>
                            <td class="text-end">
                                <span class="fw-semibold">{{ kpi.sale_price_foreign|number_format(2, '.', ' ') }}</span> {{ kpi.sale_currency|default('EUR') }}
                                <br><small class="text-muted">{{ kpi.sale_price_pln|number_format(2, '.', ' ') }} PLN</small>
                            </td>
                            <td class="text-end">
                                <span class="fw-semibold">{{ kpi.sale_price_foreign|number_format(2, '.', ' ') }}</span> {{ kpi.sale_currency|default('EUR') }}
                                <br><small class="text-muted">{{ kpi.sale_price_pln|number_format(2, '.', ' ') }} PLN</small>
                            </td>
                            <td class="text-end">–</td>
                        </tr>
                        <tr class="table-success fw-bold">
                            <td>{{ translations.product_margin_margin_pct|default('Marża %') }}</td>
                            <td class="text-end">{{ kpi.margin_percent|number_format(1, '.', ' ') }}%</td>
                            <td class="text-end" id="sim_margin_pct">{{ kpi.margin_percent|number_format(1, '.', ' ') }}%</td>
                            <td class="text-end" id="sim_diff_margin_pct">0,0 pp</td>
                        </tr>
                        </tbody>
                    </table>
                </div>{# /table-responsive #}
            </div>{# /card-body tabela #}
        </div>{# /card symulacja #}

        {# ── PASEK STRUKTURY KOSZTÓW ────────────────────────────────────────── #}
        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <h5 class="mb-0">{{ translations.product_margin_structure|default('Struktura ceny (baza)') }}</h5>
                    <span id="progressBarNote"
                          class="badge bg-warning text-dark small fw-normal"
                          {% if kpi.sale_price_pln > 0 %}style="display:none"{% endif %}
                          title="{{ translations.product_margin_no_price_hint|default('Brak ceny sprzedaży – pasek pokazuje udziały w koszcie wytworzenia') }}">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        {{ translations.product_margin_no_price_bar|default('% kosztu wytworzenia') }}
                    </span>
                </div>
                <div class="progress mb-2" style="height: 30px;" id="costProgressBar">
                    {% set bd = analysis.breakdown %}
                    <div class="progress-bar bg-info" style="width:{{ bd.foodcost|number_format(2,'.','')|replace({',':''}) }}%"
                         title="{{ translations.product_margin_foodcost|default('Foodcost') }}: {{ bd.foodcost|number_format(1) }}%">
                        {% if bd.foodcost > 5 %}{{ bd.foodcost|number_format(1) }}%{% endif %}
                    </div>
                    <div class="progress-bar bg-warning" style="width:{{ bd.media|number_format(2,'.','')|replace({',':''}) }}%"
                         title="{{ translations.product_margin_media_cost|default('Media') }}: {{ bd.media|number_format(1) }}%">
                        {% if bd.media > 5 %}{{ bd.media|number_format(1) }}%{% endif %}
                    </div>
                    <div class="progress-bar bg-primary" style="width:{{ bd.labor|number_format(2,'.','')|replace({',':''}) }}%"
                         title="{{ translations.product_margin_labor_cost|default('Wynagrodzenia') }}: {{ bd.labor|number_format(1) }}%">
                        {% if bd.labor > 5 %}{{ bd.labor|number_format(1) }}%{% endif %}
                    </div>
                    <div class="progress-bar bg-secondary" style="width:{{ bd.other|number_format(2,'.','')|replace({',':''}) }}%"
                         title="{{ translations.product_margin_other_cost|default('Amortyzacja') }}: {{ bd.other|number_format(1) }}%">
                        {% if bd.other > 3 %}{{ bd.other|number_format(1) }}%{% endif %}
                    </div>
                    <div class="progress-bar bg-dark" style="width:{{ bd.logistics|number_format(2,'.','')|replace({',':''}) }}%"
                         title="{{ translations.product_margin_logistics_cost|default('Logistyka') }}: {{ bd.logistics|number_format(1) }}%">
                        {% if bd.logistics > 3 %}{{ bd.logistics|number_format(1) }}%{% endif %}
                    </div>
                    <div class="progress-bar bg-success" style="width:{{ bd.margin|number_format(2,'.','')|replace({',':''}) }}%"
                         title="{{ translations.product_margin_margin_pct|default('Marża') }}: {{ bd.margin|number_format(1) }}%">
                        {% if bd.margin > 3 %}{{ bd.margin|number_format(1) }}%{% endif %}
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-3 mt-2 small">
                    <div><span class="badge bg-info">&nbsp;&nbsp;</span> {{ translations.product_margin_foodcost|default('Foodcost') }} ({{ bd.foodcost|number_format(1) }}%)</div>
                    <div><span class="badge bg-warning">&nbsp;&nbsp;</span> {{ translations.product_margin_media_cost|default('Media') }} ({{ bd.media|number_format(1) }}%)</div>
                    <div><span class="badge bg-primary">&nbsp;&nbsp;</span> {{ translations.product_margin_labor_cost|default('Wynagrodzenia') }} ({{ bd.labor|number_format(1) }}%)</div>
                    <div><span class="badge bg-secondary">&nbsp;&nbsp;</span> {{ translations.product_margin_other_cost|default('Amortyzacja') }} ({{ bd.other|number_format(1) }}%)</div>
                    <div><span class="badge bg-dark">&nbsp;&nbsp;</span> {{ translations.product_margin_logistics_cost|default('Logistyka') }} ({{ bd.logistics|number_format(1) }}%)</div>
                    <div><span class="badge bg-success">&nbsp;&nbsp;</span> {{ translations.product_margin_margin_pct|default('Marża') }} ({{ bd.margin|number_format(1) }}%)</div>
                </div>
            </div>
        </div>

        {# ── KALKULATOR CENY SPRZEDAŻY ────────────────────────────────────── #}
        <div class="card mt-3 border-2 border-success" id="priceCalcCard">
            <div class="card-header bg-success bg-opacity-10 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-success">
                    <i class="bi bi-calculator-fill me-2"></i>
                    {{ translations.product_margin_price_calc_title|default('Kalkulator ceny sprzedaży') }}
                </h5>
                <span class="badge bg-success bg-opacity-75 small">
                    {{ translations.product_margin_price_calc_hint|default('Dane nie są zapisywane') }}
                </span>
            </div>
            <div class="card-body">

                <p class="text-muted small mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    {{ translations.product_margin_price_calc_desc|default('Kalkulator bazuje na kosztach z aktualnej symulacji (uwzględnia ustawione suwaki). Wpisz cenę lub docelową marżę — wyniki aktualizują się na bieżąco.') }}
                </p>

                <div class="row g-4">

                    {# ── TRYB 1: podaj cenę → oblicz marżę ── #}
                    <div class="col-12 col-lg-6">
                        <div class="card h-100 border-success border-opacity-25">
                            <div class="card-body">
                                <h6 class="fw-semibold mb-3">
                                    <i class="bi bi-tag-fill text-success me-1"></i>
                                    {{ translations.product_margin_price_to_margin|default('Podaj cenę → sprawdź marżę') }}
                                </h6>

                                <div class="row g-2 align-items-end mb-3">
                                    <div class="col-8">
                                        <label class="form-label small fw-semibold" for="pc_price_eur">
                                            {{ translations.product_margin_new_price_eur|default('Cena sprzedaży (EUR / karton)') }}
                                        </label>
                                        <div class="input-group">
                                            <input type="number" class="form-control form-control-lg fw-bold"
                                                   id="pc_price_eur"
                                                   min="0" step="0.01"
                                                   placeholder="{{ kpi.sale_price_foreign|number_format(2, '.', '') }}"
                                                   oninput="recalcPriceCalc()">
                                            <span class="input-group-text">EUR</span>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label small text-muted">
                                            {{ translations.product_margin_exchange_rate|default('Kurs EUR') }}
                                        </label>
                                        <div class="input-group input-group-sm">
                                            <input type="number" class="form-control form-control-sm"
                                                   id="pc_exchange_rate"
                                                   min="0.01" step="0.0001"
                                                   value="{{ kpi.exchange_rate|number_format(4, '.', '') }}"
                                                   oninput="recalcPriceCalc()">
                                            <span class="input-group-text small">PLN</span>
                                        </div>
                                    </div>
                                </div>

                                {# Wynik trybu 1 #}
                                <div class="p-3 rounded-3 text-center" id="pc_result_box" style="background:#f8f9fa;">
                                    <div class="text-muted small mb-1" id="pc_price_pln_label">= — PLN</div>
                                    <div class="display-6 fw-bold" id="pc_margin_result" style="font-size:2.8rem;">—</div>
                                    <div class="small mt-1" id="pc_margin_amount_label">marża kwotowa: —</div>
                                    {% if analysis.product.ppc is defined and analysis.product.ppc > 1 %}
                                    <div class="border-top mt-2 pt-2">
                                        <div class="text-muted small">{{ analysis.product.ppc }} szt. w kartonie</div>
                                        <div class="small fw-semibold mt-1">
                                            cena / szt: <span id="pc_price_per_unit">—</span>
                                        </div>
                                        <div class="small text-muted">
                                            marża kwotowa / szt: <span id="pc_margin_per_unit">—</span>
                                        </div>
                                    </div>
                                    {% endif %}
                                    <div class="small text-muted mt-1" id="pc_cost_reminder"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# ── TRYB 2: podaj marżę → oblicz wymaganą cenę ── #}
                    <div class="col-12 col-lg-6">
                        <div class="card h-100 border-primary border-opacity-25">
                            <div class="card-body">
                                <h6 class="fw-semibold mb-3">
                                    <i class="bi bi-percent text-primary me-1"></i>
                                    {{ translations.product_margin_margin_to_price|default('Podaj marżę → wymagana cena') }}
                                </h6>

                                <div class="row g-2 align-items-end mb-3">
                                    <div class="col-6">
                                        <label class="form-label small fw-semibold" for="pc_target_margin">
                                            {{ translations.product_margin_target_margin_input|default('Docelowa marża (%)') }}
                                        </label>
                                        <div class="input-group">
                                            <input type="number" class="form-control form-control-lg fw-bold"
                                                   id="pc_target_margin"
                                                   min="0" max="99" step="0.5"
                                                   placeholder="20"
                                                   oninput="recalcPriceCalc()">
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted">
                                            {{ translations.product_margin_exchange_rate|default('Kurs EUR') }}
                                        </label>
                                        <div class="input-group input-group-sm">
                                            <input type="number" class="form-control form-control-sm"
                                                   id="pc_exchange_rate2"
                                                   min="0.01" step="0.0001"
                                                   value="{{ kpi.exchange_rate|number_format(4, '.', '') }}"
                                                   oninput="recalcPriceCalc()">
                                            <span class="input-group-text small">PLN</span>
                                        </div>
                                    </div>
                                </div>

                                {# Wynik trybu 2 #}
                                <div class="p-3 rounded-3 text-center" id="pc_rev_result_box" style="background:#f8f9fa;">
                                    <div class="text-muted small mb-1">{{ translations.product_margin_required_price|default('Wymagana cena sprzedaży') }}</div>
                                    <div class="display-6 fw-bold text-primary" id="pc_rev_price_eur" style="font-size:2.8rem;">—</div>
                                    <div class="small text-muted mt-1" id="pc_rev_price_pln">= — PLN</div>
                                    <div class="small mt-1" id="pc_rev_margin_amount">marża kwotowa: —</div>
                                    {% if analysis.product.ppc is defined and analysis.product.ppc > 1 %}
                                    <div class="border-top mt-2 pt-2">
                                        <div class="text-muted small">{{ analysis.product.ppc }} szt. w kartonie</div>
                                        <div class="small fw-semibold mt-1">
                                            cena / szt: <span id="pc_rev_price_per_unit">—</span>
                                        </div>
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                {# ── Tabela porównawcza: aktualna vs nowa cena ── #}
                <div class="mt-4" id="pc_compare_section" style="display:none;">
                    <h6 class="fw-semibold mb-2">
                        <i class="bi bi-arrow-left-right me-1"></i>
                        {{ translations.product_margin_price_comparison|default('Porównanie: aktualna vs nowa cena') }}
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead class="table-light">
                            <tr>
                                <th></th>
                                <th class="text-end">{{ translations.product_margin_current_price|default('Aktualna cena') }}</th>
                                <th class="text-end text-success">{{ translations.product_margin_new_price|default('Nowa cena') }}</th>
                                <th class="text-end">{{ translations.product_margin_diff|default('Różnica') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td class="text-muted small">{{ translations.product_margin_sale_price|default('Cena (EUR)') }}</td>
                                <td class="text-end">{{ kpi.sale_price_foreign|number_format(2, '.', ' ') }} EUR</td>
                                <td class="text-end fw-semibold text-success" id="pc_cmp_new_eur">—</td>
                                <td class="text-end" id="pc_cmp_diff_eur">—</td>
                            </tr>
                            <tr>
                                <td class="text-muted small">{{ translations.product_margin_sale_price|default('Cena (PLN)') }}</td>
                                <td class="text-end">{{ kpi.sale_price_pln|number_format(2, '.', ' ') }} PLN</td>
                                <td class="text-end fw-semibold text-success" id="pc_cmp_new_pln">—</td>
                                <td class="text-end" id="pc_cmp_diff_pln">—</td>
                            </tr>
                            {% if analysis.product.ppc is defined and analysis.product.ppc > 1 %}
                            <tr class="table-light">
                                <td class="text-muted small">
                                    <i class="bi bi-box2 me-1"></i>Cena / szt (EUR)
                                    <span class="text-muted" style="font-size:.7rem;">(÷ {{ analysis.product.ppc }} szt.)</span>
                                </td>
                                <td class="text-end">
                                    {% if kpi.sale_price_foreign > 0 %}
                                        {{ (kpi.sale_price_foreign / analysis.product.ppc)|number_format(3, '.', ' ') }} EUR
                                    {% else %}<span class="text-muted">—</span>{% endif %}
                                </td>
                                <td class="text-end fw-semibold text-success" id="pc_cmp_new_eur_unit">—</td>
                                <td class="text-end" id="pc_cmp_diff_eur_unit">—</td>
                            </tr>
                            <tr class="table-light">
                                <td class="text-muted small">
                                    <i class="bi bi-box2 me-1"></i>Cena / szt (PLN)
                                    <span class="text-muted" style="font-size:.7rem;">(÷ {{ analysis.product.ppc }} szt.)</span>
                                </td>
                                <td class="text-end">
                                    {% if kpi.sale_price_pln > 0 %}
                                        {{ (kpi.sale_price_pln / analysis.product.ppc)|number_format(3, '.', ' ') }} PLN
                                    {% else %}<span class="text-muted">—</span>{% endif %}
                                </td>
                                <td class="text-end fw-semibold text-success" id="pc_cmp_new_pln_unit">—</td>
                                <td class="text-end" id="pc_cmp_diff_pln_unit">—</td>
                            </tr>
                            {% endif %}
                            <tr>
                                <td class="text-muted small">{{ translations.product_margin_total_cost|default('Koszt wytworzenia') }}</td>
                                <td class="text-end" id="pc_cmp_cost_base">{{ kpi.total_cost_per_carton|number_format(2, '.', ' ') }} PLN</td>
                                <td class="text-end" id="pc_cmp_cost_sim">{{ kpi.total_cost_per_carton|number_format(2, '.', ' ') }} PLN</td>
                                <td class="text-end" id="pc_cmp_diff_cost">—</td>
                            </tr>
                            <tr class="fw-semibold">
                                <td class="text-muted small">{{ translations.product_margin_margin_pct|default('Marża %') }}</td>
                                <td class="text-end">{{ kpi.margin_percent|number_format(1, '.', ' ') }}%</td>
                                <td class="text-end text-success" id="pc_cmp_new_margin">—</td>
                                <td class="text-end" id="pc_cmp_diff_margin">—</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>


