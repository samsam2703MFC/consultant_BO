{# ── JavaScript symulacji ─────────────────────────────────────────────────── #}
{% if analysis and analysis.simulation_base is not empty %}
<script>
(function () {
    'use strict';

    // Dane bazowe z PHP
    const BASE = {{ analysis.simulation_base|json_encode|raw }};
    const SALE_PRICE = BASE.sale_price_pln;

    // Pomocnicze formatowanie liczb PL
    function fmt(n, dec) {
        dec = dec ?? 2;
        return n.toFixed(dec).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
    }

    function pctLabel(val) {
        return (val >= 0 ? '+' : '') + val + '%';
    }

    // Aktualny stan suwaków
    let state = { volume: 0, media: 0, labor: 0, other: 0, logistics: 0 };

    function recalculate() {
        const vf = state.volume / 100; // zmiana wolumenu (+/-)

        // Wzrost wolumenu zmniejsza koszty stałe na karton
        // Wzrost cen mediów/pracy/amortyzacji/logistyki zwiększa je
        const volumeFactor = 1 / (1 + vf);   // przy +100% wolumenu koszt/karton * 0.5

        const simMedia     = BASE.media_per_carton     * (1 + state.media     / 100) * volumeFactor;
        const simLabor     = BASE.labor_per_carton     * (1 + state.labor     / 100) * volumeFactor;
        const simOther     = BASE.other_per_carton     * (1 + state.other     / 100) * volumeFactor;
        const simLogistics = BASE.logistics_per_carton * (1 + state.logistics / 100) * volumeFactor;
        const simFood      = BASE.foodcost; // foodcost nie zmienia się z wolumenem

        const simTotal  = simFood + simMedia + simLabor + simOther + simLogistics;
        const baseCostTotal = BASE.foodcost + BASE.media_per_carton + BASE.labor_per_carton + BASE.other_per_carton + BASE.logistics_per_carton;
        const simMargin  = SALE_PRICE > 0 ? ((SALE_PRICE - simTotal)     / SALE_PRICE) * 100 : 0;
        const baseMargin = SALE_PRICE > 0 ? ((SALE_PRICE - baseCostTotal) / SALE_PRICE) * 100 : 0;

        // Aktualizuj tabelę
        document.getElementById('sim_foodcost').textContent   = fmt(simFood);
        document.getElementById('sim_media').textContent      = fmt(simMedia);
        document.getElementById('sim_labor').textContent      = fmt(simLabor);
        document.getElementById('sim_other').textContent      = fmt(simOther);
        document.getElementById('sim_logistics').textContent  = fmt(simLogistics);
        document.getElementById('sim_total_cost').textContent = fmt(simTotal);
        document.getElementById('sim_margin_pct').textContent = fmt(simMargin, 1) + '%';

        // Różnice
        document.getElementById('sim_diff_foodcost').textContent  = fmt(simFood      - BASE.foodcost);
        document.getElementById('sim_diff_media').textContent     = fmt(simMedia     - BASE.media_per_carton);
        document.getElementById('sim_diff_labor').textContent     = fmt(simLabor     - BASE.labor_per_carton);
        document.getElementById('sim_diff_other').textContent     = fmt(simOther     - BASE.other_per_carton);
        document.getElementById('sim_diff_logistics').textContent = fmt(simLogistics - BASE.logistics_per_carton);
        document.getElementById('sim_diff_total').textContent     = fmt(simTotal     - baseCostTotal);
        document.getElementById('sim_diff_margin_pct').textContent= fmt(simMargin - baseMargin, 1) + ' pp';

        // Kolory różnic
        ['sim_diff_foodcost', 'sim_diff_media', 'sim_diff_labor', 'sim_diff_other', 'sim_diff_logistics', 'sim_diff_total'].forEach(id => {
            const el = document.getElementById(id);
            const val = parseFloat(el.textContent.replace(',', '.').replace(/\s/g, ''));
            el.className = 'text-end ' + (val > 0.005 ? 'text-danger' : val < -0.005 ? 'text-success' : '');
        });

        const diffMpct = document.getElementById('sim_diff_margin_pct');
        const mVal = parseFloat(diffMpct.textContent.replace(',', '.').replace(/\s/g, '').replace('pp', ''));
        diffMpct.className = 'text-end fw-bold ' + (mVal > 0.05 ? 'text-success' : mVal < -0.05 ? 'text-danger' : '');

        // Aktualizuj pasek KPI
        if (document.getElementById('kpi_margin_pct')) {
            document.getElementById('kpi_margin_pct').textContent      = fmt(simMargin, 1) + '%';
            document.getElementById('kpi_total_cost').textContent      = fmt(simTotal) + ' PLN';
            document.getElementById('kpi_margin_amount').textContent   = fmt(SALE_PRICE - simTotal) + ' PLN';
            document.getElementById('kpi_media').textContent           = fmt(simMedia) + ' PLN';
            document.getElementById('kpi_labor').textContent           = fmt(simLabor) + ' PLN';
            document.getElementById('kpi_other').textContent           = fmt(simOther) + ' PLN';
            document.getElementById('kpi_logistics').textContent       = fmt(simLogistics) + ' PLN';
        }

        // Aktualizuj pasek progress (6 segmentów: food, media, labor, other, logistics, margin)
        const bars = document.querySelectorAll('#costProgressBar .progress-bar');
        if (bars.length) {
            let pcts;
            if (SALE_PRICE > 0) {
                pcts = [
                    simFood      / SALE_PRICE * 100,
                    simMedia     / SALE_PRICE * 100,
                    simLabor     / SALE_PRICE * 100,
                    simOther     / SALE_PRICE * 100,
                    simLogistics / SALE_PRICE * 100,
                    Math.max(0, simMargin),
                ];
            } else {
                // Brak ceny sprzedaży – pokaż strukturę kosztów (% sumy kosztów, marża = 0)
                const totalCost = simFood + simMedia + simLabor + simOther + simLogistics;
                pcts = totalCost > 0 ? [
                    simFood      / totalCost * 100,
                    simMedia     / totalCost * 100,
                    simLabor     / totalCost * 100,
                    simOther     / totalCost * 100,
                    simLogistics / totalCost * 100,
                    0,
                ] : [0, 0, 0, 0, 0, 0];
            }
            bars.forEach((bar, i) => {
                bar.style.width = Math.max(0, pcts[i]).toFixed(2) + '%';
            });

            // Adnotacja o trybie wyświetlania
            const note = document.getElementById('progressBarNote');
            if (note) {
                note.style.display = SALE_PRICE > 0 ? 'none' : 'inline';
            }
        }

        // Eksponuj aktualny koszt dla kalkulatora ceny sprzedaży
        window._simTotalCost = simTotal;
        // Wywołaj przeliczenie kalkulatora ceny jeśli aktywny
        if (typeof recalcPriceCalc === 'function') recalcPriceCalc();
        // Przelicz kolumny EUR
        recalcOverviewEur();
    }

    // ── LIVE PRZELICZNIK EUR ─────────────────────────────────────────────────

    // Bazowe wartości PLN zapamiętane przy wczytaniu strony
    const BASE_PLN = {
        foodcost:   BASE.foodcost,
        media:      BASE.media_per_carton,
        labor:      BASE.labor_per_carton,
        other:      BASE.other_per_carton,
        logistics:  BASE.logistics_per_carton,
        total:      BASE.total_cost_per_carton,
    };

    function recalcOverviewEur() {
        const rateInput = document.getElementById('overviewLiveRate');
        if (!rateInput) return;
        const rate = parseFloat(rateInput.value);
        if (!isFinite(rate) || rate <= 0) return;

        const toEur = (pln) => isFinite(pln) ? (pln / rate).toFixed(2).replace('.', ',') : '—';

        // Bazowe EUR — stałe wartości PLN z BASE
        const setBase = (id, pln) => { const el = document.getElementById(id); if (el) el.textContent = toEur(pln); };
        setBase('eur_base_foodcost',  BASE_PLN.foodcost);
        setBase('eur_base_media',     BASE_PLN.media);
        setBase('eur_base_labor',     BASE_PLN.labor);
        setBase('eur_base_other',     BASE_PLN.other);
        setBase('eur_base_logistics', BASE_PLN.logistics);
        setBase('eur_base_total',     BASE_PLN.total);

        // Symulacja EUR — czytamy aktualną wartość PLN z <small id="sim_*">
        const pairs = [
            ['sim_foodcost',  'eur_sim_foodcost'],
            ['sim_media',     'eur_sim_media'],
            ['sim_labor',     'eur_sim_labor'],
            ['sim_other',     'eur_sim_other'],
            ['sim_logistics', 'eur_sim_logistics'],
            ['sim_total_cost','eur_sim_total'],
        ];
        pairs.forEach(([simId, eurId]) => {
            const simEl = document.getElementById(simId);
            const eurEl = document.getElementById(eurId);
            if (!simEl || !eurEl) return;
            const pln = parseFloat(simEl.textContent.replace(',', '.').replace(/\s/g, ''));
            eurEl.textContent = toEur(pln);
        });
    }

    // Bind sliders
    document.querySelectorAll('.sim-slider').forEach(function (slider) {
        slider.addEventListener('input', function () {
            const target = this.dataset.target;
            const val = parseInt(this.value, 10);
            state[target] = val;
            document.getElementById('lbl_' + target).textContent = pctLabel(val);
            recalculate();
            updateSimActiveLabel();
        });
    });

    // Reset button
    document.getElementById('resetSimulation').addEventListener('click', function () {
        state = { volume: 0, media: 0, labor: 0, other: 0, logistics: 0 };
        document.querySelectorAll('.sim-slider').forEach(s => { s.value = 0; });
        ['volume', 'media', 'labor', 'other', 'logistics'].forEach(t => {
            document.getElementById('lbl_' + t).textContent = '+0%';
        });
        recalculate();
        updateSimActiveLabel();
    });

    // ── TOGGLE PANELU SUWAKÓW ────────────────────────────────────────────────

    window.toggleSlidersPanel = function () {
        const panel   = document.getElementById('slidersPanel');
        const icon    = document.getElementById('toggleSlidersIcon');
        const label   = document.getElementById('toggleSlidersLabel');
        const visible = panel.style.display !== 'none';

        panel.style.display = visible ? 'none' : 'block';
        icon.className  = visible ? 'bi bi-chevron-down me-1' : 'bi bi-chevron-up me-1';
        label.textContent = visible ? 'Dostosuj symulację' : 'Ukryj suwaki';
    };

    function updateSimActiveLabel() {
        const active = Object.values(state).some(v => v !== 0);
        const badge  = document.getElementById('simActiveLabel');
        if (badge) badge.style.display = active ? 'inline-flex' : 'none';
    }

    // ── KALKULATOR CENY SPRZEDAŻY ────────────────────────────────────────────

    const BASE_SALE_EUR = BASE.sale_price_foreign ?? 0;
    const BASE_SALE_PLN = BASE.sale_price_pln     ?? 0;
    const BASE_MARGIN   = BASE.margin_percent      ?? 0;
    const PPC           = {{ analysis.product.ppc is defined and analysis.product.ppc > 1 ? analysis.product.ppc|e('js') : 0 }}; // szt. w kartonie (0 = nie wyświetlaj)

    function fmtEur(n) {
        return n.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' EUR';
    }
    function fmtPln(n) {
        return n.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' PLN';
    }
    function fmtPct(n) {
        return n.toFixed(1).replace('.', ',') + '%';
    }

    function marginColor(pct) {
        if (pct >= 20) return '#198754';   // success
        if (pct >= 10) return '#fd7e14';   // warning
        if (pct >= 0)  return '#ffc107';   // caution
        return '#dc3545';                   // danger
    }
    function marginBg(pct) {
        if (pct >= 20) return '#d1e7dd';
        if (pct >= 10) return '#fff3cd';
        if (pct >= 0)  return '#fff3cd';
        return '#f8d7da';
    }

    function getCurrentCost() {
        // Pobiera aktualny koszt symulowany (aktualizowany przez recalculate())
        return (typeof window._simTotalCost !== 'undefined') ? window._simTotalCost : BASE.total_cost_per_carton;
    }

    function syncExchangeRates() {
        // Synchronizuj oba pola kursów walut (zmiana w jednym → zmiana w drugim)
        const r1 = document.getElementById('pc_exchange_rate');
        const r2 = document.getElementById('pc_exchange_rate2');
        if (!r1 || !r2) return;
        if (document.activeElement === r1) r2.value = r1.value;
        if (document.activeElement === r2) r1.value = r2.value;
    }

    function recalcPriceCalc() {
        syncExchangeRates();

        const cost = getCurrentCost();
        const r1   = parseFloat((document.getElementById('pc_exchange_rate')?.value  || '{{ kpi.exchange_rate|number_format(4,".","")|e("js") }}').replace(',', '.'));
        const r2   = parseFloat((document.getElementById('pc_exchange_rate2')?.value || '{{ kpi.exchange_rate|number_format(4,".","")|e("js") }}').replace(',', '.'));

        // ── Tryb 1: cena → marża ──────────────────────────────────────────
        const priceEurRaw = document.getElementById('pc_price_eur')?.value;
        const priceEur1   = priceEurRaw !== '' && priceEurRaw !== null ? parseFloat(priceEurRaw) : NaN;
        const exRate1     = isFinite(r1) && r1 > 0 ? r1 : 1;
        const resultBox   = document.getElementById('pc_result_box');
        const margEl      = document.getElementById('pc_margin_result');
        const margAmt     = document.getElementById('pc_margin_amount_label');
        const pricePlnLbl = document.getElementById('pc_price_pln_label');
        const costRemLbl  = document.getElementById('pc_cost_reminder');

        let mode1Active = false;

        if (isFinite(priceEur1) && priceEur1 > 0 && isFinite(exRate1)) {
            const pricePln1  = priceEur1 * exRate1;
            const marginPct1 = ((pricePln1 - cost) / pricePln1) * 100;
            const marginAmt1 = pricePln1 - cost;

            pricePlnLbl.textContent = '= ' + fmtPln(pricePln1);
            margEl.textContent      = fmtPct(marginPct1);
            margEl.style.color      = marginColor(marginPct1);
            margAmt.textContent     = 'marża kwotowa: ' + fmtPln(marginAmt1);
            margAmt.style.color     = marginColor(marginPct1);
            costRemLbl.textContent  = 'koszt wytworzenia: ' + fmtPln(cost);
            resultBox.style.background = marginBg(marginPct1);

            // Cena / szt
            if (PPC > 0) {
                const ppuEur = priceEur1 / PPC;
                const ppuAmt = marginAmt1 / PPC;
                const puEl   = document.getElementById('pc_price_per_unit');
                const muEl   = document.getElementById('pc_margin_per_unit');
                if (puEl) puEl.textContent = ppuEur.toFixed(3).replace('.', ',') + ' EUR';
                if (muEl) muEl.textContent = ppuAmt.toFixed(3).replace('.', ',') + ' PLN';
            }

            updateCompareTable(priceEur1, pricePln1, cost, marginPct1);
            mode1Active = true;
        } else {
            margEl.textContent      = '—';
            margEl.style.color      = '';
            pricePlnLbl.textContent = '= — PLN';
            margAmt.textContent     = 'marża kwotowa: —';
            costRemLbl.textContent  = 'koszt wytworzenia: ' + fmtPln(cost);
            resultBox.style.background = '#f8f9fa';
            const puEl = document.getElementById('pc_price_per_unit');
            const muEl = document.getElementById('pc_margin_per_unit');
            if (puEl) puEl.textContent = '—';
            if (muEl) muEl.textContent = '—';
        }

        // ── Tryb 2: marża → cena ──────────────────────────────────────────
        const targetMarginRaw = document.getElementById('pc_target_margin')?.value;
        const targetMargin    = targetMarginRaw !== '' && targetMarginRaw !== null ? parseFloat(targetMarginRaw) : NaN;
        const exRate2         = isFinite(r2) && r2 > 0 ? r2 : 1;
        const revBox          = document.getElementById('pc_rev_result_box');
        const revEurEl        = document.getElementById('pc_rev_price_eur');
        const revPlnEl        = document.getElementById('pc_rev_price_pln');
        const revAmtEl        = document.getElementById('pc_rev_margin_amount');

        if (isFinite(targetMargin) && targetMargin < 100 && isFinite(exRate2)) {
            // cena_PLN = koszt / (1 - marża/100)
            const reqPricePln  = cost / (1 - targetMargin / 100);
            const reqPriceEur  = reqPricePln / exRate2;
            const reqMarginAmt = reqPricePln - cost;

            revEurEl.textContent = fmtEur(reqPriceEur);
            revPlnEl.textContent = '= ' + fmtPln(reqPricePln);
            revAmtEl.textContent = 'marża kwotowa: ' + fmtPln(reqMarginAmt);
            revBox.style.background = marginBg(targetMargin);

            // Cena / szt (tryb 2)
            if (PPC > 0) {
                const ppuEl = document.getElementById('pc_rev_price_per_unit');
                if (ppuEl) ppuEl.textContent = (reqPriceEur / PPC).toFixed(3).replace('.', ',') + ' EUR';
            }

            // Aktualizuj tabelę porównawczą tylko jeśli tryb 1 nie jest aktywny
            // (tryb 1 ma pierwszeństwo — gdy oba są wypełnione, tabela pokazuje tryb 1)
            if (!mode1Active) {
                updateCompareTable(reqPriceEur, reqPricePln, cost, targetMargin);
            }
        } else {
            revEurEl.textContent = '—';
            revPlnEl.textContent = '= — PLN';
            revAmtEl.textContent = 'marża kwotowa: —';
            revBox.style.background = '#f8f9fa';

            // Jeśli tryb 2 wyczyszczony i tryb 1 też pusty — ukryj tabelę
            if (!mode1Active) {
                const section = document.getElementById('pc_compare_section');
                if (section) section.style.display = 'none';
            }
        }
    }

    function updateCompareTable(newEur, newPln, newCost, newMarginPct) {
        const section = document.getElementById('pc_compare_section');
        if (!section) return;
        section.style.display = 'block';

        const diffEur    = newEur    - BASE_SALE_EUR;
        const diffPln    = newPln    - BASE_SALE_PLN;
        const diffMargin = newMarginPct - BASE_MARGIN;

        const setTxt = (id, txt) => { const el = document.getElementById(id); if (el) el.textContent = txt; };
        const setEl  = (id, txt, cls) => {
            const el = document.getElementById(id);
            if (!el) return;
            el.textContent = txt;
            el.className   = 'text-end ' + cls;
        };

        setTxt('pc_cmp_new_eur',    fmtEur(newEur));
        setTxt('pc_cmp_new_pln',    fmtPln(newPln));
        setTxt('pc_cmp_cost_sim',   fmtPln(newCost));
        setTxt('pc_cmp_new_margin', fmtPct(newMarginPct));

        const diffEurFmt  = (diffEur  >= 0 ? '+' : '') + fmtEur(diffEur);
        const diffPlnFmt  = (diffPln  >= 0 ? '+' : '') + fmtPln(diffPln);
        const diffMrgFmt  = (diffMargin >= 0 ? '+' : '') + fmtPct(diffMargin);

        setEl('pc_cmp_diff_eur',    diffEurFmt,  diffEur    > 0.005 ? 'text-success' : diffEur    < -0.005 ? 'text-danger' : '');
        setEl('pc_cmp_diff_pln',    diffPlnFmt,  diffPln    > 0.005 ? 'text-success' : diffPln    < -0.005 ? 'text-danger' : '');
        setEl('pc_cmp_diff_cost',   '—',         '');
        setEl('pc_cmp_diff_margin', diffMrgFmt,  diffMargin > 0.05  ? 'text-success' : diffMargin < -0.05  ? 'text-danger' : '');

        // Wiersze cena / szt
        if (PPC > 0) {
            const newEurUnit  = newEur / PPC;
            const newPlnUnit  = newPln / PPC;
            const baseEurUnit = BASE_SALE_EUR > 0 ? BASE_SALE_EUR / PPC : 0;
            const basePlnUnit = BASE_SALE_PLN > 0 ? BASE_SALE_PLN / PPC : 0;
            const diffEurUnit = newEurUnit - baseEurUnit;
            const diffPlnUnit = newPlnUnit - basePlnUnit;

            const fmtUnit = (n, suffix) => n.toFixed(3).replace('.', ',') + ' ' + suffix;
            const fmtUnitDiff = (n, suffix) => (n >= 0 ? '+' : '') + fmtUnit(n, suffix);

            setTxt('pc_cmp_new_eur_unit', fmtUnit(newEurUnit, 'EUR'));
            setTxt('pc_cmp_new_pln_unit', fmtUnit(newPlnUnit, 'PLN'));
            setEl('pc_cmp_diff_eur_unit', fmtUnitDiff(diffEurUnit, 'EUR'), diffEurUnit > 0.0005 ? 'text-success' : diffEurUnit < -0.0005 ? 'text-danger' : '');
            setEl('pc_cmp_diff_pln_unit', fmtUnitDiff(diffPlnUnit, 'PLN'), diffPlnUnit > 0.0005 ? 'text-success' : diffPlnUnit < -0.0005 ? 'text-danger' : '');
        }
    }

    // Inicjalizacja – wstaw wartości bazowe do przypomnienia kosztu
    window.addEventListener('DOMContentLoaded', function() {
        const cr = document.getElementById('pc_cost_reminder');
        if (cr) cr.textContent = 'koszt wytworzenia: ' + fmtPln(BASE.total_cost_per_carton ?? 0);
        // Inicjalizacja kolumn EUR przy załadowaniu
        recalcOverviewEur();
    });

    // Eksponuj na window – wymagane dla atrybutów oninput w HTML (poza IIFE)
    window.recalcPriceCalc = recalcPriceCalc;

})();
</script>

<script>
// ── MODAL FOODCOST ────────────────────────────────────────────────────────────

window.openFoodcostModal = function(productId) {
    const modal = document.getElementById('foodcostModal');
    const body  = document.getElementById('foodcostModalBody');
    const total = document.getElementById('fcModalTotal');

    // Reset
    body.innerHTML = '<div class="text-center py-5 text-muted"><div class="spinner-border spinner-border-sm me-2"></div>Ładowanie struktury receptury…</div>';
    total.textContent = '';

    const bsModal = new bootstrap.Modal(modal);
    bsModal.show();

    fetch('{{ root }}/ajax/product-margin/foodcost-breakdown?product_id=' + productId)
        .then(r => r.json())
        .then(function(res) {
            if (res.error && !res.data) {
                body.innerHTML = '<div class="alert alert-warning m-3"><i class="bi bi-exclamation-triangle me-2"></i>' + res.error + '</div>';
                return;
            }
            const data = res.data;
            if (!data || !data.elements || data.elements.length === 0) {
                body.innerHTML = '<div class="alert alert-info m-3"><i class="bi bi-info-circle me-2"></i>Brak składników receptury dla tego produktu.</div>';
                return;
            }

            // Suma foodcost
            const grandTotal = data.elements.reduce((s, el) => s + (parseFloat(el.price_for_required_quantity) || 0), 0);
            total.innerHTML = '<strong>Łączny foodcost: ' + grandTotal.toFixed(2).replace('.', ',') + ' PLN</strong>'
                + '<span class="text-muted ms-2">| yield: ' + (data.yield_quantity || 1) + ' ' + (data.unit_name || '') + '</span>';

            body.innerHTML = buildRecipeTable(data.elements, grandTotal);
        })
        .catch(function(err) {
            body.innerHTML = '<div class="alert alert-danger m-3"><i class="bi bi-x-circle me-2"></i>Błąd ładowania danych: ' + err.message + '</div>';
        });
};

function buildRecipeTable(elements, grandTotal) {
    let html = '<table class="table table-sm align-middle mb-0">';
    html += '<thead class="table-light sticky-top"><tr>'
        + '<th class="ps-3">Składnik</th>'
        + '<th class="text-end">Ilość</th>'
        + '<th class="text-end">Cena / jed.</th>'
        + '<th class="text-end">Koszt</th>'
        + '<th class="text-end pe-3">Udział</th>'
        + '</tr></thead><tbody>';
    html += buildRows(elements, grandTotal, 0);
    html += '</tbody>';
    // Wiersz sumy
    html += '<tfoot class="table-danger fw-semibold">'
        + '<tr><td class="ps-3" colspan="3">Łączny foodcost</td>'
        + '<td class="text-end">' + grandTotal.toFixed(2).replace('.', ',') + ' PLN</td>'
        + '<td class="text-end pe-3">100%</td></tr>'
        + '</tfoot></table>';
    return html;
}

function buildRows(elements, grandTotal, depth) {
    let html = '';

    // Zaokrąglenie ilości wg jednostki
    const fmtQty = (qty, unit) => {
        const u = (unit || '').toLowerCase().trim();
        if (u === 'szt' || u === 'szt.' || u === 'pcs' || u === 'pc' || u === 'sztuka') {
            return Math.round(qty).toString();
        }
        if (u === 'g' || u === 'ml') {
            return Math.round(qty).toString();
        }
        return qty.toFixed(3).replace('.', ',');
    };

    elements.forEach(function(el) {
        const cost  = parseFloat(el.price_for_required_quantity) || 0;
        const pct   = grandTotal > 0 ? (cost / grandTotal * 100) : 0;
        const qty   = parseFloat(el.required_quantity) || 0;
        const ppu   = parseFloat(el.suggested_base_unit_price) || 0;
        const unit  = el.unit_name || '';
        const isSubRecipe = el.type === 'sub-recipe';

        const indent = depth * 20;
        const icon = isSubRecipe
            ? '<i class="bi bi-box text-warning me-1"></i>'
            : '<i class="bi bi-circle-fill text-info me-1" style="font-size:.55rem;vertical-align:middle;"></i>';

        const bgClass = depth === 0 ? '' : (depth === 1 ? 'table-light' : 'bg-white');
        const rowClass = isSubRecipe ? 'fw-semibold' : '';

        html += '<tr class="' + bgClass + ' ' + rowClass + '">';
        html += '<td class="ps-3" style="padding-left:' + (12 + indent) + 'px !important;">'
            + icon + el.name;
        if (isSubRecipe && el.cycle_detected) {
            html += ' <span class="badge bg-danger ms-1" title="Wykryto cykl w recepturze">cykl</span>';
        }
        html += '</td>';

        if (isSubRecipe) {
            // Podreceptura — ilość i koszt, bez ceny/jed.
            html += '<td class="text-end text-muted">' + fmtQty(qty, unit) + ' ' + unit + '</td>';
            html += '<td class="text-end text-muted">—</td>';
        } else {
            html += '<td class="text-end text-muted">' + fmtQty(qty, unit) + ' ' + unit + '</td>';
            html += '<td class="text-end text-muted">' + ppu.toFixed(4).replace('.', ',') + '</td>';
        }

        // Pasek postępu w kolumnie kosztu
        const barWidth = Math.min(100, pct).toFixed(1);
        const barColor = depth === 0 ? '#0dcaf0' : '#6c757d';
        html += '<td class="text-end">'
            + '<span class="fw-semibold">' + cost.toFixed(2).replace('.', ',') + '</span>'
            + ' <small class="text-muted">PLN</small>'
            + '</td>';
        html += '<td class="text-end pe-3">'
            + '<div class="d-flex align-items-center justify-content-end gap-1">'
            + '<div class="progress flex-grow-1" style="height:6px;min-width:40px;">'
            + '<div class="progress-bar" style="width:' + barWidth + '%;background:' + barColor + ';"></div>'
            + '</div>'
            + '<small class="text-muted text-nowrap">' + pct.toFixed(1).replace('.', ',') + '%</small>'
            + '</div></td>';
        html += '</tr>';

        // Rekurencyjnie elementy podreceptury
        if (isSubRecipe && el.elements && el.elements.length > 0) {
            html += buildRows(el.elements, grandTotal, depth + 1);
        }
    });
    return html;
}
</script>
{% endif %}
{% endblock %}






