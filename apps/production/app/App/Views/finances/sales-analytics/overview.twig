{% extends "layouts/base.twig" %}

{% block title %}Analiza sprzedaży WDT{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <div class="page-title">
            <div class="row">
                <div class="col-12 col-md-6 order-md-1 order-last">
                    <h3>Analiza sprzedaży WDT</h3>
                    <p class="text-subtitle text-muted">Średnia sprzedaż produktów na podstawie dokumentów WDT</p>
                </div>
                <div class="col-12 col-md-6 order-md-2 order-first">
                    <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="{{ root }}/dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Analiza sprzedaży WDT</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
<section class="section">

    {# ── Filtry ─────────────────────────────────────────────────── #}
    <div class="card">
        <div class="card-body">
            <form method="get" action="{{ root }}/finances/sales-analytics" class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label" for="input_date_from">Miesiąc od</label>
                    <input type="month" class="form-control" id="input_date_from" name="date_from" value="{{ date_from }}">
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label" for="input_date_to">Miesiąc do</label>
                    <input type="month" class="form-control" id="input_date_to" name="date_to" value="{{ date_to }}">
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label" for="input_customer_id">Klient</label>
                    <select class="form-select" id="input_customer_id" name="customer_id">
                        <option value="">Wszyscy klienci</option>
                        {% for customer in customers %}
                            <option value="{{ customer.id }}" {% if customer_id == customer.id %}selected{% endif %}>{{ customer.company }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Analizuj
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# ── KPI ────────────────────────────────────────────────────── #}
    {% if summary %}
    <div class="row g-3 mt-1">
        <div class="col-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">Łączna wartość sprzedaży</div>
                    <div class="fs-4 fw-bold text-success">
                        {{ summary.total_value|number_format(2, '.', ' ') }} €
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">Dokumenty WDT</div>
                    <div class="fs-4 fw-bold">{{ summary.total_documents }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">Unikalnych klientów</div>
                    <div class="fs-4 fw-bold">{{ summary.total_customers }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">Łącznie kartonów</div>
                    <div class="fs-4 fw-bold">{{ summary.total_cartons }}</div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {# ── Wykres miesięczny ──────────────────────────────────────── #}
    {% if monthly_chart.labels|length > 0 %}
    <div class="card mt-3">
        <div class="card-header">
            <h5 class="card-title mb-0"><i class="bi bi-graph-up"></i> Przychód miesięczny</h5>
        </div>
        <div class="card-body">
            <canvas id="monthlyRevenueChart" style="max-height:320px;"></canvas>
        </div>
    </div>
    {% endif %}

    {# ── Tabela produktów ───────────────────────────────────────── #}
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="card-title mb-0"><i class="bi bi-table"></i> Średnia sprzedaż produktów (miesięcznie)</h5>
            <small class="text-muted d-none d-md-block">Kliknij wiersz produktu, aby zobaczyć trend sprzedażowy</small>
        </div>
        <div class="card-body pb-2 pt-3">
            <div class="input-group input-group-sm" style="max-width:380px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="productSearch" class="form-control" placeholder="Szukaj produktu po nazwie…" autocomplete="off" aria-label="Szukaj produktu po nazwie">
                <button type="button" class="btn btn-outline-secondary" id="productSearchClear" title="Wyczyść">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div id="productSearchNoResults" class="text-muted small mt-2 d-none">Brak wyników dla podanej frazy.</div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0" id="productsTable">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th data-sort="product_name" style="cursor:pointer;" class="sort-col">Produkt <i class="bi bi-arrow-down-up text-muted small"></i></th>
                            <th data-sort="category_name" style="cursor:pointer;" class="sort-col">Kategoria <i class="bi bi-arrow-down-up text-muted small"></i></th>
                            <th data-sort="avg_quantity" style="cursor:pointer;" class="sort-col text-end">Śr. kartony/mies. <i class="bi bi-arrow-down-up text-muted small"></i></th>
                            <th data-sort="avg_value" style="cursor:pointer;" class="sort-col text-end">Śr. wartość/mies. <i class="bi bi-arrow-down-up text-muted small"></i></th>
                            <th data-sort="total_quantity" style="cursor:pointer;" class="sort-col text-end">Łącznie kartony <i class="bi bi-arrow-down-up text-muted small"></i></th>
                            <th data-sort="total_value" style="cursor:pointer;" class="sort-col text-end">Łącznie wartość <i class="bi bi-arrow-down-up text-muted small"></i></th>
                            <th data-sort="months_count" style="cursor:pointer;" class="sort-col text-end">Miesięcy <i class="bi bi-arrow-down-up text-muted small"></i></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for i, product in products %}
                        <tr class="product-row" style="cursor:pointer;"
                            data-product-id="{{ product.product_id }}"
                            data-product-name="{{ product.product_name }}"
                            data-sort-product_name="{{ product.product_name|lower }}"
                            data-sort-category_name="{{ product.category_name|lower }}"
                            data-sort-avg_quantity="{{ product.avg_quantity }}"
                            data-sort-avg_value="{{ product.avg_value }}"
                            data-sort-total_quantity="{{ product.total_quantity }}"
                            data-sort-total_value="{{ product.total_value }}"
                            data-sort-months_count="{{ product.months_count }}"
                            title="Kliknij, aby zobaczyć trend sprzedaży">
                            <td>{{ i + 1 }}</td>
                            <td>
                                <strong>{{ product.product_name }}</strong>
                            </td>
                            <td><span class="badge bg-light text-dark">{{ product.category_name }}</span></td>
                            <td class="text-end">{{ product.avg_quantity|number_format(1, '.', ' ') }}</td>
                            <td class="text-end fw-bold">{{ product.avg_value|number_format(2, '.', ' ') }} €</td>
                            <td class="text-end text-muted">{{ product.total_quantity }}</td>
                            <td class="text-end text-muted">{{ product.total_value|number_format(2, '.', ' ') }} €</td>
                            <td class="text-end text-muted">{{ product.months_count }}</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                Brak danych dla wybranego zakresu dat.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# ── Modal z trendem ────────────────────────────────────────── #}
    <div class="modal fade" id="trendModal" tabindex="-1" aria-labelledby="trendModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="trendModalLabel">Trend sprzedażowy</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="trendModalSpinner" class="text-center py-5 d-none">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div class="mt-2 text-muted">Ładowanie danych…</div>
                    </div>
                    <div id="trendModalContent">
                        <div class="row g-3 mb-3" id="trendKpiRow">
                        </div>
                        <canvas id="trendChart" style="max-height:380px;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>

{# ── Chart.js ───────────────────────────────────────────────────── #}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
const ROOT        = "{{ root }}";
const DATE_FROM   = "{{ date_from }}";
const DATE_TO     = "{{ date_to }}";
const CUSTOMER_ID  = {{ customer_id|json_encode|raw }};
const CURRENCY_SYMBOL = "€";

// ── Wykres miesięczny ──────────────────────────────────────────────
{% if monthly_chart.labels|length > 0 %}
(function () {
    const ctx = document.getElementById('monthlyRevenueChart');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: {{ monthly_chart.labels|json_encode|raw }},
            datasets: [
                {
                    label: 'Wartość (' + CURRENCY_SYMBOL + ')',
                    data: {{ monthly_chart.values|json_encode|raw }},
                    backgroundColor: 'rgba(52, 152, 219, 0.7)',
                    borderColor: 'rgba(52, 152, 219, 1)',
                    borderWidth: 1,
                    yAxisID: 'y',
                    order: 2
                },
                {
                    label: 'Kartony',
                    data: {{ monthly_chart.cartons|json_encode|raw }},
                    type: 'line',
                    borderColor: 'rgba(231, 76, 60, 0.9)',
                    backgroundColor: 'rgba(231, 76, 60, 0.1)',
                    pointBackgroundColor: 'rgba(231, 76, 60, 1)',
                    tension: 0.3,
                    yAxisID: 'y1',
                    order: 1
                }
            ]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'top' } },
            scales: {
                y:  { position: 'left',  title: { display: true, text: 'Wartość (' + CURRENCY_SYMBOL + ')' } },
                y1: { position: 'right', title: { display: true, text: 'Kartony' }, grid: { drawOnChartArea: false } }
            }
        }
    });
})();
{% endif %}

// ── Trend produktu
let trendChartInstance = null;

document.querySelectorAll('.product-row').forEach(function (row) {
    row.addEventListener('click', function () {
        const productId   = row.dataset.productId;
        const productName = row.dataset.productName;
        openTrendModal(productId, productName);
    });
});

function openTrendModal(productId, productName) {
    document.getElementById('trendModalLabel').textContent = 'Trend sprzedażowy: ' + productName;
    document.getElementById('trendModalSpinner').classList.remove('d-none');
    document.getElementById('trendModalContent').classList.add('d-none');

    const modal = new bootstrap.Modal(document.getElementById('trendModal'));
    modal.show();

    const url = ROOT + '/ajax/finances/sales-analytics/product-trend'
        + '?product_id=' + productId
        + '&date_from=' + DATE_FROM
        + '&date_to='   + DATE_TO
        + '&customer_id=' + encodeURIComponent(CUSTOMER_ID);

    fetch(url)
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (!res.ok) throw new Error(res.error || 'Błąd serwera');
            renderTrend(res.data);
        })
        .catch(function (err) {
            document.getElementById('trendModalSpinner').classList.add('d-none');
            document.getElementById('trendModalContent').innerHTML =
                '<div class="alert alert-danger">Błąd: ' + err.message + '</div>';
            document.getElementById('trendModalContent').classList.remove('d-none');
        });
}

function renderTrend(data) {
    document.getElementById('trendModalSpinner').classList.add('d-none');
    document.getElementById('trendModalContent').classList.remove('d-none');

    // KPI
    const totalQty   = data.quantities.reduce(function (a, b) { return a + b; }, 0);
    const totalVal   = data.values.reduce(function (a, b) { return a + b; }, 0);
    const avgQty     = data.quantities.length ? (totalQty / data.quantities.length).toFixed(1) : 0;
    const avgVal     = data.values.length     ? (totalVal / data.values.length).toFixed(2) : 0;

    document.getElementById('trendKpiRow').innerHTML = [
        kpiCard('Łącznie kartonów',    totalQty.toLocaleString(),                    'text-primary'),
        kpiCard('Łącznie wartość',     totalVal.toLocaleString('pl-PL', {minimumFractionDigits: 2}) + ' ' + CURRENCY_SYMBOL, 'text-success'),
        kpiCard('Śr. kartony/mies.',   avgQty,                                        'text-info'),
        kpiCard('Śr. wartość/mies.',   parseFloat(avgVal).toLocaleString('pl-PL', {minimumFractionDigits: 2}) + ' ' + CURRENCY_SYMBOL, 'text-warning'),
    ].join('');

    // Wykres
    const ctx = document.getElementById('trendChart');
    if (trendChartInstance) { trendChartInstance.destroy(); }

    trendChartInstance = new Chart(ctx, {
        type: 'line',
        data: {
            labels: data.labels,
            datasets: [
                {
                    label: 'Kartony',
                    data: data.quantities,
                    borderColor: 'rgba(52, 152, 219, 1)',
                    backgroundColor: 'rgba(52, 152, 219, 0.15)',
                    tension: 0.3,
                    pointRadius: 5,
                    fill: true,
                    yAxisID: 'y'
                },
                {
                    label: 'Wartość (' + CURRENCY_SYMBOL + ')',
                    data: data.values,
                    borderColor: 'rgba(39, 174, 96, 1)',
                    backgroundColor: 'rgba(39, 174, 96, 0.1)',
                    tension: 0.3,
                    pointRadius: 5,
                    fill: false,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            interaction: { mode: 'index', intersect: false },
            plugins: { legend: { position: 'top' } },
            scales: {
                y:  { position: 'left',  title: { display: true, text: 'Kartony' } },
                y1: { position: 'right', title: { display: true, text: 'Wartość (' + CURRENCY_SYMBOL + ')' }, grid: { drawOnChartArea: false } }
            }
        }
    });
}

function kpiCard(label, value, colorClass) {
    return '<div class="col-6 col-md-3">'
        + '<div class="card h-100 text-center">'
        + '<div class="card-body py-3">'
        + '<div class="text-muted small">' + label + '</div>'
        + '<div class="fs-5 fw-bold ' + colorClass + '">' + value + '</div>'
        + '</div></div></div>';
}

// ── Wyszukiwarka produktów ─────────────────────────────────────────
(function () {
    const searchInput    = document.getElementById('productSearch');
    const clearBtn       = document.getElementById('productSearchClear');
    const noResults      = document.getElementById('productSearchNoResults');

    if (!searchInput) return;

    function filterRows() {
        const phrase = searchInput.value.trim().toLowerCase();
        const rows   = document.querySelectorAll('#productsTable tbody .product-row');
        let visibleCount = 0;

        rows.forEach(function (row) {
            const name = (row.dataset.productName || '').toLowerCase();
            if (!phrase || name.includes(phrase)) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        noResults.classList.toggle('d-none', visibleCount > 0 || !phrase);
        clearBtn.style.display = phrase ? '' : 'none';
    }

    searchInput.addEventListener('input', filterRows);

    clearBtn.addEventListener('click', function () {
        searchInput.value = '';
        filterRows();
        searchInput.focus();
    });

    // inicjalne ukrycie przycisku clear
    clearBtn.style.display = 'none';
})();

// ── Sortowanie kolumn ──────────────────────────────────────────────
(function () {
    const table   = document.getElementById('productsTable');
    if (!table) return;
    const tbody   = table.querySelector('tbody');
    let currentCol = null;
    let currentDir = 1; // 1 = ASC, -1 = DESC

    table.querySelectorAll('th.sort-col').forEach(function (th) {
        th.addEventListener('click', function () {
            const col = th.dataset.sort;

            if (currentCol === col) {
                currentDir *= -1;
            } else {
                currentCol = col;
                currentDir = 1;
            }

            // Aktualizuj ikonki nagłówków
            table.querySelectorAll('th.sort-col').forEach(function (h) {
                const icon = h.querySelector('i');
                if (h.dataset.sort === col) {
                    icon.className = currentDir === 1
                        ? 'bi bi-arrow-up text-primary small'
                        : 'bi bi-arrow-down text-primary small';
                } else {
                    icon.className = 'bi bi-arrow-down-up text-muted small';
                }
            });

            // Pobierz tylko widoczne wiersze (po filtrowaniu wyszukiwarką)
            const rows = Array.from(tbody.querySelectorAll('tr.product-row'));

            const isNumeric = ['avg_quantity', 'avg_value', 'total_quantity', 'total_value', 'months_count'].includes(col);

            rows.sort(function (a, b) {
                const aVal = a.getAttribute('data-sort-' + col);
                const bVal = b.getAttribute('data-sort-' + col);

                if (isNumeric) {
                    return (parseFloat(aVal) - parseFloat(bVal)) * currentDir;
                }
                return aVal.localeCompare(bVal, 'pl') * currentDir;
            });

            rows.forEach(function (row) { tbody.appendChild(row); });

            // Przenumeruj wiersze (#)
            let counter = 1;
            rows.forEach(function (row) {
                if (row.style.display !== 'none') {
                    row.cells[0].textContent = counter++;
                }
            });
        });
    });
})();
</script>
{% endblock %}




