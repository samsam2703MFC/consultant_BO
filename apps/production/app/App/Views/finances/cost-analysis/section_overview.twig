{% extends "layouts/base.twig" %}

{% block title %}{{ translations.cost_analysis_section_title|default('Analiza kosztów - sekcja') }}{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <div class="page-title">
            <div class="row">
                <div class="col-12 col-md-6 order-md-1 order-last">
                    <h3>{{ translations.cost_analysis_section_title }}</h3>
                    <p class="text-subtitle text-muted">{{ translations.cost_analysis_section_subtitle }}</p>
                </div>
                <div class="col-12 col-md-6 order-md-2 order-first">
                    <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="{{ root }}/dashboard">{{ translations.dashboard }}</a></li>
                            <li class="breadcrumb-item active" aria-current="page">{{ translations.cost_analysis_section_title }}</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <section class="section">
        <div class="card">
            <div class="card-body">
                <form method="get" action="{{ root }}/finances/cost-analysis/section">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-5">
                            <label class="form-label">{{ translations.cost_analysis_section }}</label>
                            <select class="form-select" name="section_id" required>
                                <option value="">{{ translations.cost_analysis_section_placeholder }}</option>
                                {% for section in sections %}
                                    <option value="{{ section.id }}" {% if section.id == selected_section_id %}selected{% endif %}>
                                        {{ section.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">{{ translations.cost_analysis_month }}</label>
                            <select class="form-select" name="month_id">
                                <option value="">{{ translations.cost_analysis_month_placeholder }}</option>
                                {% for month in months %}
                                    <option value="{{ month.id }}" {% if month.id == selected_month_id %}selected{% endif %}>
                                        {{ month.year }}-{{ "%02d"|format(month.month) }} ({{ month.status }})
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <button type="submit" class="btn btn-primary w-100">
                                {{ translations.cost_analysis_calculate }}
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        {% if analysis %}
            <div class="row g-3 mt-1">
                <div class="col-6 col-xl-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="text-muted">{{ translations.cost_analysis_section_revenue }}</div>
                            <div class="fs-4 fw-bold">{{ analysis.summary.revenue_pln|number_format(2, '.', ' ') }} PLN</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="text-muted">{{ translations.cost_analysis_section_cost }}</div>
                            <div class="fs-4 fw-bold">{{ analysis.summary.cost_pln|number_format(2, '.', ' ') }} PLN</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="text-muted">{{ translations.cost_analysis_margin_amount }}</div>
                            <div class="fs-4 fw-bold">{{ analysis.summary.margin_pln|number_format(2, '.', ' ') }} PLN</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="text-muted">{{ translations.cost_analysis_margin_percent }}</div>
                            <div class="fs-4 fw-bold">{{ analysis.summary.margin_percent|number_format(1, '.', ' ') }}%</div>
                        </div>
                    </div>
                </div>
            </div>

            {% if analysis.warnings is not empty %}
                <div class="alert alert-warning mt-3">
                    <strong>{{ translations.cost_analysis_warnings }}</strong>
                    <ul class="mb-0">
                        {% for warning in analysis.warnings %}
                            <li>{{ warning }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="mb-3">{{ translations.cost_analysis_section_products }}</h5>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>{{ translations.product_name }}</th>
                                    <th>{{ translations.category }}</th>
                                    <th class="text-end">{{ translations.cost_analysis_sold_cartons }}</th>
                                    <th class="text-end">{{ translations.cost_analysis_sale_price }}</th>
                                    <th class="text-end">{{ translations.cost_analysis_sale_price_pln }}</th>
                                    <th class="text-end">{{ translations.cost_analysis_raw_cost }}</th>
                                    <th class="text-end">{{ translations.cost_analysis_section_cost }}</th>
                                    <th class="text-end">{{ translations.cost_analysis_shared_cost }}</th>
                                    <th class="text-end">{{ translations.cost_analysis_full_cost }}</th>
                                    <th class="text-end">{{ translations.cost_analysis_margin_percent }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in analysis.rows %}
                                    <tr {% if row.margin_percent < 0 %}class="table-danger"{% endif %}>
                                        <td>{{ row.product_name }}</td>
                                        <td>{{ row.category_name }}</td>
                                        <td class="text-end">{{ row.cartons_qty }}</td>
                                        <td class="text-end">{{ row.sale_price_unit|number_format(2, '.', ' ') }} {{ row.sale_currency|default('EUR') }}</td>
                                        <td class="text-end">{{ row.sale_price_unit_pln|number_format(2, '.', ' ') }} PLN</td>
                                        <td class="text-end">{{ row.raw_cost_unit|number_format(2, '.', ' ') }} PLN</td>
                                        <td class="text-end">{{ row.section_cost_unit|number_format(2, '.', ' ') }} PLN</td>
                                        <td class="text-end">{{ row.shared_cost_unit|number_format(2, '.', ' ') }} PLN</td>
                                        <td class="text-end">{{ row.unit_full_cost|number_format(2, '.', ' ') }} PLN</td>
                                        <td class="text-end {% if row.margin_percent < 0 %}text-danger fw-bold{% endif %}">{{ row.margin_percent|number_format(1, '.', ' ') }}%</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="10" class="text-center">{{ translations.no_products_available }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="mb-3">{{ translations.cost_analysis_explanation }}</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="list-unstyled mb-0">
                                <li><strong>{{ translations.cost_analysis_period }}:</strong> {{ analysis.date_range.start }} – {{ analysis.date_range.end }}</li>
                                <li><strong>{{ translations.cost_analysis_section_pool }}:</strong> {{ analysis.explanation.section_cost_pool|number_format(2, '.', ' ') }} PLN</li>
                                <li><strong>{{ translations.cost_analysis_employee_cost }}:</strong> {{ analysis.explanation.employee_cost|number_format(2, '.', ' ') }} PLN</li>
                                <li><strong>Koszty stałe (amortyzacja):</strong> {{ analysis.explanation.fixed_costs|number_format(2, '.', ' ') }} PLN</li>
                                <li><strong>Koszty zmienne (media):</strong> {{ analysis.explanation.media_costs|number_format(2, '.', ' ') }} PLN</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="list-unstyled mb-0">
                                <li><strong>{{ translations.cost_analysis_weighted_units }}:</strong> {{ analysis.explanation.total_weighted_units|number_format(2, '.', ' ') }}</li>
                                <li><strong>{{ translations.cost_analysis_cost_per_point }}:</strong> {{ analysis.explanation.section_cost_per_point|number_format(4, '.', ' ') }} PLN</li>
                                <li><strong>{{ translations.cost_analysis_shared_cost }}:</strong> {{ analysis.explanation.shared_cost_unit|number_format(4, '.', ' ') }} PLN / szt.</li>
                                <li><strong>{{ translations.cost_analysis_exchange_rate }}:</strong> {{ analysis.explanation.exchange_rate_euro|number_format(4, '.', ' ') }} PLN/EUR</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info mt-3">
                {{ translations.cost_analysis_section_select_prompt }}
            </div>
        {% endif %}
    </section>
{% endblock %}

