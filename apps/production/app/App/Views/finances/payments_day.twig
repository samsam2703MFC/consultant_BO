{% extends "layouts/base.twig" %}

{% block title %}Płatności dnia{% endblock %}

{% block page_heading %}
    <div class="page-heading at-profit-head">
        <div class="page-title">
            <h3>Płatności dnia</h3>
            <p class="text-subtitle text-muted mb-0">Finanse › Należności · {{ data.day|date('d.m.Y') }} — proformy niezapłacone, przypomnienia, różnice dostaw.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            {% if can_see('/communication/payment-reminders') %}<a class="btn btn-outline-primary" href="{{ root }}/communication/payment-reminders"><i class="bi bi-bell"></i> Przypomnienia płatności</a>{% endif %}
            {% if can_see('/shipments/differences') %}<a class="btn btn-outline-primary" href="{{ root }}/shipments/differences"><i class="bi bi-arrow-left-right"></i> Różnice dostaw</a>{% endif %}
        </div>
    </div>
{% endblock %}

{% block content %}
