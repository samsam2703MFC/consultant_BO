APP_ENV=local

AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

DB_HOST="host.docker.internal"
DB_NAME=
DB_USER=
DB_PASS=

# VIESAPI.eu (sprawdzanie NIP UE) — zakładka "Klucze API"
VIESAPI_KEY_ID=
VIESAPI_KEY=

DISCORD_CRON_WEBHOOK_URL=

# Adresse publique de l'application, sans / final (ex. http://185.180.206.46/production).
# Vide : valeurs historiques de App/Core/config.php
APP_URL=
# API des franchisés et ressources (vide : valeurs historiques de App/Core/config.php)
APIPREFIXE=
ATELIER_RESOURCES_PREFIXE=
# Port MySQL si différent de 3306, et mode SQL imposé à la connexion
# (sur MySQL 8 : "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION",
# le mode de MariaDB 10.3 sous lequel l'ERP a été écrit)
DB_PORT=
DB_SQL_MODE=
# Serveur de test seulement : login du compte ouvert par un bouton « Entrer », sans mot de passe ERP
# (à n'utiliser que derrière un autre contrôle d'accès). Vide (par défaut) : login et mot de passe exigés.
ENTREE_LIBRE=

# Module « Gestion de production atelier » (API {API_BASE_URL}/api/v1/production)
# Secret de signature des jetons JWT (≥ 32 caractères, ex. openssl rand -hex 32). Vide : l'API répond 503.
PRODUCTION_JWT_SECRET=
# Adresse publique de l'API, sans / final (vide : APP_URL). Sert à la description OpenAPI.
API_BASE_URL=
# Origines autorisées à appeler l'API depuis un navigateur (PWA, tablettes), séparées par des virgules.
PRODUCTION_API_CORS_ORIGINS=
# Adresse publique du bucket Cloudflare R2 des photos (postes, produits). Si renseignée,
# une photo doit être un lien direct sous cette adresse.
R2_PUBLIC_BASE_URL=

# E-mails (module Komunikacja) : live = envoi réel ; redirect = tout vers MAIL_REDIRECT_TO (recette) ;
# log_only = rien ne part, les messages sont seulement enregistrés. Copies de test : log_only.
MAIL_DELIVERY_MODE=live
MAIL_REDIRECT_TO=
