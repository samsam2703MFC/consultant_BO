{# primes/primes.twig — « Mes primes » (14/10/2026) : une carte par prime (target, catégorie, promo, note Google) et sa récompense, en gris tant qu'elle n'est pas gagnée ; l'icône déposée par l'admin, sinon l'emoji ; le classement à la Strava dans un menu déroulant. Pas de texte d'explication. #}
{% extends "layouts/mobile_base.twig" %}
{% set active_nav = 'primes' %}
{% set T = translations %}
{% block title %}{{ T.my_bonuses ?? 'Mes primes' }}{% endblock %}
{% block head %}<link rel="stylesheet" href="{{ asset('assets/atelier/primes.css') }}">{% endblock %}
{% block page_title %}{{ T.my_bonuses ?? 'Mes primes' }}{% endblock %}
{% block page_subtitle %}{% if primes %}{{ primes.magasin.nom|replace({'Atelier by - ': ''}) }} · {{ mois(primes.m) }}{% if primes.enCours %}, {{ T.as_of ?? 'au' }} {{ jour }}{% endif %}{% endif %}{% endblock %}
{% block content %}
{% set p = primes %}
{% if not p or p.cartes is not defined %}
<div class="pr-card"><div class="pr-h"><h2>{{ T.my_bonuses ?? 'Mes primes' }}</h2></div>
  <div class="note">{{ T.unavailable ?? 'Les primes ne peuvent pas être lues pour le moment. Réessaie dans un instant.' }}{% if primesErreur %}<br><span class="mu" style="font-size:11px">{{ T.cockpit_said ?? 'Le cockpit a répondu :' }} {{ primesErreur }}</span>{% endif %}</div></div>
{% else %}
{% set eur = '€' %}
{% set pcs = T.pcs ?? 'pcs' %}
{% set rangPre = T.rank_prefix ?? '' %}{% set rangSuf = T.rank_suffix ?? 'e' %}
{# Les icônes déposées dans le cockpit vivent à côté de lui (public/uploads/primes) : PrimesService donne son adresse. #}
{% set ib = p.iconesBase ?? (ROOT ~ '/..') %}

{# ── Acquis, en jeu ── #}
{% set part = p.enJeu > 0 ? min(1, p.acquis / p.enJeu) : 0 %}
<div class="hx">
  <div class="l">
    <div><b>{{ p.acquis|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</b><small>{{ T.earned ?? 'acquis' }}</small></div>
    {% if p.enCours %}<div class="r"><b>{{ p.enJeu|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</b><small>{{ T.in_play ?? 'en jeu' }}</small></div>{% endif %}
  </div>
  {% if p.enCours %}<div class="bar"><i style="width:{{ (100 * part)|round(1) }}%"></i></div>{% endif %}
</div>

{# ── Une carte par prime ── #}
<div class="titre-section"><h2>{{ T.my_bonuses ?? 'Mes primes' }}</h2><small>{{ p.cartes|length }}</small></div>
{# Les primes fixes portent leur nom dans la langue de l'app ; les catégories et les promos, celui que l'admin leur donne. #}
{% set nomFixe = { croisees: T.cross_sales ?? null, record: T.beat_your_record ?? null, objectif: T.shop_target_title ?? null, google: T.google_rating ?? null, meilleure: T.best_seller ?? null } %}
{% for c in p.cartes %}
<div class="pp {{ c.etat == 'gagne' ? 'gagne' : (c.etat == 'tete' ? 'tete' : 'non') }}" data-carte="{{ c.cle }}">
  <div class="pp-h"><span class="emo">{% if c.icone ?? '' %}<img src="{{ ib }}/{{ c.icone }}" alt="">{% else %}{{ c.emo }}{% endif %}</span>
    <div class="t"><b>{{ nomFixe[c.cle] ?? c.lib }}{% if c.categorie ?? '' %} · {{ c.categorie }}{% endif %}</b><span class="typ {{ c.type }}">{{ attribute(T, 'type_' ~ c.type) ?? c.type }}</span></div>
    <span class="m">{% if c.gain > 0 and c.etat == 'gagne' %}+{{ c.gain|number_format(0, ',', ' ') }}{% else %}{{ c.montant|number_format(0, ',', ' ') }}{% endif %}&nbsp;{{ eur }}{% if c.max and c.gain <= 0 %}<small>max</small>{% endif %}</span>
  </div>
  <div class="pp-b">
    <span class="v">{% if c.val is null %}—{% elseif c.unite == 'pct' %}{{ c.val|number_format(0, ',', ' ') }}<small>%</small>{% elseif c.unite == 'pcs' %}{{ c.val|number_format(0, ',', ' ') }}<small>{{ pcs }}</small>{% elseif c.unite == 'score' %}{{ c.val|number_format(0, ',', ' ') }}<small>{{ T.score ?? 'score' }}</small>{% elseif c.unite == 'note' %}{{ c.val|number_format(1, ',', ' ') }}<small>★</small>{% else %}{{ c.val|number_format(2, ',', ' ') }}{% endif %}</span>
    <div class="jg"><i style="width:{{ c.jauge ?? 0 }}%"></i>{% if c.repere is defined and c.repere is not null %}<span class="c" style="left:{{ c.repere }}%"></span>{% endif %}</div>
    {% if c.etat == 'gagne' %}<span class="etat ok">✓ {{ T.won ?? 'gagné' }}</span>
    {% elseif c.etat == 'tete' %}<span class="etat or">👑 {{ T.first_abbr ?? '1re' }}</span>
    {% elseif c.etat == 'rang' %}<span class="etat mu">{{ rangPre }}{{ c.rang }}{{ rangSuf }} / {{ c.sur }}</span>
    {% elseif c.etat == 'att' and c.ecart is not null %}<span class="etat att">−{{ c.ecart|number_format(c.unite == 'lpt' ? 2 : (c.unite == 'note' ? 1 : 0), ',', ' ') }}{{ c.unite == 'pct' ? ' pt' : (c.unite == 'pcs' ? ' ' ~ pcs : (c.unite == 'note' ? ' ★' : '')) }}</span>
    {% else %}<span class="etat mu">—</span>{% endif %}
  </div>
  <div class="pp-p">
    {% if c.motif == 'pas_compte' %}{{ T.not_counted ?? 'pas encore compté' }}
    {% elseif c.motif == 'pas_objectif' %}{{ T.no_target_short ?? 'pas d’objectif' }}
    {% elseif c.motif == 'pas_note' %}{{ T.no_rating ?? 'pas de note Google' }}
    {% elseif c.motif == 'heures' %}{{ T.below ?? 'sous' }} {{ c.heuresMin }}&nbsp;h
    {% elseif c.motif == 'pas_classee' %}{{ T.not_ranked ?? 'pas classée' }}
    {% elseif c.motif == 'pas_record' %}{{ T.no_record_short ?? 'pas encore de record' }}
    {% elseif c.type == 'target' %}{{ T.target ?? 'cible' }} <b>{% if c.unite == 'pct' %}{{ c.cible|number_format(0, ',', ' ') }}&nbsp;%{% elseif c.unite == 'note' %}{{ c.cible|number_format(1, ',', ' ') }}&nbsp;★{% else %}{{ c.cible|number_format(2, ',', ' ') }}{% endif %}</b>{% if c.cle == 'record' %} · {{ T.record ?? 'record' }} {{ c.record|number_format(2, ',', ' ') }}{% elseif c.cle == 'objectif' and c.projete %} · {{ T.projected ?? 'projeté' }}{% elseif c.motif == 'min_tickets' %} · {{ c.minTickets }} {{ T.tickets ?? 'tickets' }} min.{% endif %}
    {% elseif c.premier %}{% set q1 = c.premier.q|number_format(0, ',', ' ') %}
      {% if c.premier.moi and c.second %}{{ rangPre }}2{{ rangSuf }} · <b>{{ c.second.nom }}</b> {{ c.second.q|number_format(0, ',', ' ') }}{% elseif not c.premier.moi %}👑 <b>{{ c.premier.nom }}</b> {{ q1 }}{% endif %}{% if c.etat == 'att' and c.minPieces is defined %} · {{ c.minPieces }} {{ pcs }} min.{% endif %}
    {% elseif c.minPieces is defined %}{{ c.minPieces }} {{ pcs }} min.{% endif %}
  </div>
</div>
{% endfor %}

{# ── Le classement, à la Strava : un menu déroulant, mon magasin ou le réseau ── #}
{% set cls = p.classements ?? [] %}
{% if cls|length %}
{% set c0 = cls|first %}
<div class="titre-section" id="classement"><h2>{{ T.leaderboard ?? 'Classement' }}</h2><small>{{ mois(p.m) }}</small></div>
<div class="dd" data-cl-dd>
  <span class="emo" data-cl-emo>{% if c0.icone ?? '' %}<img src="{{ ib }}/{{ c0.icone }}" alt="">{% else %}{{ c0.emo ?? '👑' }}{% endif %}</span>
  <div class="t"><b data-cl-lib>{{ nomFixe[c0.cle] ?? c0.lib }}{% if c0.categorie ?? '' %} · {{ c0.categorie }}{% endif %}</b><span class="typ {{ c0.type }}" data-cl-typ>{{ attribute(T, 'type_' ~ c0.type) ?? c0.type }}</span></div>
  <i class="bi bi-chevron-down"></i>
  <select data-cl-choix aria-label="{{ T.leaderboard ?? 'Classement' }}">
    {% for x in cls %}<option value="{{ x.cle }}" data-emo="{{ x.emo ?? '👑' }}" data-icone="{{ (x.icone ?? '') ? ib ~ '/' ~ x.icone : '' }}" data-type="{{ x.type }}" data-typ="{{ attribute(T, 'type_' ~ x.type) ?? x.type }}">{{ nomFixe[x.cle] ?? x.lib }}{% if x.categorie ?? '' %} · {{ x.categorie }}{% endif %}</option>{% endfor %}
  </select>
</div>
<div class="cl-carte" data-classements>
  <div class="cl-tog"><span class="on" data-cl-niv="magasin">{{ T.my_shop_short ?? 'Mon magasin' }}</span><span data-cl-niv="reseau">{{ T.network ?? 'Réseau' }}</span></div>
  {% for x in cls %}{% for niv in ['magasin', 'reseau'] %}
  {% set liste = attribute(x, niv) %}
  {% set champ = x.unite == 'pieces' ? 'pieces' : 'taux' %}
  <div class="cl-liste {{ loop.parent.loop.first and niv == 'magasin' ? 'on' }}" data-cl="{{ x.cle }}:{{ niv }}">
    {% if liste|length %}
    {% set podium = liste|filter(r => r.rang <= 3) %}
    {% if podium|length %}
    <div class="podium">
      {% for place in [2, 1, 3] %}{% set r = (podium|filter(z => z.rang == place))|first %}
      {% if r %}
      <div class="pod p{{ place }}{{ r.moi ? ' moi' }}">
        {% if place == 1 %}<span class="cr">👑</span>{% endif %}
        <span class="av {{ r.moi ? 'moi' : 't' ~ (r.nom|length % 8) }}">{% if r.moi %}<i class="bi bi-person-fill"></i>{% else %}{{ r.nom|first|upper }}{% endif %}</span>
        <b>{{ r.moi ? (T.you_short ?? 'Toi') : r.nom }}</b>{% if niv == 'reseau' %}<small>{{ r.lieu }}</small>{% endif %}
        <div class="q">{% if champ == 'pieces' %}{{ r.pieces|number_format(0, ',', ' ') }}<small> {{ pcs }}</small>{% else %}{{ r.taux|number_format(0, ',', ' ') }}<small> %</small>{% endif %}</div>
        <div class="socle">{{ place }}</div>
      </div>
      {% else %}<div class="pod p{{ place }} vide"></div>{% endif %}
      {% endfor %}
    </div>
    {% endif %}
    {% set prec = 3 %}
    {% for r in liste|filter(z => z.rang > 3) %}
    {% if r.rang > prec + 1 %}<div class="cl-row ecart">···</div>{% endif %}{% set prec = r.rang %}
    <div class="cl-row {{ r.moi ? 'moi' }}"><span class="r">{{ r.rang }}</span>
      <span class="av {{ r.moi ? 'moi' : 't' ~ (r.nom|length % 8) }}">{% if r.moi %}<i class="bi bi-person-fill"></i>{% else %}{{ r.nom|first|upper }}{% endif %}</span>
      <span class="nom">{{ r.moi ? (T.you_short ?? 'Toi') : r.nom }}{% if niv == 'reseau' %}<span class="mag">· {{ r.lieu }}</span>{% endif %}</span>
      <span class="val">{% if champ == 'pieces' %}{{ r.pieces|number_format(0, ',', ' ') }}<small>{{ pcs }}</small>{% else %}{{ r.taux|number_format(1, ',', ' ') }}&nbsp;%<small>{{ r.croisees }}/{{ r.tickets }}</small>{% endif %}</span></div>
    {% endfor %}
    {% else %}<div class="note">{{ T.lb_empty ?? 'Personne n’est encore classée ce mois-ci.' }}</div>{% endif %}
  </div>
  {% endfor %}{% endfor %}
</div>
{% endif %}
{% endif %}
{% endblock %}
{% block scripts %}
<script>
(function () {
  var bloc = document.querySelector('[data-classements]'); if (!bloc) { return; }
  var choix = document.querySelector('[data-cl-choix]');
  var cat = choix.value, niv = 'magasin';
  function montre() {
    bloc.querySelectorAll('[data-cl]').forEach(function (l) { l.classList.toggle('on', l.dataset.cl === cat + ':' + niv); });
    bloc.querySelectorAll('[data-cl-niv]').forEach(function (c) { c.classList.toggle('on', c.dataset.clNiv === niv); });
    var o = choix.options[choix.selectedIndex];
    document.querySelector('[data-cl-lib]').textContent = o.text;
    var e = document.querySelector('[data-cl-emo]'); e.textContent = '';
    if (o.dataset.icone) { var im = document.createElement('img'); im.src = o.dataset.icone; im.alt = ''; e.appendChild(im); } else { e.textContent = o.dataset.emo; }
    var t = document.querySelector('[data-cl-typ]'); t.textContent = o.dataset.typ; t.className = 'typ ' + o.dataset.type;
  }
  choix.addEventListener('change', function () { cat = choix.value; montre(); });
  bloc.querySelectorAll('[data-cl-niv]').forEach(function (c) { c.addEventListener('click', function () { niv = c.dataset.clNiv; montre(); }); });
  // Une carte avec un classement ouvre le sien.
  document.querySelectorAll('[data-carte]').forEach(function (k) {
    var cle = k.dataset.carte;
    if (!choix.querySelector('option[value="' + cle + '"]')) { return; }
    k.classList.add('cliquable');
    k.addEventListener('click', function () { choix.value = cle; cat = cle; montre(); document.getElementById('classement').scrollIntoView({ behavior: 'smooth' }); });
  });
})();
</script>
{% endblock %}
