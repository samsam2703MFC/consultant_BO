{# primes/primes.twig — « Mes primes » (23/10/2026) : tournée vers la motivation — combien est encore en jeu, comment y arriver (le plan,
   PrimesPlan), où tu en es (chaque prime) — dans une forme sobre, façon iOS : la police du système, des listes groupées, une seule
   couleur, des icônes au trait à la place des émojis (une icône déposée par l'admin reste). Avant, le 16/10/2026 : les targets et les catégories une par ligne, en drapeau (la barre, le trait de l'objectif, la récompense dessus), qui se déroulent sur leur détail ; les promos en carrés deux par ligne ; chaque carré a sa récompense, une demi-jauge (où elle en est aujourd'hui, l'objectif à atteindre) et son état, en gris tant qu'elle n'est pas gagnée ; l'icône déposée par l'admin, sinon l'emoji ; le classement à la Strava dans un menu qui monte du bas. #}
{% extends "layouts/mobile_base.twig" %}
{% set active_nav = 'primes' %}
{% set T = translations %}
{% block title %}{{ T.my_bonuses ?? 'Mes primes' }}{% endblock %}
{% block head %}<link rel="stylesheet" href="{{ asset('assets/atelier/primes.css') }}">{% endblock %}
{% block page_title %}{{ T.my_bonuses ?? 'Mes primes' }}{% endblock %}
{% block page_subtitle %}{% endblock %}
{% block content %}
{% set p = primes %}
{% if not p or p.cartes is not defined %}
<div class="pr-card"><div class="pr-h"><h2>{{ T.my_bonuses ?? 'Mes primes' }}</h2></div>
  <div class="note">{{ T.unavailable ?? 'Les primes ne peuvent pas être lues pour le moment. Réessaie dans un instant.' }}{% if primesErreur %}<br><span class="mu" style="font-size:11px">{{ T.cockpit_said ?? 'Le cockpit a répondu :' }} {{ primesErreur }}</span>{% endif %}</div></div>
{% else %}
{% set eur = '€' %}
{% set pcs = T.pcs ?? 'pcs' %}
{% set rangPre = T.rank_prefix ?? '' %}{% set rangSuf = T.rank_suffix ?? 'e' %}
{# Les icônes déposées dans le cockpit vivent à côté de lui (public/uploads/primes) : PrimesService donne son adresse. #}
{% set ib = p.iconesBase ?? (ROOT ~ '/..') %}

{# ── Le mois (16/10/2026) : une flèche à gauche, le mois au centre, une flèche à droite ; douze mois en arrière au
   plus, trois mois à venir (les primes prévues). ── #}
{% set mCour = 'now'|date('Y-m') %}
{% set mPrec = (p.m ~ '-01')|date_modify('-1 month')|date('Y-m') %}
{% set mSuiv = (p.m ~ '-01')|date_modify('+1 month')|date('Y-m') %}
{% set mMin = ('now'|date('Y-m') ~ '-01')|date_modify('-12 months')|date('Y-m') %}
{% set mMax = ('now'|date('Y-m') ~ '-01')|date_modify('+3 months')|date('Y-m') %}
<nav class="mois-sel" aria-label="{{ T.month ?? 'Mois' }}" data-mois>
  {% if mPrec >= mMin %}<a class="ms-f" href="{{ ROOT }}/primes?m={{ mPrec }}" aria-label="{{ T.prev_month ?? 'Mois précédent' }}"><i class="bi bi-chevron-left"></i></a>
  {% else %}<span class="ms-f off" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>{% endif %}
  <div class="ms-l"><b>{{ mois(p.m)|capitalize }}</b>{% if p.enCours %}<small>{{ T.in_progress ?? 'en cours' }} · {{ T.as_of ?? 'au' }} {{ jour }}</small>{% elseif p.aVenir ?? false %}<small>{{ T.upcoming ?? 'à venir' }}</small>{% endif %}</div>
  {% if mSuiv <= mMax %}<a class="ms-f" href="{{ ROOT }}/primes{{ mSuiv != mCour ? '?m=' ~ mSuiv }}" aria-label="{{ T.next_month ?? 'Mois suivant' }}"><i class="bi bi-chevron-right"></i></a>
  {% else %}<span class="ms-f off" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>{% endif %}
</nav>

{% if p.aVenir ?? false %}
{# ── Un mois à venir (16/10/2026) : les primes prévues, leur récompense, leur règle, leur objectif ; rien de compté. ── #}
{% set eur = '€' %}{% set pcs = T.pcs ?? 'pcs' %}
{% set nomFixe = { croisees: T.cross_sales ?? null, record: T.beat_your_record ?? null, objectif: T.shop_target_title ?? null, google: T.google_rating ?? null, meilleure: T.best_seller ?? null } %}
<section class="sb-heros"><p class="sb-sur">{{ (T.in_play_in ?? 'En jeu en {m}')|replace({'{m}': mois(p.m)|split(' ')|first}) }}</p><p class="sb-chiffre">{{ p.enJeu|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</p></section>
<div class="pl-vide av"><i class="bi bi-calendar-event"></i><div><b>{{ T.upcoming_title ?? 'Les primes prévues ce mois-là' }}</b>
  <span>{{ T.upcoming_text ?? 'Ce que tu pourras gagner. Le compteur démarre le premier jour du mois.' }}</span></div></div>
{% for g in [
  { cle: 'targets', titre: T.section_targets ?? 'Targets', liste: p.cartes|filter(c => c.type == 'target' or c.type == 'classement') },
  { cle: 'promos', titre: T.section_promos ?? 'Promos', liste: p.cartes|filter(c => c.type == 'promo') }]|filter(g => g.liste|length) %}
{% set max = 0 %}{% for c in g.liste %}{% set max = max + c.montant %}{% endfor %}
<div class="titre-section" data-section="{{ g.cle }}"><h2>{{ g.titre }}</h2><small>{% if max == 0 and g.liste|filter(c => c.cadeau ?? null)|length %}<i class="bi bi-gift"></i>{% else %}{{ T.up_to ?? 'jusqu’à' }} {{ max|number_format(0, ',', ' ') }}&nbsp;{{ eur }}{% endif %}</small></div>
<div class="pl-liste">
{% for c in g.liste %}
{% set u = c.unite %}{% set dec = u == 'note' ? 1 : 0 %}
{% set suf = u == 'pct' ? ' %' : (u == 'pcs' ? ' ' ~ pcs : (u == 'note' ? ' ★' : '')) %}
{% set n = c.objectif is not null ? c.objectif|number_format(dec, ',', ' ') : '' %}
<div class="pl av" data-carte="{{ c.cle }}">
  <div class="pl-b">
    <div class="pl-h">
      <span class="emo">{{ _self.ic(c, ib) }}</span>
      <b class="pl-t">{{ nomFixe[c.cle] ?? c.lib }}</b>
      <span class="pl-v">{% if c.cadeau ?? null %}<i class="bi bi-gift"></i><small>{{ c.cadeau.nom }}</small>{% else %}{{ c.montant|number_format(0, ',', ' ') }}<small>{{ eur }}{{ c.max ? ' max' }}</small>{% endif %}</span>
    </div>
    <div class="pl-s">
      <span class="mu">
      {%- if c.regle == 'magasin' %}{{ (T.rule_shop ?? 'le magasin : objectif {n} {u}')|replace({'{n}': n, '{u}': pcs}) }}
      {%- elseif c.regle == 'vendeuse' %}{{ (T.rule_mine ?? 'ton objectif : {n} {u}')|replace({'{n}': n, '{u}': pcs}) }}
      {%- elseif c.regle == 'seuil' %}{{ (T.rule_threshold ?? 'chacune dès {n} {u}')|replace({'{n}': n, '{u}': pcs}) }}
      {%- elseif c.regle == 'premiere' %}{{ T.rule_first ?? 'la 1re du magasin gagne' }}
      {%- elseif c.objectif is not null %}{{ T.goal_lower ?? 'objectif' }} {{ n }}{{ suf }}
      {%- endif -%}
      </span>
      {% if c.du or c.au %}<span>{{ (T.dates_from_to ?? 'du {du} au {au}')|replace({'{du}': c.du ? c.du|date('d/m') : '…', '{au}': c.au ? c.au|date('d/m') : '…'}) }}</span>{% endif %}
    </div>
  </div>
</div>
{% endfor %}
</div>
{% endfor %}
{% else %}
{# ── Combien : ce qui est encore en jeu ce mois-ci, ce qui est déjà gagné, le temps qu'il reste (23/10/2026). ── #}
{% set part = p.enJeu > 0 ? min(1, p.acquis / p.enJeu) : 0 %}
{% set encore = max(0, p.enJeu - p.acquis) %}
<section class="sb-heros">
  {% if p.enCours and encore > 0 %}
  <p class="sb-sur">{{ T.still_in_play ?? 'Encore en jeu ce mois-ci' }}</p>
  <p class="sb-chiffre">+{{ encore|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</p>
  <div class="sb-barre grande"><i style="width:{{ (100 * part)|round(1) }}%"></i></div>
  <p class="sb-sous"><b>{{ p.acquis|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</b> {{ T.won_so_far ?? 'déjà gagnés' }} · {{ p.enJeu|number_format(0, ',', ' ') }}&nbsp;{{ eur }} {{ T.in_play ?? 'en jeu' }}</p>
  {% elseif p.enCours %}
  <p class="sb-sur">{{ T.my_month ?? 'Mon mois' }}</p>
  <p class="sb-chiffre">{{ p.acquis|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</p>
  <p class="sb-sous">{{ p.acquis > 0 ? (T.all_won ?? 'Tout ce qui est en jeu est gagné : garde le rythme jusqu’à la fin du mois.') : (T.counters_start ?? 'Tes compteurs démarrent avec tes premiers tickets du mois : chaque vente compte.') }}</p>
  {% else %}
  <p class="sb-sur">{{ (T.you_won_in ?? 'En {m}, tu as gagné')|replace({'{m}': mois(p.m)|split(' ')|first}) }}</p>
  <p class="sb-chiffre">{{ p.acquis|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</p>
  {% endif %}
  {% if p.enCours and heuresRestantes %}<p class="sb-pied">{{ (T.hours_left_short ?? '{h} h de service restantes ce mois-ci')|replace({'{h}': heuresRestantes|number_format(1, ',', ' ')|replace({',0': ''})}) }}</p>{% endif %}
</section>

{% if p.cartes|filter(c => c.motif == 'sans_vente')|length %}
<div class="pl-vide"><i class="bi bi-receipt"></i><div><b>{{ T.no_sale_title ?? 'Aucune vente à ton nom ce mois-ci' }}</b>
  <span>{{ T.no_sale_text ?? 'Tes primes à toi (ventes croisées, record, classements) s’affichent dès ton premier ticket encaissé à ton nom. Le magasin et la note Google, eux, comptent déjà.' }}</span></div></div>
{% endif %}

{# ── Comment y arriver (23/10/2026) : les primes encore à aller chercher, la plus proche d'abord ; une ligne mène à sa prime. ── #}
{% set aPortee = (plan ?? [])|filter(e => not e.horsPortee) %}
{% if aPortee|length %}
<h2 class="sb-titre">{{ T.how_to_get_there ?? 'Comment y arriver' }}</h2>
<div class="sb-groupe">
  {% for e in aPortee %}{% include "components/primes_etape.twig" with { e: e, T: T, ib: ib, lien: '#prime-' ~ e.cle } only %}{% endfor %}
</div>
{% endif %}

{# ── Où tu en es : les primes, une par ligne (23/10/2026 : les promos aussi, plus de carrés), qui se déroulent sur leur détail. ── #}
<h2 class="sb-titre">{{ T.where_you_are ?? 'Où tu en es' }}</h2>
{# Les primes fixes portent leur nom dans la langue de l'app ; les catégories et les promos, celui que l'admin leur donne. #}
{% set nomFixe = { croisees: T.cross_sales ?? null, record: T.beat_your_record ?? null, objectif: T.shop_target_title ?? null, google: T.google_rating ?? null, meilleure: T.best_seller ?? null } %}
{# Catégories : la section est retirée de la page (16/10/2026, à la demande) ; leurs classements restent dans le
   Classement plus bas. Pour la remettre, dans groupes, entre targets et promos :
   { cle: 'categories', titre: T.section_categories ?? 'Catégories', liste: p.cartes|filter(c => c.type == 'categorie') }, #}
{% set groupes = [
  { cle: 'targets', titre: T.section_targets ?? 'Targets', liste: p.cartes|filter(c => c.type == 'target' or c.type == 'classement') },
  { cle: 'promos', titre: T.section_promos ?? 'Promos', liste: p.cartes|filter(c => c.type == 'promo') },
] %}
{# Les targets et les catégories (16/10/2026) : une par ligne, en drapeau ; toucher la ligne déroule son détail. #}
{% set b = p.briques %}{% set pm = p.prime %}{% set a = p.aujourdhui ?? null %}
{% set aCl = (p.classements ?? [])|map(x => x.cle) %}
{% for g in groupes|filter(g => g.liste|length) %}
{% set ligne = true %}
{% set max = 0 %}{% for c in g.liste %}{% set max = max + max(c.montant, c.gain) %}{% endfor %}
<div class="titre-section" data-section="{{ g.cle }}"><h2>{{ g.titre }}</h2><small>{% if max == 0 and g.liste|filter(c => c.cadeau ?? null)|length %}<i class="bi bi-gift"></i>{% else %}{% if p.enCours %}{{ T.up_to ?? 'jusqu’à' }} {% endif %}{{ max|number_format(0, ',', ' ') }}&nbsp;{{ eur }}{% endif %}</small></div>
<div class="{{ ligne ? 'pl-liste' : 'pq-grille' }}">
{% for c in g.liste %}
{% set enJour = c.cle == 'objectif' and (c.jour ?? null) %}
{% set v = enJour ? c.aDate : c.val %}
{% set u = c.unite %}
{% set dec = u == 'lpt' ? 2 : (u == 'note' ? 1 : 0) %}
{% set suf = u == 'pct' ? ' %' : (u == 'pcs' ? ' ' ~ pcs : (u == 'note' ? ' ★' : '')) %}
{% if ligne %}
{# Le drapeau (16/10/2026, maquette B) : la valeur en haut à droite ; une barre, le trait noir de l'objectif (toujours
   au même endroit) et la récompense posée dessus ; la passer active la prime (vert). En couleur d'office. #}
{% set ok = c.actif ?? false %}
{# La meilleure vendeuse se mesure en euros par heure (23/10/2026) : son score est le CA par heure pondéré (src/ventes.php). #}
{% set uc = u == 'pct' ? '%' : (u == 'note' ? '★' : (u == 'score' ? eur ~ '/h' : (u == 'pcs' ? pcs : ''))) %}
{% set ue = u == 'pct' ? ' ' ~ (T.pts ?? 'pts') : (u == 'score' ? ' ' ~ eur ~ '/h' : (u == 'note' ? ' ★' : '')) %}
<div class="pl{{ ok ? ' ok' }}" data-carte="{{ c.cle }}" id="prime-{{ c.cle }}">
  <div class="pl-b" role="button" tabindex="0" aria-expanded="false" aria-controls="pd-{{ c.cle }}" data-pl>
    <div class="pl-h">
      <span class="emo">{{ _self.ic(c, ib) }}</span>
      <b class="pl-t">{{ nomFixe[c.cle] ?? c.lib }}</b>
      <span class="pl-v">{% if v is null %}—{% else %}{{ v|number_format(dec, ',', ' ') }}{% if uc %}<small>{{ uc }}</small>{% endif %}{% endif %}</span>
      <i class="bi bi-chevron-down chev" aria-hidden="true"></i>
    </div>
    {# La meilleure vendeuse (23/10/2026) : une jauge dont le bout est la 1re du magasin (son initiale) et le point la
       vendeuse, la récompense posée au bout. Elle en tête : le point arrive au bout, en vert. #}
    {% set mvPremier = c.cle == 'meilleure' and v is not null ? (c.premier ?? null) : null %}
    {% if mvPremier %}
    {% set mvFin = max(mvPremier.q, v) %}{% set mvPos = mvFin > 0 ? min(100, 100 * v / mvFin) : 0 %}
    <div class="pl-mv{{ mvPremier.moi ? ' un' }}" aria-hidden="true"><i style="width:{{ mvPos|round(1) }}%"></i>
      {% if not mvPremier.moi %}<span class="bout">{{ mvPremier.nom|first|upper }}</span>{% endif %}
      <span class="pt" style="left:{{ mvPos|round(1) }}%"></span>
      <span class="fl">{{ ok ? '✓ ' }}{{ (ok and c.gain > 0 ? c.gain : c.montant)|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</span></div>
    {% elseif c.barre is not null %}
    <div class="pl-j" aria-hidden="true"><i style="width:{{ c.barre }}%"></i>{% if c.barreJour is not null %}<span class="jr" style="left:{{ c.barreJour }}%"></span>{% endif %}<span class="ob"></span>
      <span class="fl">{{ ok ? '✓ ' }}{{ (ok and c.gain > 0 ? c.gain : c.montant)|number_format(0, ',', ' ') }}&nbsp;{{ eur }}{% if c.max and not ok %} max{% endif %}</span></div>
    {% endif %}
    <div class="pl-s">
      <span class="{{ ok ? 'ok' : (c.motif ? 'mu') }}">
      {%- if c.motif in ['pas_compte', 'sans_vente', 'pas_objectif', 'pas_note', 'pas_classee', 'pas_record'] %}
        {%- if c.motif == 'pas_compte' %}{{ T.not_counted ?? 'pas encore compté' }}{% elseif c.motif == 'sans_vente' %}{{ T.no_sale_short ?? 'aucune vente à ton nom' }}{% elseif c.motif == 'pas_objectif' %}{{ T.no_target_short ?? 'pas d’objectif' }}{% elseif c.motif == 'pas_note' %}{{ T.no_rating ?? 'pas de note Google' }}{% elseif c.motif == 'pas_classee' %}{{ T.not_ranked ?? 'pas classée' }}{% else %}{{ T.no_record_short ?? 'pas encore de record' }}{% endif %}
      {%- elseif c.type == 'categorie' %}<b class="rg">{{ c.rang == 1 ? (T.first_abbr ?? '1re') : (c.rang ? rangPre ~ c.rang ~ rangSuf : (T.not_ranked ?? 'pas classée')) }}{% if c.rang and c.sur %} / {{ c.sur }}{% endif %}</b> ·
        {% if c.pour1 is not null %}{{ p.enCours ? (T.still ?? 'encore') ~ ' ' ~ c.pour1 ~ ' ' ~ pcs ~ ' ' ~ (T.to_be_first ?? 'pour être 1re') : (T.short_of_first ?? 'à {n} {u} de la 1re')|replace({'{n}': c.pour1, '{u}': pcs}) }}{% elseif c.avance1 is not null %}+{{ c.avance1 }} {{ pcs }} {{ T.lead_short ?? 'd’avance' }}{% else %}{{ T.first_alone ?? '1re, seule en lice' }}{% endif %}
      {%- elseif ok %}✓ {{ T.activated ?? 'Prime activée' }}
      {%- elseif c.motif == 'heures' %}{{ T.below ?? 'sous' }} {{ c.heuresMin }}&nbsp;h
      {%- elseif c.motif == 'min_tickets' %}{{ c.minTickets }} {{ T.tickets ?? 'tickets' }} min.
      {%- elseif enJour %}<b class="{{ c.val is not null and c.val >= c.cible ? 'okp' }}">{{ T.proj_short ?? 'proj.' }} {{ (c.val ?? 0)|number_format(0, ',', ' ') }}&nbsp;%</b> · <span class="jr-l"></span>{{ T.day_prefix ?? 'J' }}{{ c.jour }} : {{ c.cibleJour|number_format(0, ',', ' ') }}&nbsp;%
      {%- elseif v is not null and c.repereVal is not null and c.repereVal > v %}{{ p.enCours ? (T.still ?? 'encore') : (T.was_missing ?? 'il manquait') }} {{ (c.repereVal - v)|number_format(dec, ',', ' ') }}{{ ue }}
      {%- endif -%}
      </span>
      {% if c.type == 'categorie' %}<span>{% if c.premier and not c.premier.moi %}{{ T.first_abbr ?? '1re' }} {{ c.premier.nom }} {{ c.premier.q|number_format(0, ',', ' ') }}{% elseif c.second %}{{ rangPre }}2{{ rangSuf }} {{ c.second.nom }} {{ c.second.q|number_format(0, ',', ' ') }}{% endif %}</span>
      {% elseif mvPremier %}<span>{% if not mvPremier.moi %}{{ T.first_abbr ?? '1re' }} {{ mvPremier.nom }} {{ mvPremier.q|number_format(0, ',', ' ') }}&nbsp;{{ eur }}/h{% elseif c.second ?? null %}{{ rangPre }}2{{ rangSuf }} {{ c.second.nom }} {{ c.second.q|number_format(0, ',', ' ') }}&nbsp;{{ eur }}/h{% endif %}</span>
      {% elseif (c.regle ?? '') == 'magasin' and (c.moiPcs ?? null) is not null %}<span>{{ T.of_which_you ?? 'dont toi' }} {{ c.moiPcs|number_format(0, ',', ' ') }} {{ pcs }}</span>
      {% elseif c.repereVal is not null %}<span>{{ c.repereType == 'garder' ? (T.keep_first_short ?? 'garder la 1re') : (T.goal_lower ?? 'objectif') }} {{ c.repereVal|number_format(dec, ',', ' ') }}{{ u == 'score' ? ' ' ~ eur ~ '/h' : suf }}</span>{% endif %}
    </div>
  </div>
  <div class="pl-d" id="pd-{{ c.cle }}" hidden>
    {{ _self.infos(c, T, ib) }}
    <dl class="pl-l">
    {% if c.cle == 'croisees' %}{% set cr = b.croisees %}
      <div><dt>{{ T.d_my_rate ?? 'Ton taux ce mois' }}</dt><dd>{% if cr.taux is not null %}{{ cr.taux|number_format(1, ',', ' ') }}&nbsp;%{% else %}—{% endif %}<small>{{ cr.croisees ?? 0 }} / {{ cr.tickets ?? 0 }} {{ T.tickets ?? 'tickets' }}</small></dd></div>
      <div><dt>{{ T.d_target ?? 'Cible' }}</dt><dd>{{ cr.cible|number_format(0, ',', ' ') }}&nbsp;%</dd></div>
      {% if p.enCours and a and a.tickets > 0 %}<div><dt>{{ T.today ?? 'Aujourd’hui' }}</dt><dd>{% if a.taux is not null %}{{ a.taux|number_format(1, ',', ' ') }}&nbsp;%{% else %}—{% endif %}<small>{{ a.croisees }} / {{ a.tickets }} {{ T.tickets ?? 'tickets' }}</small></dd></div>{% endif %}
      {% if c.categorie ?? '' %}<div><dt>{{ T.d_category ?? 'Catégorie comptée' }}</dt><dd>{{ c.categorie }}</dd></div>{% endif %}
      {# Un seul palier : la récompense ; plusieurs : ce que rapporte chaque cran au-dessus de la cible. #}
      {% set pals = cr.paliers ?? [] %}
      {% if pals|length > 1 %}{% for pal in pals %}<div><dt>{{ T.d_target ?? 'Cible' }}{{ pal.plus > 0 ? ' + ' ~ pal.plus ~ ' pts' }}</dt><dd>{{ pal.m|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</dd></div>{% endfor %}
      {% else %}<div><dt>{{ T.d_reward ?? 'Récompense' }}</dt><dd>{{ c.montant|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</dd></div>{% endif %}
      {% if cr.minTickets %}<div><dt>{{ T.d_condition ?? 'Condition' }}</dt><dd>{{ cr.minTickets }} {{ T.d_min_tickets ?? 'tickets min. dans le mois' }}</dd></div>{% endif %}
    </dl><p class="pl-n">{{ T.cross_how ?? 'Un ticket avec 2 articles ou plus. Dépasse la cible du magasin : chaque palier rapporte.' }}</p>
    {% elseif c.cle == 'record' %}{% set rc = b.record %}
      <div><dt>{{ T.d_lpt_month ?? 'Tes lignes par ticket ce mois' }}</dt><dd>{{ rc.lt is not null ? rc.lt|number_format(2, ',', ' ') : '—' }}</dd></div>
      <div><dt>{{ T.d_my_record ?? 'Ton record' }}</dt><dd>{{ rc.record is not null ? rc.record|number_format(2, ',', ' ') : '—' }}{% if rc.recordMois ?? '' %}<small>{{ rc.recordMois }}</small>{% endif %}</dd></div>
      {% if c.cible is not null %}<div><dt>{{ T.goal ?? 'Objectif' }}</dt><dd>{{ c.cible|number_format(2, ',', ' ') }}</dd></div>{% endif %}
      <div><dt>{{ T.d_reward ?? 'Récompense' }}</dt><dd>{{ rc.eurDixieme ?? 0 }}&nbsp;{{ eur }} {{ T.per_tenth ?? 'par dixième' }}<small>{{ T.d_up_to ?? 'jusqu’à' }} {{ c.montant|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</small></dd></div>
      {% if rc.minTickets ?? 0 %}<div><dt>{{ T.d_condition ?? 'Condition' }}</dt><dd>{{ rc.minTickets }} {{ T.d_min_tickets ?? 'tickets min. dans le mois' }}</dd></div>{% endif %}
    </dl>
    {% elseif c.cle == 'objectif' %}
      {% if pm.objectif ?? null %}<div><dt>{{ T.d_shop_revenue ?? 'CA du magasin' }}</dt><dd>{{ pm.ca|number_format(0, ',', ' ') }}&nbsp;{{ eur }}<small>{{ T.out_of ?? 'sur' }} {{ pm.objectif|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</small></dd></div>{% endif %}
      {% if c.jour ?? null %}<div><dt>{{ T.day_prefix ?? 'J' }}{{ c.jour }}</dt><dd class="{{ c.avance >= 0 ? 'ok' : 'att' }}">{{ c.aDate|number_format(1, ',', ' ') }}&nbsp;%<small>{{ T.d_should_be ?? 'il faudrait' }} {{ c.cibleJour|number_format(1, ',', ' ') }}&nbsp;%</small></dd></div>{% endif %}
      {% if pm.projection ?? null %}<div><dt>{{ T.d_month_end ?? 'Fin de mois, au rythme actuel' }}</dt><dd>{{ pm.projection|number_format(0, ',', ' ') }}&nbsp;{{ eur }}<small>{{ pm.atteinteProj|number_format(1, ',', ' ') }}&nbsp;%</small></dd></div>{% endif %}
      {% for pal in pm.paliers ?? [] %}<div><dt>{{ pal.pct }}&nbsp;% · {{ pal.vous|number_format(0, ',', ' ') }}&nbsp;{{ eur }} {{ T.d_for_you ?? 'pour toi' }}</dt><dd class="{{ pal.atteint ? 'ok' }}">{% if pal.atteint %}✓ {{ T.reached ?? 'atteint' }}{% else %}{{ T.d_missing ?? 'manque' }} {{ pal.manque|number_format(0, ',', ' ') }}&nbsp;{{ eur }}{% if pal.parJour %}<small>{{ pal.parJour|number_format(0, ',', ' ') }}&nbsp;{{ eur }} {{ T.per_day ?? 'par jour' }}</small>{% endif %}{% endif %}</dd></div>{% endfor %}
    </dl>
    {% elseif c.cle == 'google' %}{% set go = p.google %}
      <div><dt>{{ T.d_shop_rating ?? 'Note du magasin' }}</dt><dd>{{ go.note is not null ? go.note|number_format(1, ',', ' ') ~ ' ★' : '—' }}{% if go.avis %}<small>{{ go.avis }} {{ T.d_reviews ?? 'avis' }}</small>{% endif %}</dd></div>
      <div><dt>{{ T.d_threshold ?? 'Seuil' }}</dt><dd>{{ go.seuil|number_format(1, ',', ' ') }} ★</dd></div>
      <div><dt>{{ T.d_reward ?? 'Récompense' }}</dt><dd>{{ go.recompense|number_format(0, ',', ' ') }}&nbsp;{{ eur }}<small>{{ T.d_per_person ?? 'par personne' }}</small></dd></div>
    </dl>
    {% elseif c.cle == 'meilleure' %}{% set mv = b.meilleure %}
      <div><dt>{{ T.d_weighted_hour ?? 'Ton CA par heure pondéré' }}</dt><dd>{{ mv.score is not null ? mv.score|number_format(0, ',', ' ') ~ ' ' ~ eur ~ '/h' : '—' }}{% if mv.rangMag %}<small>{{ mv.rangMag == 1 ? (T.first_abbr ?? '1re') : rangPre ~ mv.rangMag ~ rangSuf }} / {{ mv.surMag }} · {{ T.my_shop_short ?? 'magasin' }}</small>{% endif %}</dd></div>
      {% if mv.premierNom and mv.rangMag != 1 %}<div><dt>{{ T.first_shop ?? '1re du magasin' }}</dt><dd>{{ mv.premierNom }}<small>{{ mv.scorePremier|number_format(0, ',', ' ') }}&nbsp;{{ eur }}/h</small></dd></div>{% endif %}
      {% if mv.rangRes %}<div><dt>{{ T.network ?? 'Réseau' }}</dt><dd>{{ rangPre }}{{ mv.rangRes }}{{ rangSuf }} / {{ mv.surRes }}</dd></div>{% endif %}
      {% if mv.caHeure is not null %}<div><dt>{{ T.d_revenue_hour_real ?? 'Ton CA par heure réel' }}</dt><dd>{{ mv.caHeure|number_format(0, ',', ' ') }}&nbsp;{{ eur }}/h<small>{{ (mv.heures ?? 0)|number_format(1, ',', ' ') }}&nbsp;h</small></dd></div>{% endif %}
      {% if mv.panier is not null %}<div><dt>{{ T.d_avg_ticket ?? 'Ticket moyen' }}</dt><dd>{{ mv.panier|number_format(2, ',', ' ') }}&nbsp;{{ eur }}</dd></div>{% endif %}
    </dl><p class="pl-n">{{ T.best_how ?? 'Ton CA par heure, corrigé du créneau, face aux autres vendeuses.' }}</p>
    {% elseif c.type == 'categorie' %}</dl>
      {% if c.podium|length %}<p class="pl-st">{{ T.d_shop_podium ?? 'Le podium du magasin' }}</p>
      <ol class="pd">{% for x in c.podium %}<li class="{{ x.moi ? 'moi' }}{{ x.moi and x.rang == 1 ? ' un' }}"><span class="r">{{ x.rang }}</span><span class="n">{{ x.moi ? (T.you_short ?? 'Toi') : x.nom }}</span><span class="q">{{ x.q|number_format(0, ',', ' ') }} {{ pcs }}</span></li>{% endfor %}</ol>{% endif %}
      {% if c.minPieces %}<dl class="pl-l"><div><dt>{{ T.d_condition ?? 'Condition' }}</dt><dd>{{ c.minPieces }} {{ pcs }} {{ T.d_min_pieces ?? 'min. pour être classée' }}</dd></div></dl>{% endif %}
    {% else %}</dl>{% endif %}
    {% if c.cle in aCl %}<button type="button" class="pl-cl" data-voir-cl="{{ c.cle }}">{{ T.d_see_leaderboard ?? 'Voir le classement' }} <i class="bi bi-arrow-down"></i></button>{% endif %}
  </div>
</div>
{% endif %}
{% endfor %}
</div>
{% endfor %}

{# ── Le classement, à la Strava : un menu qui monte du bas (le nom, mon rang, la 1re), mon magasin ou le réseau ── #}
{% set cls = p.classements ?? [] %}
{% if cls|length %}
{% set c0 = cls|first %}
<h2 class="sb-titre" id="classement">{{ T.leaderboard ?? 'Classement' }}</h2>
{# Une ligne du menu : l'icône, le nom, le type, mon rang dans le magasin, la 1re. #}
{% set ligneCl = [] %}
{% for x in cls %}
  {% set moiR = (x.magasin|filter(r => r.moi))|first %}
  {% set un = x.magasin|first %}
  {% set champ = x.unite == 'pieces' ? 'pieces' : 'taux' %}
  {% set ligneCl = ligneCl|merge([{ x: x, rang: moiR ? moiR.rang : null, sur: x.nMag ?? x.magasin|length, un: un, q: un ? attribute(un, champ) : null, champ: champ }]) %}
{% endfor %}
{% set l0 = ligneCl|first %}
<button type="button" class="dd" data-cl-ouvrir aria-haspopup="listbox" aria-expanded="false" aria-controls="cl-feuille">
  <span class="emo" data-cl-emo>{{ _self.ic(c0, ib) }}</span>
  <span class="t"><b data-cl-lib>{{ nomFixe[c0.cle] ?? c0.lib }}{% if c0.categorie ?? '' %} · {{ c0.categorie }}{% endif %}</b><span class="typ {{ c0.type }}" data-cl-typ>{{ attribute(T, 'type_' ~ c0.type) ?? c0.type }}</span></span>
  <span class="dd-r" data-cl-rang>{% if l0.rang %}{{ l0.rang == 1 ? (T.first_abbr ?? '1re') : rangPre ~ l0.rang ~ rangSuf }}<small>/ {{ l0.sur }}</small>{% else %}—{% endif %}</span>
  <i class="bi bi-chevron-down"></i>
</button>
<div class="feuille" id="cl-feuille" data-feuille hidden>
  <div class="feuille-fond" data-fermer></div>
  <div class="feuille-c" role="dialog" aria-modal="true" aria-label="{{ T.lb_choose ?? 'Choisir un classement' }}">
    <div class="feuille-poignee"></div>
    <div class="feuille-t"><b>{{ T.lb_choose ?? 'Choisir un classement' }}</b><button type="button" class="feuille-x" data-fermer aria-label="{{ T.close ?? 'Fermer' }}"><i class="bi bi-x-lg"></i></button></div>
    <ul role="listbox" aria-label="{{ T.leaderboard ?? 'Classement' }}">
      {% for l in ligneCl %}{% set x = l.x %}
      <li role="option" tabindex="0" aria-selected="{{ loop.first ? 'true' : 'false' }}" data-choix="{{ x.cle }}" data-type="{{ x.type }}">
        <span class="emo">{{ _self.ic(x, ib) }}</span>
        <span class="t"><b>{{ nomFixe[x.cle] ?? x.lib }}{% if x.categorie ?? '' %} · {{ x.categorie }}{% endif %}</b><span class="typ {{ x.type }}">{{ attribute(T, 'type_' ~ x.type) ?? x.type }}</span>
          <small>{% if l.un %}{{ T.first_abbr ?? '1re' }} : {{ l.un.moi ? (T.you_short ?? 'Toi') : l.un.nom }} {{ l.q|number_format(l.champ == 'taux' ? 1 : 0, ',', ' ') }}{{ l.champ == 'taux' ? ' %' : ' ' ~ pcs }}{% else %}{{ T.lb_empty_short ?? 'personne encore' }}{% endif %}</small></span>
        <span class="dd-r">{% if l.rang %}{{ l.rang == 1 ? (T.first_abbr ?? '1re') : rangPre ~ l.rang ~ rangSuf }}<small>/ {{ l.sur }}</small>{% else %}—{% endif %}</span>
        <i class="bi bi-check-lg coche"></i>
      </li>{% endfor %}
    </ul>
  </div>
</div>
<div class="cl-carte" data-classements>
  <div class="seg" role="tablist"><button type="button" role="tab" class="on" aria-selected="true" data-cl-niv="magasin">{{ T.my_shop_short ?? 'Mon magasin' }}</button><button type="button" role="tab" aria-selected="false" data-cl-niv="reseau">{{ T.network ?? 'Réseau' }}</button></div>
  {% for x in cls %}{% for niv in ['magasin', 'reseau'] %}
  {% set liste = attribute(x, niv) %}
  {% set champ = x.unite == 'pieces' ? 'pieces' : 'taux' %}
  <div class="cl-liste {{ loop.parent.loop.first and niv == 'magasin' ? 'on' }}" data-cl="{{ x.cle }}:{{ niv }}">
    {% if liste|length %}
    {% set podium = liste|filter(r => r.rang <= 3) %}
    {% if podium|length %}
    <div class="podium">
      {% for place in [2, 1, 3] %}{% set r = (podium|filter(z => z.rang == place))|first %}
      {% if r %}
      <div class="pod p{{ place }}{{ r.moi ? ' moi' }}">
        <span class="av {{ r.moi ? 'moi' : 't' ~ (r.nom|length % 8) }}">{% if r.moi %}<i class="bi bi-person-fill"></i>{% else %}{{ r.nom|first|upper }}{% endif %}</span>
        <b>{{ r.moi ? (T.you_short ?? 'Toi') : r.nom }}</b>{% if niv == 'reseau' %}<small>{{ r.lieu }}</small>{% endif %}
        <div class="q">{% if champ == 'pieces' %}{{ r.pieces|number_format(0, ',', ' ') }}<small> {{ pcs }}</small>{% else %}{{ r.taux|number_format(0, ',', ' ') }}<small> %</small>{% endif %}</div>
        <div class="socle">{{ place }}</div>
      </div>
      {% else %}<div class="pod p{{ place }} vide"></div>{% endif %}
      {% endfor %}
    </div>
    {% endif %}
    {% set prec = 3 %}
    {% for r in liste|filter(z => z.rang > 3) %}
    {% if r.rang > prec + 1 %}<div class="cl-row ecart">···</div>{% endif %}{% set prec = r.rang %}
    <div class="cl-row {{ r.moi ? 'moi' }}"><span class="r">{{ r.rang }}</span>
      <span class="av {{ r.moi ? 'moi' : 't' ~ (r.nom|length % 8) }}">{% if r.moi %}<i class="bi bi-person-fill"></i>{% else %}{{ r.nom|first|upper }}{% endif %}</span>
      <span class="nom">{{ r.moi ? (T.you_short ?? 'Toi') : r.nom }}{% if niv == 'reseau' %}<span class="mag">· {{ r.lieu }}</span>{% endif %}</span>
      <span class="val">{% if champ == 'pieces' %}{{ r.pieces|number_format(0, ',', ' ') }}<small>{{ pcs }}</small>{% else %}{{ r.taux|number_format(1, ',', ' ') }}&nbsp;%<small>{{ r.croisees }}/{{ r.tickets }}</small>{% endif %}</span></div>
    {% endfor %}
    {% else %}<div class="note">{{ T.lb_empty ?? 'Personne n’est encore classée ce mois-ci.' }}</div>{% endif %}
  </div>
  {% endfor %}{% endfor %}
</div>
{% endif %}
{% endif %}{# fin du mois compté (le mois à venir est plus haut) #}

{# ── La fiche d'une prime (16/10/2026) : toucher un carré, ou une ligne d'un mois à venir, l'ouvre — ce qu'on gagne
   (de l'argent ou un cadeau), la ligne de description, qui l'offre (le logo et le site du sponsor), la règle, les dates. ── #}
<div class="feuille" id="pr-detail" data-detail-feuille hidden>
  <div class="feuille-fond" data-detail-fermer></div>
  <div class="feuille-c" role="dialog" aria-modal="true" aria-label="{{ T.details ?? 'Détails' }}">
    <div class="feuille-poignee"></div>
    {% for c in p.cartes %}
    {% set objD = c.objPcs ?? (c.objectif ?? ((c.minPieces ?? 0) > 0 ? c.minPieces : null)) %}
    {% set nD = objD is not null ? objD|number_format(0, ',', ' ') : '' %}
    <section class="pdm" data-pdm="{{ c.cle }}" hidden>
      <div class="pdm-h"><span class="emo">{{ _self.ic(c, ib) }}</span><b>{{ nomFixe[c.cle] ?? c.lib }}</b><button type="button" class="feuille-x" data-detail-fermer aria-label="{{ T.close ?? 'Fermer' }}"><i class="bi bi-x-lg"></i></button></div>
      {{ _self.infos(c, T, ib) }}
      <dl class="pl-l">
        {% if c.type == 'promo' or c.type == 'categorie' %}<div><dt>{{ T.d_rule ?? 'Qui gagne' }}</dt><dd>
          {%- if c.regle == 'magasin' %}{{ (T.rule_shop ?? 'le magasin : objectif {n} {u}')|replace({'{n}': nD, '{u}': pcs}) }}
          {%- elseif c.regle == 'vendeuse' %}{{ (T.rule_mine ?? 'ton objectif : {n} {u}')|replace({'{n}': nD, '{u}': pcs}) }}
          {%- elseif c.regle == 'seuil' %}{{ (T.rule_threshold ?? 'chacune dès {n} {u}')|replace({'{n}': nD, '{u}': pcs}) }}
          {%- else %}{{ T.rule_first ?? 'la 1re du magasin gagne' }}{% if objD %} · {{ nD }} {{ pcs }} min.{% endif %}{% endif -%}
        </dd></div>{% endif %}
        {% if (c.du ?? null) or (c.au ?? null) %}<div><dt>{{ T.d_period ?? 'Période' }}</dt><dd>{{ (T.dates_from_to ?? 'du {du} au {au}')|replace({'{du}': c.du ? c.du|date('d/m') : '…', '{au}': c.au ? c.au|date('d/m') : '…'}) }}</dd></div>{% endif %}
      </dl>
      {% if c.cle in (aCl ?? []) %}<button type="button" class="pl-cl" data-voir-cl="{{ c.cle }}" data-detail-fermer>{{ T.d_see_leaderboard ?? 'Voir le classement' }} <i class="bi bi-arrow-down"></i></button>{% endif %}
    </section>
    {% endfor %}
  </div>
</div>
{% endif %}
{% endblock %}
{% block scripts %}
<script>
(function () {
  var m = document.querySelector('[data-mois]');
  if (m) { m.querySelectorAll('a.ms-f').forEach(function (a) { a.addEventListener('click', function () { m.classList.add('charge'); }); }); }
})();
(function () {
  // Les targets : toucher une ligne déroule son détail, une seule ouverte à la fois.
  var lignes = Array.prototype.slice.call(document.querySelectorAll('[data-pl]'));
  function bascule(l) {
    var ouvrir = l.getAttribute('aria-expanded') !== 'true';
    lignes.forEach(function (x) { var on = ouvrir && x === l; x.setAttribute('aria-expanded', on ? 'true' : 'false'); document.getElementById(x.getAttribute('aria-controls')).hidden = !on; });
  }
  lignes.forEach(function (l) {
    l.addEventListener('click', function () { bascule(l); });
    l.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); bascule(l); } });
  });
})();
(function () {
  var bloc = document.querySelector('[data-classements]'); if (!bloc) { return; }
  var bouton = document.querySelector('[data-cl-ouvrir]');
  var feuille = document.querySelector('[data-feuille]');
  var options = Array.prototype.slice.call(feuille.querySelectorAll('[data-choix]'));
  var cat = options.length ? options[0].dataset.choix : '', niv = 'magasin';
  function montre() {
    bloc.querySelectorAll('[data-cl]').forEach(function (l) { l.classList.toggle('on', l.dataset.cl === cat + ':' + niv); });
    bloc.querySelectorAll('[data-cl-niv]').forEach(function (c) { var on = c.dataset.clNiv === niv; c.classList.toggle('on', on); c.setAttribute('aria-selected', on ? 'true' : 'false'); });
    options.forEach(function (o) {
      var on = o.dataset.choix === cat;
      o.setAttribute('aria-selected', on ? 'true' : 'false');
      if (!on) { return; }
      // Le bouton reprend l'icône, le nom, le type et mon rang de la ligne choisie.
      bouton.querySelector('[data-cl-emo]').innerHTML = o.querySelector('.emo').innerHTML;
      bouton.querySelector('[data-cl-lib]').textContent = o.querySelector('.t b').textContent;
      var t = bouton.querySelector('[data-cl-typ]'); t.textContent = o.querySelector('.typ').textContent; t.className = 'typ ' + o.dataset.type;
      bouton.querySelector('[data-cl-rang]').innerHTML = o.querySelector('.dd-r').innerHTML;
    });
  }
  function ouvre() {
    feuille.hidden = false;
    requestAnimationFrame(function () { feuille.classList.add('ouverte'); });
    bouton.setAttribute('aria-expanded', 'true');
    var sel = feuille.querySelector('[aria-selected="true"]') || options[0]; if (sel) { sel.focus(); }
  }
  function ferme() {
    feuille.classList.remove('ouverte');
    bouton.setAttribute('aria-expanded', 'false');
    setTimeout(function () { feuille.hidden = true; }, 200);
    bouton.focus();
  }
  function choisit(cle) { cat = cle; montre(); ferme(); }
  bouton.addEventListener('click', ouvre);
  feuille.querySelectorAll('[data-fermer]').forEach(function (f) { f.addEventListener('click', ferme); });
  options.forEach(function (o, i) {
    o.addEventListener('click', function () { choisit(o.dataset.choix); });
    o.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choisit(o.dataset.choix); }
      else if (e.key === 'ArrowDown' && options[i + 1]) { e.preventDefault(); options[i + 1].focus(); }
      else if (e.key === 'ArrowUp' && options[i - 1]) { e.preventDefault(); options[i - 1].focus(); }
    });
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !feuille.hidden) { ferme(); } });
  bloc.querySelectorAll('[data-cl-niv]').forEach(function (c) { c.addEventListener('click', function () { niv = c.dataset.clNiv; montre(); }); });
  // Un carré avec un classement ouvre le sien ; dans le détail d'une ligne, « Voir le classement » aussi.
  document.querySelectorAll('[data-voir-cl]').forEach(function (v) {
    v.addEventListener('click', function () { cat = v.dataset.voirCl; montre(); document.getElementById('classement').scrollIntoView({ behavior: 'smooth' }); });
  });
})();
(function () {
  // La fiche d'une prime (16/10/2026) : toucher un carré, ou une ligne d'un mois à venir, ouvre son détail.
  var f = document.querySelector('[data-detail-feuille]'); if (!f) { return; }
  var der = null;
  function ouvre(cle, src) {
    var sec = f.querySelector('[data-pdm="' + cle + '"]'); if (!sec) { return; }
    f.querySelectorAll('[data-pdm]').forEach(function (x) { x.hidden = x !== sec; });
    der = src || null; f.hidden = false;
    requestAnimationFrame(function () { f.classList.add('ouverte'); });
  }
  function ferme() { f.classList.remove('ouverte'); setTimeout(function () { f.hidden = true; }, 200); if (der) { der.focus(); } }
  document.querySelectorAll('.pq[data-carte], .pl.av[data-carte]').forEach(function (k) {
    k.classList.add('cliquable'); k.setAttribute('role', 'button'); k.tabIndex = 0;
    k.addEventListener('click', function () { ouvre(k.dataset.carte, k); });
    k.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); ouvre(k.dataset.carte, k); } });
  });
  f.querySelectorAll('[data-detail-fermer]').forEach(function (b) { b.addEventListener('click', ferme); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !f.hidden) { ferme(); } });
})();
</script>
{% endblock %}

{# Ce qu'on gagne, la ligne de description, qui offre la prime (16/10/2026) : la fiche et le détail d'une ligne. #}
{% macro infos(c, T, ib) %}
<div class="pdm-g"><small>{{ T.to_win ?? 'À gagner' }}</small><b>{% if c.cadeau ?? null %}<i class="bi bi-gift"></i> {{ c.cadeau.nom }}{% if c.cadeau.valeur %} <i>· {{ T.value ?? 'valeur' }} {{ c.cadeau.valeur|number_format(0, ',', ' ') }}&nbsp;€</i>{% endif %}{% else %}{{ c.montant|number_format(0, ',', ' ') }}&nbsp;€{% if c.max ?? false %} max{% endif %}{% endif %}</b></div>
{% if c.description ?? '' %}<p class="pdm-d">{{ c.description }}</p>{% endif %}
{#- L'indication (17/10/2026) : ce qu'il manque, calculé — avis 5★, ventes croisées, CA du magasin. #}
{% if c.cle == 'google' and (c.avis5 ?? null) is not null %}<p class="pdm-a"><i class="bi bi-lightbulb"></i> {% if c.avis5 > 0 %}{{ (T.hint_google ?? 'Il manque {n} avis 5★ pour atteindre {s} ★')|replace({'{n}': c.avis5|number_format(0, ',', ' '), '{s}': c.cible|number_format(1, ',', ' ')}) }}{% else %}{{ (T.hint_google_ok ?? 'Le magasin tient {s} ★ : chaque avis 5★ le garde au-dessus')|replace({'{s}': c.cible|number_format(1, ',', ' ')}) }}{% endif %}</p>
{% elseif c.cle == 'croisees' and (c.manque ?? 0) > 0 %}<p class="pdm-a"><i class="bi bi-lightbulb"></i> {{ (T.hint_cross ?? 'Encore {n} ventes croisées pour atteindre {s} % : un article de plus sur chaque ticket')|replace({'{n}': c.manque, '{s}': c.cible|number_format(0, ',', ' ')}) }}</p>
{% elseif c.cle == 'objectif' and (c.manqueCa ?? 0) > 0 %}<p class="pdm-a"><i class="bi bi-lightbulb"></i> {{ (T.hint_target ?? 'Le magasin doit encore faire {n} € de chiffre ce mois')|replace({'{n}': c.manqueCa|number_format(0, ',', ' ')}) }}</p>{% endif %}
{% set sp = c.sponsor ?? null %}
<div class="pdm-s">{% if sp and sp.logo %}<img src="{{ ib }}/{{ sp.logo }}" alt="">{% endif %}<div><small>{{ T.offered_by ?? 'Offerte par' }}</small><b>{{ sp ? sp.nom : ((c.payeur ?? '') == 'magasin' ? (T.your_shop ?? 'ton magasin') : (T.the_brand ?? 'la marque')) }}</b>{% if sp and sp.texte %}<span>{{ sp.texte }}</span>{% endif %}{% if sp and sp.site %}<a href="{{ sp.site }}" target="_blank" rel="noopener noreferrer">{{ sp.site|replace({'https://': '', 'http://': ''})|trim('/') }} ↗</a>{% endif %}</div></div>
{% endmacro %}

{# L'icône d'une prime (23/10/2026) : celle que l'admin a déposée, sinon une icône au trait selon la prime (plus d'émoji). #}
{% macro ic(c, ib) %}
{%- if c.icone ?? '' %}<img src="{{ ib }}/{{ c.icone }}" alt="">
{%- else %}<i class="bi {{ { croisees: 'bi-bag', record: 'bi-graph-up-arrow', objectif: 'bi-shop', google: 'bi-star', meilleure: 'bi-trophy' }[c.cle] ?? ((c.type ?? '') == 'promo' ? 'bi-tag' : 'bi-award') }}"></i>{% endif -%}
{% endmacro %}
