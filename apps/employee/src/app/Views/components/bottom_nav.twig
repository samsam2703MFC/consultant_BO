{# components/bottom_nav.twig — quatre onglets : Accueil et Planning (revenus le 24/10/2026, Sam : « il manque l'icône dans le
   menu », « remettre aussi Planning »), Primes et Profil. Statistiques reste hors du menu pour le moment (la page reste à
   /statistiques ; la connexion ouvre l'Accueil, où sont les tâches). Pour en remettre un : sa ligne ici, { key, label,
   icon, href }. #}
{% set items = items ?? [
    { key: 'dashboard', label: translations.home ?? 'Home',         icon: 'bi-house',     href: ROOT ~ '/dashboard' },
    { key: 'schedule',  label: translations.schedule ?? 'Schedule', icon: 'bi-calendar3', href: ROOT ~ '/schedule' },
    { key: 'primes',    label: translations.bonuses ?? 'Bonuses', icon: 'bi-trophy', href: ROOT ~ '/primes' },
    { key: 'profile',   label: translations.profile ?? 'Profile', icon: 'bi-person', href: ROOT ~ '/me' },
] %}

<nav class="emp-bottom-nav" role="navigation" aria-label="{{ translations.primary_navigation ?? 'Primary navigation' }}">
    {% for it in items %}
        {% set is_active = (active_nav ?? '') == it.key %}
        <a class="emp-bottom-item {{ is_active ? 'is-active' : '' }}"
           href="{{ it.href }}"
           aria-current="{{ is_active ? 'page' : 'false' }}">
            <i class="bi {{ it.icon }}"></i>
            <span>{{ it.label }}</span>
        </a>
    {% endfor %}
</nav>
