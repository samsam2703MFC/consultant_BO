{% block scripts %}
<script>
(function () {
  var ROOT = {{ ROOT|json_encode|raw }};
  var T = {{ {
    saving: T.pf_saving ?? 'Enregistrement…', save: T.pf_save ?? 'Enregistrer', error: T.pf_error ?? 'Impossible d’enregistrer pour l’instant. Réessaie.',
    valid: T.pf_valid ?? 'valide', nissLen: T.pf_niss_len ?? 'Le numéro national a 11 chiffres : il en manque {n}.', nissBad: T.pf_niss_bad ?? 'Ce numéro national n’est pas valide.',
    ibanLen: T.pf_iban_len ?? 'Un IBAN {c} a {l} caractères : il en manque {n}.', ibanBad: T.pf_iban_bad ?? 'Cet IBAN n’est pas valide.',
    photoSending: T.pf_photo_sending ?? 'Envoi…', photoError: T.pf_photo_error ?? 'La photo n’a pas pu être envoyée.', photoDone: T.pf_photo_done ?? 'ajoutée · toucher pour remplacer'
  }|json_encode|raw }};
  var IBAN_L = {BE:16, FR:27, NL:18, LU:20, DE:22, PL:28, IT:27, ES:24, PT:25, GB:22, IE:22, AT:20, CH:21, MA:28, TR:26, RO:24};

  function ouvrir(id) { var d = document.getElementById('fx-' + id); if (d && d.showModal) { d.showModal(); } }
  document.querySelectorAll('[data-ouvre]').forEach(function (b) { b.addEventListener('click', function () { ouvrir(b.getAttribute('data-ouvre')); }); });
  document.querySelectorAll('dialog.fx').forEach(function (d) {
    d.querySelectorAll('[data-ferme]').forEach(function (b) { b.addEventListener('click', function () { d.close(); }); });
    d.addEventListener('click', function (e) { if (e.target === d) { d.close(); } });   // un toucher hors de la feuille la ferme
  });

  // Numéro national : 11 chiffres, contrôle modulo 97 (« 2 » devant pour les naissances depuis 2000).
  function nissOk(n) {
    if (n.length !== 11) { return false; }
    var base = n.slice(0, 9), c = parseInt(n.slice(9), 10);
    return 97 - (parseInt(base, 10) % 97) === c || 97 - (parseInt('2' + base, 10) % 97) === c;
  }
  function ibanMod(i) {
    var r = (i.slice(4) + i.slice(0, 4)).replace(/[A-Z]/g, function (ch) { return String(ch.charCodeAt(0) - 55); });
    var reste = 0;
    for (var k = 0; k < r.length; k += 7) { reste = parseInt(String(reste) + r.slice(k, k + 7), 10) % 97; }
    return reste === 1;
  }
  function controler(input) {
    var aide = input.parentNode.querySelector('.aide'); if (!aide) { return; }
    var t = input.getAttribute('data-controle'), v = input.value, msg = '', bon = false;
    if (t === 'niss') {
      var n = v.replace(/\D/g, '');
      if (n.length === 0) { msg = ''; }
      else if (n.length < 11) { msg = T.nissLen.replace('{n}', 11 - n.length); }
      else if (nissOk(n)) { msg = '✓ ' + T.valid; bon = true; }
      else { msg = T.nissBad; }
    } else {
      var i = v.replace(/[^0-9A-Za-z]/g, '').toUpperCase(), l = IBAN_L[i.slice(0, 2)];
      if (i.length === 0) { msg = ''; }
      else if (l && i.length < l) { msg = T.ibanLen.replace('{c}', i.slice(0, 2)).replace('{l}', l).replace('{n}', l - i.length); }
      else if (i.length >= 15 && ibanMod(i) && (!l || i.length === l)) { msg = '✓ ' + T.valid; bon = true; }
      else { msg = T.ibanBad; }
    }
    aide.textContent = msg; aide.classList.toggle('bon', bon);
  }
  document.querySelectorAll('[data-controle]').forEach(function (i) { i.addEventListener('input', function () { controler(i); }); controler(i); });

  // Une fiche enregistrée : les valeurs du formulaire, en JSON, au cockpit par l'app ; les erreurs sous leur champ.
  function valeurs(form) {
    var v = {};
    form.querySelectorAll('input, textarea').forEach(function (el) {
      if (!el.name || el.type === 'file') { return; }
      if (el.type === 'radio') { if (el.checked) { v[el.name] = el.value; } else if (!(el.name in v)) { v[el.name] = ''; } return; }
      if (el.type === 'checkbox') {
        var p = el.name.split('.'); v[p[0]] = v[p[0]] || {}; v[p[0]][p[1]] = v[p[0]][p[1]] || {}; v[p[0]][p[1]][p[2]] = el.checked; return;
      }
      v[el.name] = el.value;
    });
    return v;
  }
  document.querySelectorAll('dialog.fx form[data-section]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var bt = form.querySelector('button.ok'), msg = form.querySelector('.fx-msg');
      form.querySelectorAll('.fx-champ.ko').forEach(function (c) { c.classList.remove('ko'); });
      msg.classList.remove('on');
      bt.disabled = true; bt.textContent = T.saving;
      fetch(ROOT + '/me/profil', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ section: form.getAttribute('data-section'), valeurs: valeurs(form) }) })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { code: r.status, d: d }; }); })
        .then(function (x) {
          if (x.code === 200) { location.reload(); return; }
          bt.disabled = false; bt.textContent = T.save;
          var errs = (x.d && x.d.erreurs) || null;
          if (x.code === 422 && errs) {
            Object.keys(errs).forEach(function (k) {
              var c = form.querySelector('[data-champ="' + k + '"]');
              if (c) { c.classList.add('ko'); c.querySelector('.err').textContent = errs[k]; } else { msg.textContent = errs[k]; msg.classList.add('on'); }
            });
          } else { msg.textContent = T.error; msg.classList.add('on'); }
        })
        .catch(function () { bt.disabled = false; bt.textContent = T.save; msg.textContent = T.error; msg.classList.add('on'); });
    });
  });

  // La carte d'identité : la photo réduite à 1600 px dans le navigateur (JPEG), puis envoyée.
  function reduire(fichier) {
    return new Promise(function (ok, ko) {
      var img = new Image(), url = URL.createObjectURL(fichier);
      img.onload = function () {
        var k = Math.min(1, 1600 / Math.max(img.naturalWidth, img.naturalHeight));
        var c = document.createElement('canvas'); c.width = Math.round(img.naturalWidth * k); c.height = Math.round(img.naturalHeight * k);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height); URL.revokeObjectURL(url);
        ok(c.toDataURL('image/jpeg', 0.85));
      };
      img.onerror = function () { URL.revokeObjectURL(url); ko(); };
      img.src = url;
    });
  }
  document.querySelectorAll('.fx-carte').forEach(function (lab) {
    var input = lab.querySelector('input'), sous = lab.querySelector('small'), face = lab.getAttribute('data-face');
    input.addEventListener('change', function () {
      if (!input.files || !input.files[0]) { return; }
      var avant = sous.textContent; sous.textContent = T.photoSending;
      reduire(input.files[0]).then(function (data) {
        return fetch(ROOT + '/me/carte', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ face: face, data: data }) });
      }).then(function (r) {
        if (!r.ok) { throw new Error(); }
        lab.classList.add('fait'); lab.querySelector('i').className = 'bi bi-check-lg'; sous.textContent = T.photoDone;
      }).catch(function () { sous.textContent = T.photoError; setTimeout(function () { sous.textContent = avant; }, 4000); });
      input.value = '';
    });
  });

  // Après un enregistrement, la page se relit ; ?ouvre=paie rouvre une feuille.
  var o = new URLSearchParams(location.search).get('ouvre'); if (o) { ouvrir(o); }
})();
</script>
{% endblock %}
