{# me/profile.twig — « Mon profil » (30/10/2026, Sam : « que l'employé puisse encoder toutes ses données » ; maquette
   docs/maquettes/profil-employe). En tête, ce qui manque ; puis identité, coordonnées, urgence, paie, tenue,
   disponibilités, chacune s'ouvrant en feuille ; la carte d'identité dans la feuille Paie ; « Mon travail » en lecture.
   Le profil vient du cockpit (ProfilService), chiffré là-bas ; le prénom, le nom, le téléphone et l'e-mail du panel tant
   que la personne ne les a pas changés. #}
{% extends "layouts/mobile_base.twig" %}
{% set active_nav = 'profile' %}
{% set T = translations %}
{% set P = profil.profil ?? {} %}
{% set ok = profil is not null %}
{% set id = P.identite ?? {} %}
{% set co = P.coordonnees ?? {} %}
{% set ur = P.urgence ?? {} %}
{% set pa = P.paie ?? {} %}
{% set te = P.tenue ?? {} %}
{% set di = P.dispo ?? {} %}
{% set prenom = (id.prenom ?? '') ?: (panel.prenom ?? '') %}
{% set nom = (id.nom ?? '') ?: (panel.nom ?? '') %}
{% set telephone = (co.telephone ?? '') ?: (panel.telephone ?? '') %}
{% set email = (co.email ?? '') ?: (panel.email ?? '') %}
{% set manque = profil.manque ?? {} %}
{% set shopNom = shop ? (shop.getRepresentativeName() ?: shop.getName()) : '' %}
{% set depuis = employee and employee.getCreateTimestamp() ? mois(employee.getCreateTimestamp()|slice(0, 7)) : '' %}
{% set jours = (T.pf_days ?? 'Lu,Ma,Me,Je,Ve,Sa,Di')|split(',') %}
{% set cles = ['lu', 'ma', 'me', 'je', 've', 'sa', 'di'] %}
{% set tailles = ['XS', 'S', 'M', 'L', 'XL', 'XXL', '3XL'] %}
{# La feuille qu'ouvre chaque élément manquant. #}
{% set feuilleDe = {'identite': 'identite', 'coordonnees': 'coordonnees', 'urgence': 'urgence', 'paie': 'paie', 'tenue': 'tenue', 'dispo': 'dispo', 'carte': 'paie'} %}
{% set libManque = {
    'identite.prenom': T.pf_first_name ?? 'Prénom', 'identite.nom': T.pf_last_name ?? 'Nom', 'identite.naissance': T.pf_birth_long ?? 'Date de naissance',
    'identite.nationalite': T.pf_nationality ?? 'Nationalité', 'coordonnees.telephone': T.pf_phone ?? 'Téléphone', 'coordonnees.email': T.pf_email ?? 'E-mail',
    'coordonnees.adresse': T.pf_address ?? 'Adresse', 'urgence': T.pf_emergency_contact ?? 'Contact d’urgence', 'paie.statut': T.pf_status ?? 'Statut',
    'paie.niss': T.pf_niss ?? 'N° national', 'paie.iban': T.pf_iban ?? 'IBAN', 'tenue.tshirt': T.pf_tshirt_size ?? 'Taille de t-shirt',
    'tenue.veste': T.pf_jacket_size ?? 'Taille de veste', 'tenue.chaussures': T.pf_shoe_size ?? 'Pointure', 'dispo': T.pf_availability ?? 'Disponibilités',
    'carte': T.pf_id_card ?? 'Carte d’identité'} %}
{% set statuts = {'employe': T.pf_status_employe ?? 'Employé·e', 'etudiant': T.pf_status_etudiant ?? 'Étudiant·e', 'flexi': T.pf_status_flexi ?? 'Flexi-job'} %}
{% set langues = {'FR': 'Français', 'EN': 'English', 'NL': 'Nederlands', 'IT': 'Italiano', 'PL': 'Polski'} %}

{% macro vide(T) %}<span class="pf-v manque">{{ T.pf_to_complete ?? 'À compléter' }}</span>{% endmacro %}
{% macro tete(T, titre) %}<div class="fx-poignee"></div><div class="fx-tete"><button type="button" data-ferme>{{ T.pf_cancel ?? 'Annuler' }}</button><b>{{ titre }}</b><button type="submit" class="ok">{{ T.pf_save ?? 'Enregistrer' }}</button></div>{% endmacro %}
{% macro champ(nom, libelle, valeur, type, extra) %}<label class="fx-champ" data-champ="{{ nom }}"><span>{{ libelle }}</span><input name="{{ nom }}" type="{{ type ?: 'text' }}" value="{{ valeur }}" {{ extra|raw }}><em class="err"></em></label>{% endmacro %}
{# Un téléphone belge lisible : « +32 470 12 34 56 », « +32 2 123 45 67 » ; les autres tels quels. #}
{% macro tel(t) %}{% if t|slice(0, 3) == '+32' and t|length == 12 %}+32 {{ t|slice(3, 3) }} {{ t|slice(6, 2) }} {{ t|slice(8, 2) }} {{ t|slice(10, 2) }}{% elseif t|slice(0, 3) == '+32' and t|length == 11 %}+32 {{ t|slice(3, 1) }} {{ t|slice(4, 3) }} {{ t|slice(7, 2) }} {{ t|slice(9, 2) }}{% else %}{{ t }}{% endif %}{% endmacro %}
{% import _self as f %}

{% block title %}{{ T.pf_title ?? 'Mon profil' }}{% endblock %}
{% block page_title %}{{ T.pf_title ?? 'Mon profil' }}{% endblock %}
{% block page_subtitle %}{{ shopNom }}{% if depuis %} · {{ (T.pf_since ?? 'depuis {d}')|replace({'{d}': depuis}) }}{% endif %}{% endblock %}

{% block head %}
<link rel="stylesheet" href="{{ asset('assets/atelier/primes.css') }}">
<style>
  .pf-heros{background:var(--s-carte);border-radius:18px;padding:16px;margin-bottom:18px}
  .pf-qui{display:flex;align-items:center;gap:14px}
  .pf-av{width:60px;height:60px;border-radius:50%;background:var(--s-accent);color:#fff;display:flex;align-items:center;justify-content:center;font:600 22px var(--s-police);flex:0 0 auto}
  .pf-nom{font:600 20px/1.2 var(--s-police);color:var(--s-texte)}
  .pf-ou{font:400 14px var(--s-police);color:var(--s-second);margin-top:2px}
  .pf-comp{margin-top:14px}
  .pf-comp .l{display:flex;justify-content:space-between;font:600 13px var(--s-police);color:var(--s-texte)}
  .pf-comp .l span{color:var(--s-second);font-weight:400}
  .pf-comp .bar{height:6px;border-radius:3px;background:var(--s-remplir);margin-top:7px;overflow:hidden}
  .pf-comp .bar i{display:block;height:100%;background:var(--s-accent);border-radius:3px}
  .pf-comp.fini .bar i{background:var(--s-vert)}
  .pf-manque{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
  .pf-manque button{font:500 12.5px var(--s-police);color:var(--s-accent);background:var(--s-accent-doux);border:0;border-radius:999px;padding:4px 10px}
  .pf-sec{display:flex;align-items:baseline;justify-content:space-between;margin:0 4px 7px;font:600 13px var(--s-police);letter-spacing:.02em;text-transform:uppercase;color:var(--s-second)}
  .pf-sec small{text-transform:none;letter-spacing:0;font-weight:400;display:flex;align-items:center;gap:4px}
  .pf-g{background:var(--s-carte);border-radius:16px;overflow:hidden;margin-bottom:8px}
  .pf-l{position:relative;display:flex;align-items:center;gap:12px;width:100%;min-height:46px;padding:11px 34px 11px 16px;color:inherit;text-decoration:none;background:none;border:0;text-align:left}
  .pf-l+.pf-l::before{content:'';position:absolute;left:16px;right:0;top:0;border-top:.5px solid var(--s-trait)}
  .pf-l::after{content:'';position:absolute;right:17px;top:50%;width:7px;height:7px;margin-top:-4px;border-right:2px solid var(--s-tertiaire);border-bottom:2px solid var(--s-tertiaire);transform:rotate(-45deg)}
  .pf-l.fixe{padding-right:16px}.pf-l.fixe::after{display:none}
  .pf-l:disabled{opacity:1}
  .pf-k{flex:0 0 auto;font:400 16px var(--s-police);color:var(--s-texte)}
  .pf-v{flex:1;min-width:0;text-align:right;font:400 16px var(--s-police);color:var(--s-second);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pf-v.manque{color:var(--s-accent)}
  .pf-v.manque::before{content:'';display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--s-accent);margin-right:7px;vertical-align:1px}
  .pf-v.multi{white-space:normal;line-height:1.3}
  .pf-v .corr{display:inline-block;width:7px;height:7px;border-radius:50%;background:#E08A1E;margin-right:6px;vertical-align:1px}
  .pf-note{margin:0 16px 18px;font:400 12.5px/1.4 var(--s-police);color:var(--s-second)}
  .pf-note i{margin-right:4px}
  .pf-esp{height:10px}
  .pf-alerte{background:var(--s-carte);border-radius:14px;padding:12px 14px;margin-bottom:14px;font:400 14px var(--s-police);color:var(--s-second)}
  .pf-dispo{padding:12px 16px 14px;display:block;width:100%;background:none;border:0;text-align:left}
  .pf-dispo .j{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;text-align:center}
  .pf-dispo .j+.j{margin-top:5px}
  .pf-dispo .j b{font:600 11px var(--s-police);color:var(--s-second);text-transform:uppercase;letter-spacing:.03em}
  .pf-dispo .j i{display:block;height:22px;border-radius:7px;background:var(--s-remplir);font:500 10.5px/22px var(--s-police);font-style:normal;color:var(--s-second)}
  .pf-dispo .j i.on{background:var(--s-vert-doux);color:var(--s-vert)}
  .pf-dispo .lg{display:flex;justify-content:space-between;gap:10px;margin-top:8px;font:400 12px var(--s-police);color:var(--s-second)}
  .pf-dispo .lg span:last-child{text-align:right}
  /* Les feuilles de saisie */
  dialog.fx{position:fixed;inset:auto 0 0 0;width:100%;max-width:520px;margin:0 auto;max-height:92vh;padding:0;border:0;border-radius:16px 16px 0 0;background:var(--s-fond);box-shadow:0 -6px 24px rgba(0,0,0,.18);overflow:auto}
  dialog.fx::backdrop{background:rgba(0,0,0,.3)}
  .fx-poignee{width:38px;height:5px;border-radius:3px;background:var(--s-tertiaire);margin:7px auto 0}
  .fx-tete{position:sticky;top:0;z-index:2;background:var(--s-fond);display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 16px 12px}
  .fx-tete button{background:none;border:0;padding:4px 0;font:400 16px var(--s-police);color:var(--s-accent)}
  .fx-tete button.ok{font-weight:600}
  .fx-tete button:disabled{color:var(--s-tertiaire)}
  .fx-tete b{font:600 17px var(--s-police);color:var(--s-texte)}
  .fx-corps{padding:0 16px 28px}
  .fx-champ{position:relative;display:block;padding:9px 16px 10px;margin:0}
  .fx-champ+.fx-champ::before{content:'';position:absolute;left:16px;right:0;top:0;border-top:.5px solid var(--s-trait)}
  .fx-champ>span{display:block;font:400 12.5px var(--s-police);color:var(--s-second)}
  .fx-champ input,.fx-champ textarea{display:block;width:100%;border:0;padding:3px 0 0;background:none;font:400 17px var(--s-police);color:var(--s-texte);font-variant-numeric:tabular-nums;outline:none}
  .fx-champ textarea{resize:none;min-height:46px}
  .fx-champ input::placeholder,.fx-champ textarea::placeholder{color:var(--s-tertiaire)}
  .fx-champ .err{display:none;font:500 12.5px var(--s-police);color:#B3261E;margin-top:3px}
  .fx-champ.ko .err{display:block}
  .fx-champ .aide{display:block;font:400 12.5px var(--s-police);color:var(--s-second);margin-top:3px}
  .fx-champ .aide.bon{color:var(--s-vert)}
  .fx-deux{display:grid;grid-template-columns:1fr 1fr}
  .fx-deux .fx-champ+.fx-champ::before{left:0}
  .fx-seg{display:flex;background:var(--s-remplir);border-radius:9px;padding:2px;margin-top:6px}
  .fx-seg label{flex:1;margin:0}
  .fx-seg input{position:absolute;opacity:0;pointer-events:none}
  .fx-seg span{display:block;text-align:center;padding:6px 0;border-radius:7px;font:500 13.5px var(--s-police);color:var(--s-texte)}
  .fx-seg input:checked+span{background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.12);font-weight:600}
  .fx-grille{padding:12px 16px}
  .fx-grille .j{display:grid;grid-template-columns:52px repeat(7,1fr);gap:5px;align-items:center;text-align:center}
  .fx-grille .j+.j{margin-top:6px}
  .fx-grille b{font:600 11px var(--s-police);color:var(--s-second);text-transform:uppercase}
  .fx-grille .t{font:400 12.5px var(--s-police);color:var(--s-second);text-align:left}
  .fx-grille label{margin:0}
  .fx-grille input{position:absolute;opacity:0;pointer-events:none}
  .fx-grille span{display:block;height:34px;border-radius:9px;background:var(--s-remplir)}
  .fx-grille input:checked+span{background:var(--s-vert);box-shadow:inset 0 0 0 2px rgba(255,255,255,.35)}
  .fx-carte{display:flex;align-items:center;gap:12px;padding:12px 16px;margin:0;cursor:pointer}
  .fx-carte+.fx-carte{border-top:.5px solid var(--s-trait)}
  .fx-carte input{display:none}
  .fx-carte i{width:44px;height:32px;border-radius:6px;background:var(--s-remplir);display:flex;align-items:center;justify-content:center;color:var(--s-second);font-size:16px;flex:0 0 auto}
  .fx-carte.fait i{background:var(--s-vert-doux);color:var(--s-vert)}
  .fx-carte b{display:block;font:400 15px var(--s-police);color:var(--s-accent)}
  .fx-carte small{display:block;font:400 12.5px var(--s-police);color:var(--s-second)}
  .fx-msg{display:none;margin:0 4px 12px;font:500 13px var(--s-police);color:#B3261E}
  .fx-msg.on{display:block}
  .fx-liste{padding:4px 16px}
  .fx-liste div{padding:9px 0;border-bottom:.5px solid var(--s-trait);font:400 15px var(--s-police);color:var(--s-texte)}
  .fx-liste div:last-child{border-bottom:0}
  .fx-liste small{display:block;font:400 12.5px var(--s-police);color:var(--s-second)}
</style>
{% endblock %}

{% block content %}
{% if not ok %}
<div class="pf-alerte"><i class="bi bi-cloud-slash me-1"></i>{{ T.pf_unavailable ?? 'Ton profil ne peut pas être lu pour l’instant. Réessaie dans un moment.' }}</div>
{% endif %}

{# ── En tête : qui, et ce qui manque ── #}
{% set complet = profil.complet ?? 0 %}
<div class="pf-heros">
  <div class="pf-qui"><div class="pf-av">{{ ((prenom|slice(0,1)) ~ (nom|slice(0,1)))|upper ?: (T.me_abbr ?? 'MOI') }}</div>
    <div><div class="pf-nom">{{ (prenom ~ ' ' ~ nom)|trim ?: (employee ? employee.getDisplayName() : '') }}</div>
      <div class="pf-ou">{{ employee and employee.getPositions() is not empty ? employee.getPositions()[0].getName() ~ ' · ' : '' }}{{ shopNom }}</div></div></div>
  {% if ok %}
  <div class="pf-comp{{ complet >= 100 ? ' fini' }}" data-complet="{{ complet }}">
    <div class="l">{{ (T.pf_complete ?? 'Profil complet à {p} %')|replace({'{p}': complet}) }}
      <span>{% if manque|length %}{{ (T.pf_to_fill ?? '{n} à compléter')|replace({'{n}': manque|length}) }}{% else %}{{ T.pf_all_done ?? 'Tout est rempli' }}{% endif %}</span></div>
    <div class="bar"><i style="width:{{ complet }}%"></i></div>
    {% if manque|length %}<div class="pf-manque">{% for k, l in manque %}{% if loop.index <= 4 %}<button type="button" data-ouvre="{{ feuilleDe[k|split('.')[0]] ?? 'identite' }}">{{ libManque[k] ?? l }}</button>{% endif %}{% endfor %}</div>{% endif %}
  </div>
  {% endif %}
</div>

{# ── Identité ── #}
<div class="pf-sec">{{ T.pf_identity ?? 'Identité' }}</div>
<div class="pf-g">
  <button type="button" class="pf-l" data-ouvre="identite"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_first_name ?? 'Prénom' }}</span>{% if prenom %}<span class="pf-v">{% if profil.corrections['identite.prenom'] is defined %}<i class="corr"></i>{% endif %}{{ prenom }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
  <button type="button" class="pf-l" data-ouvre="identite"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_last_name ?? 'Nom' }}</span>{% if nom %}<span class="pf-v">{% if profil.corrections['identite.nom'] is defined %}<i class="corr"></i>{% endif %}{{ nom }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
  <button type="button" class="pf-l" data-ouvre="identite"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_birth ?? 'Naissance' }}</span>{% if id.naissance ?? '' %}<span class="pf-v">{{ id.naissance|date('j') }} {{ mois(id.naissance) }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
  <button type="button" class="pf-l" data-ouvre="identite"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_nationality ?? 'Nationalité' }}</span>{% if id.nationalite ?? '' %}<span class="pf-v">{{ id.nationalite }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
</div>
<p class="pf-note">{{ T.pf_from_account ?? 'Ton prénom, ton nom, ton téléphone et ton e-mail viennent de ton compte ; une correction est signalée au magasin.' }}</p>

{# ── Coordonnées ── #}
<div class="pf-sec">{{ T.pf_contact ?? 'Coordonnées' }}</div>
<div class="pf-g">
  <button type="button" class="pf-l" data-ouvre="coordonnees"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_phone ?? 'Téléphone' }}</span>{% if telephone %}<span class="pf-v">{% if profil.corrections['coordonnees.telephone'] is defined %}<i class="corr"></i>{% endif %}{{ f.tel(telephone) }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
  <button type="button" class="pf-l" data-ouvre="coordonnees"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_email ?? 'E-mail' }}</span>{% if email %}<span class="pf-v">{% if profil.corrections['coordonnees.email'] is defined %}<i class="corr"></i>{% endif %}{{ email }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
  <button type="button" class="pf-l" data-ouvre="coordonnees"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_address ?? 'Adresse' }}</span>{% if (co.rue ?? '') and (co.ville ?? '') %}<span class="pf-v multi">{{ co.rue }} {{ co.numero ?? '' }}{% if co.boite ?? '' %} / {{ co.boite }}{% endif %}<br>{{ co.cp ?? '' }} {{ co.ville }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
</div>
<div class="pf-esp"></div>

{# ── En cas d'urgence ── #}
<div class="pf-sec">{{ T.pf_emergency ?? 'En cas d’urgence' }}</div>
<div class="pf-g">
  <button type="button" class="pf-l" data-ouvre="urgence"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_emergency_person ?? 'Personne à prévenir' }}</span>{% if (ur.nom ?? '') and (ur.telephone ?? '') %}<span class="pf-v multi">{{ ur.nom }}{% if ur.lien ?? '' %} · {{ ur.lien }}{% endif %}<br>{{ f.tel(ur.telephone) }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
</div>
<p class="pf-note">{{ T.pf_emergency_note ?? 'Son nom, son lien avec toi et son téléphone. Seul ton magasin le voit.' }}</p>

{# ── Paie ── #}
<div class="pf-sec">{{ T.pf_pay ?? 'Paie' }} <small><i class="bi bi-lock-fill"></i> {{ T.pf_private ?? 'privé' }}</small></div>
<div class="pf-g">
  <button type="button" class="pf-l" data-ouvre="paie"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_status ?? 'Statut' }}</span>{% if pa.statut ?? '' %}<span class="pf-v">{{ statuts[pa.statut] ?? pa.statut }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
  <button type="button" class="pf-l" data-ouvre="paie"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_niss ?? 'N° national' }}</span>{% if pa.niss ?? '' %}<span class="pf-v">{{ pa.niss|slice(0, 9) }}•••.••</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
  <button type="button" class="pf-l" data-ouvre="paie"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_iban ?? 'IBAN' }}</span>{% if pa.iban ?? '' %}<span class="pf-v">{{ pa.iban|slice(0, 4) }} •••• {{ pa.iban|replace({' ': ''})|slice(-4) }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
  <button type="button" class="pf-l" data-ouvre="paie"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_id_card ?? 'Carte d’identité' }}</span>{% if (profil.carte.recto ?? null) and (profil.carte.verso ?? null) %}<span class="pf-v">{{ T.pf_id_both ?? 'Recto et verso' }} ✓</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
</div>
<p class="pf-note"><i class="bi bi-shield-lock"></i>{{ T.pf_pay_note ?? 'Visible par toi, ton franchisé et la marque seulement. Gardé chiffré.' }}</p>

{# ── Tenue ── #}
<div class="pf-sec">{{ T.pf_outfit ?? 'Tenue' }}</div>
<div class="pf-g">
  <button type="button" class="pf-l" data-ouvre="tenue"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_tshirt ?? 'T-shirt' }}</span>{% if te.tshirt ?? '' %}<span class="pf-v">{{ te.tshirt }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
  <button type="button" class="pf-l" data-ouvre="tenue"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_jacket ?? 'Veste' }}</span>{% if te.veste ?? '' %}<span class="pf-v">{{ te.veste }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
  <button type="button" class="pf-l" data-ouvre="tenue"{{ ok ? '' : ' disabled' }}><span class="pf-k">{{ T.pf_shoes ?? 'Chaussures' }}</span>{% if te.chaussures ?? '' %}<span class="pf-v">{{ te.chaussures }}</span>{% else %}{{ f.vide(T) }}{% endif %}</button>
</div>
<div class="pf-esp"></div>

{# ── Disponibilités ── #}
<div class="pf-sec">{{ T.pf_availability ?? 'Disponibilités' }} <small>{{ T.pf_editable ?? 'modifiable' }}</small></div>
<div class="pf-g">
  <button type="button" class="pf-dispo" data-ouvre="dispo"{{ ok ? '' : ' disabled' }}>
    <div class="j">{% for j in jours %}<b>{{ j }}</b>{% endfor %}</div>
    <div class="j" style="margin-top:6px">{% for c in cles %}<i class="{{ (di.grille[c].m ?? false) ? 'on' }}">{{ T.pf_morning ?? 'matin' }}</i>{% endfor %}</div>
