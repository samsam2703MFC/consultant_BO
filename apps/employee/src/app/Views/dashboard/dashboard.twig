{# dashboard/dashboard.twig — l'Accueil, centré sur la performance de la personne (06/10/2026) ; ce qui est encore en jeu et le plan en tête, en forme sobre (23/10/2026). #}
{% extends "layouts/mobile_base.twig" %}
{% set active_nav = 'dashboard' %}
{% set T = translations %}
{% macro duree(m) %}{% if m < 60 %}{{ m }} min{% else %}{{ m // 60 }} h{% if m % 60 %} {{ '%02d'|format(m % 60) }}{% endif %}{% endif %}{% endmacro %}
{% import _self as fp %}
{% block title %}{{ T.home ?? 'Accueil' }}{% endblock %}
{% block head %}<link rel="stylesheet" href="{{ asset('assets/atelier/primes.css') }}">
<style>
  /* Le pointage (01/11/2026, maquette docs/maquettes/pointage-app, écrans A et D). */
  .pt-carte{background:var(--s-carte);border-radius:18px;padding:16px 18px 18px;margin-bottom:12px}
  .pt-sur{display:flex;align-items:center;gap:7px;font:400 15px var(--s-police);color:var(--s-second)}
  .pt-sur i.on{width:8px;height:8px;border-radius:50%;background:var(--s-vert);box-shadow:0 0 0 4px var(--s-vert-doux)}
  .pt-h{margin:4px 0 2px;font:600 40px/1.1 var(--s-police);letter-spacing:-.02em;font-variant-numeric:tabular-nums}
  .pt-sous{font:400 15px var(--s-police);color:var(--s-second)}
  .pt-sous b{color:var(--s-texte);font-weight:600}
  .pt-barre{height:8px;border-radius:4px;background:var(--s-remplir);margin:12px 0 8px;overflow:hidden}
  .pt-barre i{display:block;height:100%;background:var(--s-vert);border-radius:4px}
  .pt-bouton{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;margin-top:16px;padding:15px 0;border-radius:14px;background:var(--s-accent);color:#fff;font:600 17px var(--s-police);text-decoration:none}
  .pt-bouton i{font-size:21px}
  .pt-bouton:hover{color:#fff}
  .pt-bouton.contour{background:none;color:var(--s-accent);box-shadow:inset 0 0 0 1.5px var(--s-accent)}
  .pt-aide{display:flex;gap:8px;margin-top:10px;font:400 12.5px/1.4 var(--s-police);color:var(--s-second)}
  .pt-pointe{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:12px;padding-top:12px;border-top:.5px solid var(--s-trait);font:400 14px var(--s-police);color:var(--s-second)}
  .pt-pointe b{color:var(--s-texte);font-weight:600;font-variant-numeric:tabular-nums}
  .pt-pointe .v{color:var(--s-vert);font-weight:500}.pt-pointe .o{color:#B25E09;font-weight:500}
  .pt-mini{display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--s-carte);border-radius:16px;padding:13px 16px;margin-bottom:12px;color:inherit;text-decoration:none;font:400 15px var(--s-police)}
  .pt-mini b{font-weight:600}.pt-mini span{color:var(--s-accent);white-space:nowrap}
</style>{% endblock %}
{% block page_title %}{{ T.hello ?? 'Bonjour' }}{% if prenom %} {{ prenom }}{% endif %}{% endblock %}
{% block page_subtitle %}{% if primes %}{{ primes.magasin.nom|replace({'Atelier by - ': ''}) }} · {% endif %}{{ dateLib }}{% endblock %}

{% block content %}
{% set p = primes %}
{% set eur = '€' %}

{# ── 0. Le pointage : le service du jour et le bouton (01/11/2026) ── #}
{% set PT = pointage %}
{% if PT %}
  {% if PT.ouvert %}{% set o = PT.ouvert %}
<div class="pt-carte" data-pointage="en_service">
  <div class="pt-sur"><i class="on"></i>{{ T.pt_on_shift ?? 'En service' }}</div>
  <div class="pt-h">{% if PT.prevu %}{{ PT.prevu.debut }} – {{ PT.prevu.fin }}{% else %}{{ (T.pt_since ?? 'depuis {h}')|replace({'{h}': o.entree}) }}{% endif %}</div>
  {% if PT.prevu %}<div class="pt-barre"><i style="width:{{ PT.avance }}%"></i></div>
  <div class="pt-sous"><b>{{ (T.pt_left ?? 'encore {d}')|replace({'{d}': fp.duree(PT.reste)}) }}</b> · {{ (T.pt_until ?? 'jusqu’à {h}')|replace({'{h}': PT.prevu.fin}) }}</div>{% endif %}
  <div class="pt-pointe"><i class="bi bi-box-arrow-in-right"></i>{{ T.pt_clocked_in_at ?? 'Arrivée pointée à' }} <b>{{ o.entree }}</b>{% if o.arrivee == 'retard' %} <span class="o">+{{ o.retard_min }} min</span>{% elseif o.arrivee == 'a_l_heure' %} <span class="v">{{ T.pt_on_time ?? 'à l’heure' }}</span>{% endif %}</div>
  <a class="pt-bouton contour" href="{{ ROOT }}/pointage"><i class="bi bi-qr-code-scan"></i>{{ T.pt_clock_out ?? 'Pointer le départ' }}</a>
  <div class="pt-aide"><i class="bi bi-info-circle"></i><span>{{ T.pt_help_out ?? 'Le même QR code, en partant. Un départ oublié se dit dans Profil › Mes pointages.' }}</span></div>
</div>
  {% elseif PT.prevu and (not PT.fait or PT.dans > 0) %}
<div class="pt-carte" data-pointage="a_pointer">
  <div class="pt-sur">{{ T.pt_shift_today ?? 'Ton service aujourd’hui' }}</div>
  <div class="pt-h">{{ PT.prevu.debut }} – {{ PT.prevu.fin }}</div>
  <div class="pt-sous">{% if PT.dans > 0 %}<b>{{ (T.pt_starts_in ?? 'commence dans {d}')|replace({'{d}': fp.duree(PT.dans)}) }}</b>{% else %}{{ (T.pt_started_at ?? 'a commencé à {h}')|replace({'{h}': PT.prevu.debut}) }}{% endif %}{% if PT.prevu.shop_name %} · {{ PT.prevu.shop_name }}{% endif %}</div>
  <a class="pt-bouton" href="{{ ROOT }}/pointage"><i class="bi bi-qr-code-scan"></i>{{ T.pt_clock_in ?? 'Pointer l’arrivée' }}</a>
  <div class="pt-aide"><i class="bi bi-info-circle"></i><span>{{ T.pt_help_in ?? 'La caméra s’ouvre : vise le QR code de la borne du magasin.' }}</span></div>
</div>
  {% elseif PT.fait %}
<a class="pt-mini" href="{{ ROOT }}/me/pointages" data-pointage="fait"><div><b>{{ T.pt_day_done ?? 'Journée pointée' }}</b> · {{ PT.fait.entree }} – {{ PT.fait.sortie }}</div><span>{{ T.pt_my_clockings ?? 'Mes pointages' }} ›</span></a>
  {% else %}
<a class="pt-mini" href="{{ ROOT }}/pointage" data-pointage="sans_service"><div>{{ T.pt_no_shift_today ?? 'Pas de service prévu aujourd’hui' }}</div><span>{{ T.pt_clock_anyway ?? 'Pointer quand même' }} ›</span></a>
  {% endif %}
{% endif %}

{# ── 1. Mes primes : ce qui est encore en jeu, en tête (23/10/2026, forme sobre) ── #}
{% if p %}
{% set encore = max(0, (p.enJeu ?? p.aPortee ?? 0) - p.acquis) %}
{% set enJeu = p.enJeu ?? p.aPortee ?? 0 %}
<a class="sb-groupe sb-heros-carte" href="{{ ROOT }}/primes">
  {% if p.enCours and encore > 0 %}
  <span class="sb-sur">{{ T.still_in_play ?? 'Encore en jeu ce mois-ci' }}</span>
  <span class="sb-chiffre">+{{ encore|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</span>
  <span class="sb-barre grande"><i style="width:{{ enJeu > 0 ? (100 * p.acquis / enJeu)|round(1) : 0 }}%"></i></span>
  <span class="sb-sous"><b>{{ p.acquis|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</b> {{ T.earned ?? 'acquis' }} · {{ enJeu|number_format(0, ',', ' ') }}&nbsp;{{ eur }} {{ T.in_play ?? 'en jeu' }}</span>
  {% else %}
  <span class="sb-sur">{{ T.my_bonuses ?? 'Mes primes' }} · {{ mois(p.m) }}</span>
  <span class="sb-chiffre">{{ p.acquis|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</span>
  <span class="sb-sous">{{ p.enCours ? (T.earned_so_far ?? 'acquis si le mois finit comme ça') : (T.month_closed ?? 'mois clos') }}</span>
  {% endif %}
  <i class="bi bi-chevron-right sb-fleche"></i>
</a>
{% else %}
<div class="pr-card"><div class="pr-h"><h2>{{ T.my_bonuses ?? 'Mes primes' }}</h2></div>
  <div class="note">{{ T.unavailable ?? 'Les primes ne peuvent pas être lues pour le moment.' }}{% if primesErreur %}<br><span class="mu" style="font-size:11px">{{ primesErreur }}</span>{% endif %}</div></div>
{% endif %}

{# ── Le bilan du service, quand il se termine ── #}
{% if bilan %}
<div class="pr-card acc-bilan {{ bilan.ok ? 'ok' : 'att' }}" data-bilan="{{ bilan.ok ? 'ok' : 'att' }}">
  <i class="bi {{ bilan.ok ? 'bi-emoji-smile' : 'bi-lightning-charge' }}"></i>
  <div><b>{{ bilan.fini ? (T.shift_over ?? 'Service terminé') : (T.shift_ending ?? 'Fin de service dans moins d’une heure') }}</b>
    <div class="s">{% if bilan.ok %}{{ T.well_done ?? 'Bravo :' }} {{ bilan.taux }}&nbsp;% {{ T.today_vs_target ?? 'de ventes croisées aujourd’hui, la cible est à' }} {{ bilan.cible|number_format(0, ',', ' ') }}&nbsp;%.{% else %}{{ T.still_needed ?? 'Encore' }} <b>{{ bilan.manque }}</b> {{ bilan.manque == 1 ? (T.cross_sale_for_target_one ?? 'vente croisée pour la cible du jour') : (T.cross_sales_for_target ?? 'ventes croisées pour la cible du jour') }} ({{ bilan.taux }}&nbsp;% {{ T.vs ?? 'face à' }} {{ bilan.cible|number_format(0, ',', ' ') }}&nbsp;%).{% endif %}</div></div>
</div>
{% endif %}

{# ── 2. Aujourd'hui : le compteur, le service, les tâches ── #}
<div class="pr-card">
  <div class="pr-h"><h2>{{ T.today ?? 'Aujourd’hui' }}</h2><small>{{ heure }}</small></div>
  {% if p and p.enCours and p.aujourdhui %}{% set a = p.aujourdhui %}{% set c = p.briques.croisees %}
  <div class="auj"><div class="cercle" style="--p:{{ a.tickets > 0 ? (100 * a.croisees / a.tickets)|round : 0 }}%"><b>{{ a.croisees }}</b><small>{{ T.out_of ?? 'sur' }} {{ a.tickets }}</small></div>
    <div class="tx"><div class="q">{{ a.croisees }} {{ T.cross_sales_today ?? 'ventes croisées aujourd’hui' }}</div>
      {% if a.tickets > 0 %}{{ a.taux|number_format(0, ',', ' ') }}&nbsp;% {{ T.of_your_tickets ?? 'de tes tickets ont 2 articles ou plus' }} · {{ T.target ?? 'cible' }} {{ c.cible|number_format(0, ',', ' ') }}&nbsp;%{% else %}{{ T.no_ticket_yet ?? 'Pas encore de ticket à ton nom.' }}{% endif %}
      <div class="mu" style="font-size:11.5px;margin-top:3px">« {{ T.anything_else ?? 'Et avec ça ?' }} »</div></div></div>
  {% elseif p and p.enCours %}<div class="note" style="margin-top:0">{{ T.today_unavailable ?? 'Le compteur du jour n’a pas pu être lu.' }}</div>{% endif %}
  <div class="acc-grille">
    <a class="acc-tuile" href="{{ ROOT }}/schedule"><i class="bi bi-calendar3"></i><div><b>{% if service %}{{ service.debut }} – {{ service.fin }}{% else %}{{ T.no_shift ?? 'Pas de service' }}{% endif %}</b><small>{{ T.my_shift ?? 'mon service du jour' }}</small></div></a>
    <a class="acc-tuile {{ taches and taches.restantes > 0 ? 'att' }}" href="{{ ROOT }}/tasks"><i class="bi bi-check2-square"></i><div><b>{% if taches %}{{ taches.restantes }} / {{ taches.total }}{% else %}—{% endif %}</b><small>{{ T.tasks_left ?? 'tâches à faire' }}</small></div></a>
  </div>
</div>

{# ── 3. Comment y arriver : les trois primes les plus proches, comme sur l'écran Primes (23/10/2026) ── #}
{% if p and p.enCours and etapes|length %}
<h2 class="sb-titre">{{ T.how_to_get_there ?? 'Comment y arriver' }}<a href="{{ ROOT }}/primes">{{ T.see_all ?? 'tout voir' }}</a></h2>
<div class="sb-groupe">
  {% for e in etapes %}{% include "components/primes_etape.twig" with { e: e, T: T, ib: p.iconesBase ?? (ROOT ~ '/..'), lien: ROOT ~ '/primes#prime-' ~ e.cle } only %}{% endfor %}
</div>
{% endif %}

{# ── 4. Ma semaine ── #}
{% if semaine and (semaine.tickets > 0 or semaine.caHeure is not null) %}
<div class="pr-card">
  <div class="pr-h"><h2>{{ T.my_week ?? 'Ma semaine' }}</h2><small>{{ semaine.lib }}</small></div>
  <div class="acc-kpis">
    <div><b>{% if semaine.rang %}{{ semaine.rang }}<span class="mu" style="font-size:12px">e</span>{% else %}—{% endif %}</b><small>{{ T.rank_network ?? 'dans le réseau' }}{% if semaine.sur %} · {{ semaine.sur }}{% endif %}</small></div>
    <div><b>{% if semaine.taux is not null %}{{ semaine.taux|number_format(0, ',', ' ') }}&nbsp;%{% else %}—{% endif %}</b><small>{{ T.cross_sales ?? 'ventes croisées' }}</small></div>
    <div><b>{% if semaine.caHeure is not null %}{{ semaine.caHeure|number_format(0, ',', ' ') }}&nbsp;{{ eur }}{% else %}—{% endif %}</b><small>{{ T.per_hour ?? 'par heure' }}</small></div>
    <div><b>{% if semaine.pieces is not null %}{{ semaine.pieces|number_format(0, ',', ' ') }}{% if semaine.rangPieces %} <span class="mu" style="font-size:12px">{{ semaine.rangPieces }}e</span>{% endif %}{% else %}—{% endif %}</b><small>{{ T.contest_pieces ?? 'tartes & quiches' }}</small></div>
  </div>
</div>
{% endif %}

{# ── 5. Ma collection, en une ligne ── #}
{% if collection %}
<a class="pr-card acc-lien acc-mag" href="{{ ROOT }}/primes#collection">
  <div><div class="k">{{ T.my_collection ?? 'Ma collection' }}</div>
    <div class="s"><b>{{ collection.n }} {{ T.titles_won ?? 'titres gagnés' }}</b>{% if collection.enCours %} · {{ collection.enCours }} {{ T.live ?? 'en cours' }}{% endif %}{% if collection.derniers|length %}{% set dt = collection.derniers[0] %} · {{ T.last ?? 'dernier' }} : {{ (dt.cle starts with 'concours:' or dt.cle starts with 'promo:' or dt.cle starts with 'cible:') ? dt.lib : (dt.cle == 'croisees' ? (T.cross_sales_title ?? 'Ventes croisées') : (dt.cle == 'record' ? (T.record_beaten ?? 'Record battu') : (dt.cle == 'meilleure' ? (T.best_seller ?? 'Meilleure vendeuse') : (dt.cle == 'google' ? (T.google_rating ?? 'Note Google') : (T.shop_bonus_title ?? 'Prime magasin'))))) }}{% endif %}</div></div>
  <i class="bi bi-chevron-right mu"></i>
</a>
{% endif %}
{% endblock %}
