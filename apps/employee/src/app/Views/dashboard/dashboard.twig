{# dashboard/dashboard.twig — l'Accueil, centré sur la performance de la personne (06/10/2026). #}
{% extends "layouts/mobile_base.twig" %}
{% set active_nav = 'dashboard' %}
{% set T = translations %}
{% block title %}{{ T.home ?? 'Accueil' }}{% endblock %}
{% block head %}<link rel="stylesheet" href="{{ ROOT }}/assets/atelier/primes.css">{% endblock %}
{% block page_title %}{{ T.hello ?? 'Bonjour' }}{% if prenom %} {{ prenom }}{% endif %}{% endblock %}
{% block page_subtitle %}{% if primes %}{{ primes.magasin.nom|replace({'Atelier by - ': ''}) }} · {% endif %}{{ dateLib }}{% endblock %}

{% block content %}
{% set p = primes %}
{% set eur = '€' %}

{# ── 1. Mes primes : l'anneau, en tête ── #}
{% if p %}
{% set part = p.aPortee > 0 ? min(1, p.acquis / p.aPortee) : 0 %}
<a class="pr-card rubis anneau-carte acc-lien" href="{{ ROOT }}/primes">
  <div class="anneau"><svg viewBox="0 0 120 120"><circle class="fond" cx="60" cy="60" r="52"/><circle class="val" cx="60" cy="60" r="52" style="stroke-dasharray:{{ (part * 326.7)|round(1) }} 326.7"/></svg>
    <div class="centre"><b>{{ p.acquis|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</b><small>{{ T.earned ?? 'acquis' }}</small></div></div>
  <div class="tx">
    <div class="k">{{ T.my_bonuses ?? 'Mes primes' }} · {{ p.lib }}</div>
    {% if p.enCours %}<div class="gros2">{{ T.up_to ?? 'jusqu’à' }} {{ p.aPortee|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</div>
    <div class="s">{{ T.earned_so_far ?? 'acquis si le mois finit comme ça' }} · {{ T.within_reach ?? 'à portée, un cran de plus' }}</div>
    {% else %}<div class="gros2">{{ p.acquis|number_format(0, ',', ' ') }}&nbsp;{{ eur }}</div><div class="s">{{ T.month_closed ?? 'mois clos' }}</div>{% endif %}
    {% set gg = p.google ?? null %}{% if gg and gg.actif and gg.note is not null and gg.coef != 1 %}<span class="puce google"><i class="bi bi-star-fill"></i> Google {{ gg.note|number_format(1, ',', ' ') }} → × {{ gg.coef|number_format(2, ',', ' ') }}</span>{% endif %}
    <div class="acc-voir">{{ T.see_details ?? 'Voir le détail' }} <i class="bi bi-arrow-right"></i></div>
  </div>
</a>
{% else %}
<div class="pr-card"><div class="pr-h"><h2>{{ T.my_bonuses ?? 'Mes primes' }}</h2></div>
  <div class="note">{{ T.unavailable ?? 'Les primes ne peuvent pas être lues pour le moment.' }}{% if primesErreur %}<br><span class="mu" style="font-size:11px">{{ primesErreur }}</span>{% endif %}</div></div>
{% endif %}

{# ── 2. Aujourd'hui : le compteur, le service, les tâches ── #}
<div class="pr-card">
  <div class="pr-h"><h2>{{ T.today ?? 'Aujourd’hui' }}</h2><small>{{ heure }}</small></div>
  {% if p and p.enCours and p.aujourdhui %}{% set a = p.aujourdhui %}{% set c = p.briques.croisees %}
  <div class="auj"><div class="cercle" style="--p:{{ a.tickets > 0 ? (100 * a.croisees / a.tickets)|round : 0 }}%"><b>{{ a.croisees }}</b><small>{{ T.out_of ?? 'sur' }} {{ a.tickets }}</small></div>
    <div class="tx"><div class="q">{{ a.croisees }} {{ T.cross_sales_today ?? 'ventes croisées aujourd’hui' }}</div>
      {% if a.tickets > 0 %}{{ a.taux|number_format(0, ',', ' ') }}&nbsp;% {{ T.of_your_tickets ?? 'de vos tickets ont 2 articles ou plus' }} · {{ T.target ?? 'cible' }} {{ c.cible|number_format(0, ',', ' ') }}&nbsp;%{% else %}{{ T.no_ticket_yet ?? 'Pas encore de ticket à votre nom.' }}{% endif %}
      <div class="mu" style="font-size:11.5px;margin-top:3px">« {{ T.anything_else ?? 'Et avec ça ?' }} »</div></div></div>
  {% elseif p and p.enCours %}<div class="note" style="margin-top:0">{{ T.today_unavailable ?? 'Le compteur du jour n’a pas pu être lu.' }}</div>{% endif %}
  <div class="acc-grille">
    <a class="acc-tuile" href="{{ ROOT }}/schedule"><i class="bi bi-calendar3"></i><div><b>{% if service %}{{ service.debut }} – {{ service.fin }}{% else %}{{ T.no_shift ?? 'Pas de service' }}{% endif %}</b><small>{{ T.my_shift ?? 'mon service du jour' }}</small></div></a>
    <a class="acc-tuile {{ taches and taches.restantes > 0 ? 'att' }}" href="{{ ROOT }}/tasks"><i class="bi bi-check2-square"></i><div><b>{% if taches %}{{ taches.restantes }} / {{ taches.total }}{% else %}—{% endif %}</b><small>{{ T.tasks_left ?? 'tâches à faire' }}</small></div></a>
  </div>
</div>

{# ── 3. Les prochaines étapes qui rapportent ── #}
{% if p and p.enCours and etapes|length %}
<div class="pr-card">
  <div class="pr-h"><h2>{{ T.next_steps ?? 'Mes prochaines étapes' }}</h2><small>{{ T.closest_first ?? 'la plus proche d’abord' }}</small></div>
  {% for e in etapes %}
  <a class="ligne acc-etape" href="{{ ROOT }}/primes"><div><b>{{ e.lib }}</b><div class="d">{{ e.detail }}</div></div><span class="puce rubis">+ {{ e.gain }}&nbsp;{{ eur }}</span></a>
  {% endfor %}
</div>
{% endif %}

{# ── 4. Ma semaine ── #}
{% if semaine and (semaine.tickets > 0 or semaine.caHeure is not null) %}
<div class="pr-card">
  <div class="pr-h"><h2>{{ T.my_week ?? 'Ma semaine' }}</h2><small>{{ semaine.lib }}</small></div>
  <div class="acc-kpis">
    <div><b>{% if semaine.rang %}{{ semaine.rang }}<span class="mu" style="font-size:12px">e</span>{% else %}—{% endif %}</b><small>{{ T.rank_network ?? 'dans le réseau' }}{% if semaine.sur %} · {{ semaine.sur }}{% endif %}</small></div>
    <div><b>{% if semaine.taux is not null %}{{ semaine.taux|number_format(0, ',', ' ') }}&nbsp;%{% else %}—{% endif %}</b><small>{{ T.cross_sales ?? 'ventes croisées' }}</small></div>
    <div><b>{% if semaine.caHeure is not null %}{{ semaine.caHeure|number_format(0, ',', ' ') }}&nbsp;{{ eur }}{% else %}—{% endif %}</b><small>{{ T.per_hour ?? 'par heure' }}</small></div>
    <div><b>{% if semaine.pieces is not null %}{{ semaine.pieces|number_format(0, ',', ' ') }}{% if semaine.rangPieces %} <span class="mu" style="font-size:12px">{{ semaine.rangPieces }}e</span>{% endif %}{% else %}—{% endif %}</b><small>{{ T.contest_pieces ?? 'tartes & quiches' }}</small></div>
  </div>
</div>
{% endif %}

{# ── 5. Mon magasin, en une ligne ── #}
{% if p and p.prime %}{% set g = p.prime %}
<a class="pr-card doux acc-lien acc-mag" href="{{ ROOT }}/primes?onglet=magasin">
  <div><div class="k">{{ T.my_shop ?? 'Mon magasin' }}</div>
    <div class="s">{% set att = g.atteinteProj ?? g.atteinte %}{% if att is not null %}<b>{{ att|number_format(1, ',', ' ') }}&nbsp;%</b> {{ g.atteinteProj is not null ? (T.at_current_pace ?? 'de l’objectif au rythme actuel') : (T.reached ?? 'de l’objectif') }}{% if g.palier %} · {{ T.level ?? 'palier' }} {{ g.palier.pct }}&nbsp;%{% elseif g.paliers|length and g.paliers[0].manque %} · {{ g.paliers[0].manque|number_format(0, ',', ' ') }}&nbsp;{{ eur }} {{ T.to_first_level ?? 'avant le premier palier' }}{% endif %}{% else %}{{ T.no_objective ?? 'pas d’objectif ce mois-ci' }}{% endif %}</div></div>
  <i class="bi bi-chevron-right mu"></i>
</a>
{% endif %}
{% endblock %}
