{% extends "layouts/mobile_base.twig" %}

{% set active_nav = 'dashboard' %}

{% block title %}{{ translations.home ?? 'Home' }}{% endblock %}
{% block page_title %}{{ translations.home ?? 'Home' }}{% endblock %}
{% block page_subtitle %}{{ translations.welcome_back ?? 'Welcome back' }}{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-body">
            <h5 class="mb-1">{{ translations.today ?? 'Today' }}</h5>
            <div class="text-muted small">{{ translations.quick_overview_of_your_day ?? 'Quick overview of your day' }}</div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-bold">{{ translations.tasks ?? 'Tasks' }}</div>
                    <div class="text-muted small">{{ translations.pending_tasks_count ?? 'pending' }}</div>
                </div>
                <a href="{{ ROOT }}/tasks" class="btn btn-sm btn-outline-primary">{{ translations.open ?? 'Open' }}</a>
            </div>
        </div>
    </div>
{% endblock %}
